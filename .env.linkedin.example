# Copie ce fichier en .env.linkedin (ignoré par git) et remplis-le.
# Valeurs dans https://www.linkedin.com/developers/apps → ton app → onglet « Auth ».

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Doit être déclarée à l'identique dans « Authorized redirect URLs for your app ».
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback

# Version de l'API (YYYYMM). LinkedIn en maintient ~12 mois glissants :
# si l'API répond « invalid version », remplace par un mois plus récent.
LINKEDIN_API_VERSION=202605
