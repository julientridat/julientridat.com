---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"realisations">;
}
const { entry } = Astro.props;
const d = entry.data;
const chiffres = d.resultats.slice(0, 2);
---

<a
  href={`/realisations/${entry.id}`}
  class="group flex flex-col rounded-2xl border border-line bg-card p-7 transition-all hover:-translate-y-0.5 hover:border-lime/60 hover:shadow-[0_16px_36px_-18px_rgba(24,20,60,0.18)]"
>
  <div class="text-[11px] uppercase tracking-[0.18em] text-ink-3">{d.secteur}</div>
  <h3 class="mt-4 text-[19px] font-medium leading-snug tracking-[-0.01em] text-foreground">{d.title}</h3>
  {d.transformation && (
    <p class="mt-3 line-clamp-3 text-[14px] leading-relaxed text-ink-2">{d.transformation}</p>
  )}

  {chiffres.length > 0 && (
    <div class="mt-auto flex flex-wrap gap-x-8 gap-y-3 border-t border-line pt-6">
      {chiffres.map((res) => (
        <div>
          <div class="font-serif text-2xl italic text-foreground">{res.chiffre}</div>
          <div class="mt-0.5 max-w-[11rem] text-[10.5px] uppercase tracking-wider text-ink-3">
            {res.label}
          </div>
        </div>
      ))}
    </div>
  )}

  <div class="mt-6 inline-flex items-center gap-2 text-[13px] text-lime">
    Lire la transformation
    <span class="transition-transform group-hover:translate-x-0.5">→</span>
  </div>
</a>
