---
import Logo from "@/components/Logo.astro";

interface Props {
  /** Sur la home, les ancres restent locales ; ailleurs, elles pointent vers /#…. */
  home?: boolean;
  /** Nav posée sur un fond sombre (hero photo/vidéo) : texte clair, bouton clair. */
  onDark?: boolean;
}
const { home = false, onDark = false } = Astro.props;
const p = home ? "" : "/";

// Trois offres, trois entrées. « Comment ça marche » sort : c'était la plus
// longue étiquette de la barre, et une simple ancre de la page d'accueil —
// alors que /integration-ia est une page à part entière qui doit être atteignable
// de partout. La barre garde cinq liens, donc la largeur tenue à 768 px.
const links = [
  { href: `${p}#offres`, label: "L'offre" },
  { href: "/integration-ia", label: "Intégration IA" },
  { href: "/formation-ia", label: "Formation" },
  { href: "/realisations", label: "Cas clients" },
  { href: `${p}#about`, label: "À propos" },
];
---

<nav class="absolute inset-x-0 top-0 z-50 flex items-center justify-between px-6 py-6 md:px-12 md:py-8">
  <Logo href={home ? undefined : "/"} onDark={onDark} />
  <ul
    class={`hidden items-center gap-4 text-[13px] md:flex lg:gap-9 lg:text-[15px] ${onDark ? "text-white" : "text-foreground"}`}
  >
    {links.map((l) => (
      <li>
        <a href={l.href} class="inline-flex items-center gap-1 transition-opacity hover:opacity-75">
          {l.label}
        </a>
      </li>
    ))}
  </ul>
  <button
    type="button"
    data-open-contact
    class={
      onDark
        ? "cursor-pointer rounded-full bg-white px-5 py-2.5 text-[15px] font-medium text-black transition-colors hover:bg-white/90"
        : "cursor-pointer rounded-full bg-foreground px-5 py-2.5 text-[15px] font-medium text-card transition-colors hover:bg-lime"
    }
  >
    Contact
  </button>
</nav>
