---
interface Assistant {
  nom: string;
  entree: string;
  sortie: string;
  fait?: string;
}
interface Props {
  assistants: Assistant[];
}
const { assistants } = Astro.props;
---

<div class="space-y-4">
  {assistants.map((a) => (
    <div class="rounded-2xl border border-line bg-card p-6">
      <div class="grid items-stretch gap-3 md:grid-cols-[1fr_auto_1.4fr_auto_1fr]">
        <!-- entrée -->
        <div class="flex flex-col justify-center rounded-xl border border-dashed border-line px-4 py-3 text-center">
          <div class="text-[10px] uppercase tracking-[0.18em] text-ink-3">Vous lui donnez</div>
          <div class="mt-1 text-[13px] leading-snug text-ink-2">{a.entree}</div>
        </div>
        <div class="hidden items-center justify-center text-lime md:flex" aria-hidden="true">→</div>
        <!-- l'assistant -->
        <div class="flex flex-col justify-center rounded-xl border border-lime/40 bg-lime/[0.07] px-4 py-4 text-center">
          <div class="text-[10px] uppercase tracking-[0.18em] text-lime">L'assistant</div>
          <div class="mt-1 text-[15px] font-medium leading-snug text-foreground">{a.nom}</div>
        </div>
        <div class="hidden items-center justify-center text-lime md:flex" aria-hidden="true">→</div>
        <!-- sortie -->
        <div class="flex flex-col justify-center rounded-xl border border-line bg-background px-4 py-3 text-center">
          <div class="text-[10px] uppercase tracking-[0.18em] text-ink-3">Il vous rend</div>
          <div class="mt-1 text-[13px] leading-snug text-foreground">{a.sortie}</div>
        </div>
      </div>
      {a.fait && <p class="mt-4 border-t border-line pt-3 text-[13px] leading-relaxed text-ink-2">{a.fait}</p>}
    </div>
  ))}
</div>
