---
import Logo from "@/components/Logo.astro";

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const p = home ? "" : "/";
const year = new Date().getFullYear();
---

<footer class="border-t border-line px-6 py-12 md:px-12">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <Logo href={home ? undefined : "/"} />
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-2">
      <a href={`${p}#methode`} class="hover:text-foreground">Méthode</a>
      <a href={`${p}#offres`} class="hover:text-foreground">Offres</a>
      <a href="/realisations" class="hover:text-foreground">Cas clients</a>
      <a href="/experience" class="text-lime/70 hover:text-lime">L'expérience ✦</a>
      <a href="/notes" class="hover:text-foreground">Notes</a>
      <a href={`${p}#about`} class="hover:text-foreground">À propos</a>
      <a href="#" data-open-contact class="hover:text-foreground">Contact</a>
    </div>
    <div class="text-xs text-ink-3">© {year} Julien Tridat — Bordeaux</div>
  </div>
</footer>
