---
/**
 * FAQ — toutes les questions fermées, comme chez Designjoy : la liste des
 * questions se lit d'un coup d'œil, et chacun ouvre celle qui le concerne.
 *
 * <details>/<summary> natifs : pas de JS, le contenu reste indexable et
 * accessible au clavier. Les questions viennent de src/lib/faqAccueil.ts,
 * partagé avec le balisage FAQPage de index.astro.
 */
import Eyebrow from "@/components/Eyebrow.astro";
import { FAQ_ACCUEIL as questions } from "@/lib/faqAccueil";
---

<section id="faq" class="border-t border-line px-6 py-12 md:px-12 md:py-16">
  <div class="mx-auto max-w-7xl">
    <Eyebrow>Questions</Eyebrow>

    <div class="grid gap-8 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.4fr)] md:gap-16">
      <h2
        class="text-[clamp(2rem,4.5vw,3.5rem)] font-normal leading-[1.05] tracking-[-0.03em] text-foreground md:sticky md:top-24 md:self-start"
      >
        Ce que vous alliez <em class="text-lime">me demander.</em>
      </h2>

      <div>
        {questions.map((item, i) => (
          <details class={`border-t border-line ${i === questions.length - 1 ? "border-b" : ""}`}>
            <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 py-5 text-lg font-medium text-foreground transition-colors hover:text-lime md:text-xl">
              <span>{item.q}</span>
              <span class="faq-marqueur shrink-0 font-serif text-2xl leading-none text-lime" aria-hidden="true"></span>
            </summary>
            <p class="pb-5 text-lg leading-relaxed text-ink-2">{item.r}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ""; }
  .faq-marqueur::after { content: "+"; }
  details[open] .faq-marqueur::after { content: "–"; }
</style>
