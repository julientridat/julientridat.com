---
/**
 * FAQ — objections nommées telles que le prospect les formule.
 *
 * Accordéon en <details>/<summary> natifs : pas de JS, l'ouverture fonctionne
 * même si l'hydratation échoue, et le contenu reste indexable et accessible au
 * clavier. Les questions sont posées frontalement (prix, exclusivité, taille
 * d'équipe) parce qu'une objection tue si on l'esquive.
 *
 * Filet 1px entre chaque item plutôt que des cartes : la section suit la
 * précédente, qui est déjà une surface bg-card — un empilement de cartes ferait
 * bloc.
 */
import Eyebrow from "@/components/Eyebrow.astro";

const questions = [
  {
    q: "Pourquoi 4 000 € le premier mois ?",
    r: "Parce qu'un mois entier y passe. Positionnement, identité, gabarits, assistants installés dans vos outils, équipes formées : c'est le socle sans lequel la suite ne tient pas — on produirait vite des choses qui ne se ressemblent pas. Vous en gardez l'intégralité, même si vous vous arrêtez à l'issue du premier mois.",
  },
  {
    q: "Pourquoi une seule demande à la fois ?",
    r: "C'est ce qui rend le 48-72 h possible. Une file illimitée, c'est la promesse de ceux qui livrent en trois semaines. Ici vous fixez l'ordre : une demande avance, elle est livrée, la suivante démarre. Vous savez toujours où en est la vôtre.",
  },
  {
    q: "Une seule personne pour tout ça, c'est tenable ?",
    r: "C'est l'inverse. Une agence répartit le sujet entre plusieurs personnes qui ne se parlent pas toujours. Ici, la même personne qui pense la stratégie avec vous fabrique aussi l'outil et forme vos équipes à s'en servir — rien ne se perd dans la coordination.",
  },
  {
    q: "L'intelligence artificielle va remplacer mes équipes ?",
    r: "Non. Elle est installée dans leurs outils de travail, sur vos comptes, et ils sont formés à s'en servir. Elle enlève ce qui les ralentit — la ressaisie, la mise en forme, la recherche d'un fichier — pas les gens.",
  },
  {
    q: "Et si j'arrête ?",
    r: "Vous partez avec tout : fichiers sources, accès, documentation. Les outils restent installés chez vous, sur vos comptes. Rien n'est retenu. Vous perdez une seule chose : votre place parmi les quatre.",
  },
  {
    q: "Nous sommes 45. On fait comment ?",
    r: "Sur devis. Le format est calibré jusqu'à trente salariés. Au-delà, le nombre de services et d'interlocuteurs change le périmètre — le forfait ne tiendrait pas, et je préfère le dire avant.",
  },
  {
    q: "Nous ne sommes pas une entreprise digitale. C'est un problème ?",
    r: "C'est le cœur de cible. Je ne travaille pas pour des startups. Je travaille pour des entreprises qui produisent, vendent, livrent — et qui n'ont jamais eu personne en interne pour structurer leur croissance.",
  },
];
---

<section id="faq" class="border-t border-line px-6 py-12 md:px-12 md:py-16">
  <div class="mx-auto max-w-7xl">
    <Eyebrow>Questions directes</Eyebrow>
    <h2
      class="max-w-4xl text-[clamp(2rem,4.5vw,3.5rem)] font-normal leading-[1.05] tracking-[-0.03em] text-foreground"
    >
      Ce que vous alliez <em class="text-lime">me demander.</em>
    </h2>

    <div class="mt-10 max-w-4xl">
      {questions.map((item, i) => (
        <details class={`border-t border-line ${i === questions.length - 1 ? "border-b" : ""}`}>
          <summary
            class="flex cursor-pointer list-none items-baseline justify-between gap-6 py-6 text-lg font-medium text-foreground transition-colors hover:text-lime"
          >
            <span>{item.q}</span>
            <span class="faq-marqueur shrink-0 font-serif text-2xl leading-none text-lime" aria-hidden="true"></span>
          </summary>
          <p class="max-w-3xl pb-6 text-lg leading-relaxed text-ink-2">{item.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* Le triangle natif ne suit ni la grille ni la couleur d'accent : on l'efface
     et on rend le signe soi-même, en serif violet, aligné à droite du libellé. */
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ""; }

  .faq-marqueur::after { content: "+"; }
  details[open] .faq-marqueur::after { content: "–"; }
</style>
