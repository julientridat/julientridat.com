---
/**
 * Qui je suis — copy du 29/09/2026 : les grandes marques d'où vient le
 * métier, les équipes formées, puis ce que j'en fais aujourd'hui pour les PME.
 *
 * La bande de références est QUALIFIÉE : chaque groupe porte son statut
 * (équipes formées, en agence) plutôt que des noms alignés sans distinction,
 * qui invitaient au doute.
 *
 * Aucun client n'est nommé (décision du 30/09/2026) : les preuves de l'accueil
 * sont anonymisées, un nom ici les rendrait reconnaissables.
 */
import { Image } from "astro:assets";
import Eyebrow from "@/components/Eyebrow.astro";
import julien from "@/assets/julien.jpg";
import { accueil } from "@/lib/contenu";
import { enLigne } from "@/lib/texte";

const t = accueil.bio;
const references = t.references;
---

<section id="about" class="border-t border-line px-6 py-14 md:px-12 md:py-20">
  <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.4fr)] md:gap-16">
    <!-- 810 px : largeur native du recadrage, ne pas demander plus. -->
    <div data-reveal class="overflow-hidden rounded-3xl border border-line">
      <Image
        src={julien}
        alt={t.photoAlt}
        widths={[400, 600, 810]}
        sizes="(min-width: 768px) 35vw, 100vw"
        class="h-full w-full object-cover"
      />
    </div>

    <div data-reveal style="--reveal-delay: 120ms">
      <Eyebrow>{t.surtitre}</Eyebrow>
      <h2 class="text-[clamp(2rem,4.5vw,3.5rem)] font-normal leading-[1.05] tracking-[-0.03em] text-foreground">
        {t.titre}
        <br />
        <em class="text-lime">{t.titreAccent}</em>
      </h2>

      <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-2">
        {t.paragraphes.map((p) => (
          <p set:html={enLigne(p, { fort: "font-medium text-foreground", accent: "text-lime" })} />
        ))}
      </div>

      <p class="mt-6 font-serif text-2xl italic leading-snug text-foreground">
        {t.phrase}
      </p>
    </div>
  </div>

  <!-- Références en noms typographiés, pas en logos : aucun visuel de marque
       à licencier, et le texte reste lisible par les moteurs. Groupées par
       statut, plutôt qu'alignées sans distinction. -->
  <div data-reveal class="mx-auto mt-14 max-w-7xl border-t border-line pt-8 md:mt-16">
    <p class="text-[11px] uppercase tracking-[0.22em] text-ink-3">{t.referencesTitre}</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {references.map((groupe) => (
        <div>
          <p class="text-sm text-lime">{groupe.statut}</p>
          <ul class="mt-2 space-y-1">
            {groupe.noms.map((nom) => (
              <li class="text-[clamp(1.05rem,1.6vw,1.3rem)] font-medium tracking-[-0.02em] text-ink-3 transition-colors hover:text-foreground">
                {nom}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
