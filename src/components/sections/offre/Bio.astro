---
/**
 * Qui je suis — deux temps, et rien d'autre : les grandes marques d'où
 * vient le métier, puis ce que j'en fais aujourd'hui pour les PME. La
 * version précédente mêlait le marketing et la formation (300 formés, une
 * cinquantaine d'organisations) : ce n'est pas l'offre vendue ici. Les
 * formations citées le sont comme références de marques, pas comme offre.
 * La rareté reste en chute — l'équivalent du « limited roster » de Designjoy.
 */
import { Image } from "astro:assets";
import Eyebrow from "@/components/Eyebrow.astro";
import julien from "@/assets/julien.jpg";
---

<section id="about" class="border-t border-line px-6 py-12 md:px-12 md:py-16">
  <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.4fr)] md:gap-16">
    <!-- 810 px : largeur native du recadrage, ne pas demander plus. -->
    <div class="overflow-hidden rounded-2xl border border-line">
      <Image
        src={julien}
        alt="Julien Tridat"
        widths={[400, 600, 810]}
        sizes="(min-width: 768px) 35vw, 100vw"
        class="h-full w-full object-cover"
      />
    </div>

    <div>
      <Eyebrow>Qui je suis</Eyebrow>
      <h2 class="text-[clamp(2rem,4.5vw,3.5rem)] font-normal leading-[1.05] tracking-[-0.03em] text-foreground">
        Julien Tridat.
        <br />
        <em class="text-lime">Un marketeur qui construit ce qu'il conseille.</em>
      </h2>

      <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-2">
        <p>
          J'ai travaillé pour Publicis, auprès de marques comme Heineken et L'Oréal. J'ai formé les
          équipes de Dassault&nbsp;Systèmes et de Lagardère&nbsp;Travel&nbsp;Retail.
        </p>
        <p>
          <strong class="font-medium text-foreground">
            Aujourd'hui, augmenté par l'IA, j'accompagne des PME dans leur stratégie de
            croissance
          </strong>{" "}
          — je deviens leur monsieur marketing et leur monsieur IA maison.
        </p>
      </div>

      <p class="mt-6 font-serif text-2xl italic leading-snug text-foreground">
        Il n'y a que quatre places.
      </p>

      <a href="/realisations" class="group mt-8 inline-flex items-center gap-3 text-base text-lime">
        Voir les réalisations
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</section>
