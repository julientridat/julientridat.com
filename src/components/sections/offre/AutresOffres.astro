---
/**
 * Aiguillage vers les deux autres offres — dernière section de la page d'accueil.
 *
 * Remplace la bande « Deuxième offre » qui ne pointait que vers la formation.
 * Avec l'arrivée de /integration-ia il en aurait fallu une seconde, et deux
 * bandes à la suite encombrent le chemin de conversion : une seule bande,
 * deux sorties.
 *
 * Volontairement placée APRÈS le CTA final, donc hors du tunnel : le lecteur
 * qui va réserver n'a rien à arbitrer. Celui qui n'a pas été convaincu par la
 * direction marketing trouve ici pourquoi — parce que son problème n'est pas
 * celui-là.
 *
 * Chaque carte ouvre sur le SYMPTÔME de son blocage, jamais sur son périmètre :
 * c'est le principe qui distingue les trois offres du site.
 */
import Eyebrow from "@/components/Eyebrow.astro";

const offres = [
  {
    surtitre: "Intégration IA",
    symptome: "Vous avez essayé l'IA, ça n'a pas tenu&nbsp;?",
    texte:
      "Des comptes ouverts chacun dans son coin, des résultats qui ne se ressemblent pas, rien d'écrit nulle part. J'installe des agents dans vos outils, sur vos vrais dossiers, et je forme ceux qui s'en servent.",
    detail: "Audit 1 500 € · intégration d'un pôle à partir de 6 000 €",
    lien: "/integration-ia",
    libelle: "Voir l'offre d'intégration",
  },
  {
    surtitre: "Formation",
    symptome: "Vous cherchez à faire monter vos équipes&nbsp;?",
    texte:
      "J'interviens en intra-entreprise sur l'intelligence artificielle et le marketing, via des organismes partenaires certifiés Qualiopi — financement OPCO possible.",
    detail: "Plus de 300 dirigeants et cadres formés",
    lien: "/formation-ia",
    libelle: "Voir l'offre de formation",
  },
];
---

<section id="autres-offres" class="border-t border-line px-6 py-10 md:px-12 md:py-14">
  <div class="mx-auto max-w-7xl">
    <Eyebrow>Les autres offres</Eyebrow>
    <div class="grid gap-6 md:grid-cols-2 md:items-end md:gap-12">
      <h2
        class="max-w-xl text-[clamp(1.8rem,3.6vw,2.8rem)] font-normal leading-[1.1] tracking-[-0.03em] text-foreground"
      >
        Ce n'est pas votre problème&nbsp;?
        <br />
        <em class="text-lime">C'est peut-être l'un de ceux-là.</em>
      </h2>
      <p class="text-lg leading-relaxed text-ink-2 md:max-w-lg">
        La direction marketing répond à une absence&nbsp;: personne ne s'en occupe. Les deux
        autres répondent à autre chose.
      </p>
    </div>

    <div class="mt-10 grid items-start gap-5 md:grid-cols-2">
      {offres.map((o) => (
        <a
          href={o.lien}
          class="group flex flex-col rounded-2xl border border-line bg-card p-7 transition-colors hover:border-lime/60 md:p-8"
        >
          <span class="text-[11px] uppercase tracking-[0.22em] text-ink-3">{o.surtitre}</span>
          <h3
            class="mt-3 text-xl font-medium leading-snug text-foreground transition-colors group-hover:text-lime"
            set:html={o.symptome}
          />
          <p class="mt-3 flex-1 text-base leading-relaxed text-ink-2">{o.texte}</p>
          <span class="mt-6 border-t border-line pt-4 text-sm text-ink-3">{o.detail}</span>
          <span class="mt-3 inline-flex items-center gap-2 text-sm text-lime">
            {o.libelle}
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
