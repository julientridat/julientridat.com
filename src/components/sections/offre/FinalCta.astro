---
/**
 * Clôture sombre, en réponse au hero. Le même et unique bouton que partout
 * sur la page : « Réserver 20 minutes », qui passe par les huit questions
 * d'éligibilité avant le calendrier.
 */
import Eyebrow from "@/components/Eyebrow.astro";
import CtaButton from "@/components/CtaButton.astro";
import { accueil } from "@/lib/contenu";
import { enLigne } from "@/lib/texte";

const t = accueil.cloture;
---

<section
  id="contact"
  class="relative isolate overflow-hidden bg-foreground px-6 py-16 text-white md:px-12 md:py-20"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(58% 90% at 50% 115%, rgba(108,76,241,0.22), transparent 70%);"
  >
  </div>

  <div class="mx-auto max-w-4xl text-center">
    <Eyebrow onDark>{t.surtitre}</Eyebrow>

    <h2 class="text-[clamp(2.2rem,5.5vw,4.5rem)] font-normal leading-[1.02] tracking-[-0.03em]">
      {t.titre} <em class="text-violet-soft">{t.titreAccent}</em>
    </h2>

    <p
      class="mx-auto mt-8 max-w-2xl text-xl leading-relaxed text-white/75"
      set:html={enLigne(t.texte, { fort: "font-medium text-white", accent: "text-violet-soft" })}
    />

    <div class="mt-12 flex flex-col items-center gap-5">
      <CtaButton onDark ouvre="diagnostic">{accueil.bouton}</CtaButton>
      <p class="text-sm text-white/55">{t.mention}</p>
    </div>
  </div>
</section>
