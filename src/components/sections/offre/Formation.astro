---
/**
 * Deuxième offre — la formation.
 *
 * Écrite pour le DIRIGEANT (celui de toute la page), pas pour l'organisme de
 * formation : son problème est de faire monter son équipe, pas de référencer
 * un sous-traitant. L'argument central est le financement OPCO, qui n'existait
 * nulle part jusqu'ici.
 *
 * ATTENTION — la page cible /formation-ia s'adresse aujourd'hui aux ORGANISMES
 * de formation (« ce qu'il vous faut pour me référencer », « Qualiopi non
 * détenue en propre »). Tant qu'elle n'est pas repositionnée, un dirigeant qui
 * clique atterrit sur un dossier de sous-traitance. Repositionnement à faire.
 */
import Eyebrow from "@/components/Eyebrow.astro";
---

<section id="formation" class="border-t border-line px-6 py-10 md:px-12 md:py-14">
  <div class="mx-auto max-w-7xl">
    <Eyebrow>Deuxième offre</Eyebrow>
    <div class="grid gap-10 md:grid-cols-2 md:items-end">
      <h2
        class="max-w-xl text-[clamp(1.8rem,3.6vw,2.8rem)] font-normal leading-[1.1] tracking-[-0.03em] text-foreground"
      >
        Vous cherchez une formation,
        <br />
        <em class="text-lime">pas un accompagnement&nbsp;?</em>
      </h2>
      <div class="md:max-w-md">
        <p class="text-lg leading-relaxed text-ink-2">
          J'interviens aussi en intra-entreprise sur l'intelligence artificielle et le marketing,
          via des organismes partenaires certifiés Qualiopi&nbsp;—{" "}
          <strong class="font-medium text-foreground">financement OPCO possible</strong>.
        </p>
        <a
          href="/formation-ia"
          class="group mt-6 inline-flex items-center gap-2 rounded-full border border-line px-6 py-3.5 text-base text-ink-2 transition-colors hover:border-lime hover:text-lime"
        >
          Voir l'offre de formation
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
