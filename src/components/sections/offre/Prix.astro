---
/**
 * Le prix — une seule carte, sur le modèle de Designjoy : un montant,
 * 2 500 € dès le premier mois (décision de lancement, septembre 2026 — il
 * y avait auparavant 4 000 € le premier mois), sept lignes incluses, et à côté ce qui rassure
 * (l'équivalent de « Pause anytime / Try it for a week »).
 *
 * Aucune garantie de remboursement n'est écrite : il n'en existe pas. Ce qui
 * rassure ici est vrai — les livrables restent, la pause garde la place.
 */
import Eyebrow from "@/components/Eyebrow.astro";
import CtaButton from "@/components/CtaButton.astro";

const inclus = [
  "Positionnement et offre",
  "Identité et gabarits",
  "Plan marketing sur douze mois",
  "Assistants IA installés, équipes formées",
  "Demandes illimitées, 48 à 72 h chacune",
  "Un point de 45 minutes chaque semaine",
  "Pause ou arrêt à tout moment",
];

const montant = "font-serif text-[clamp(2.75rem,6vw,4.25rem)] italic leading-[0.9] tracking-tight";
const surTitre = "text-[11px] uppercase tracking-[0.22em] text-ink-3";
---

<section id="offres" class="border-t border-line bg-card px-6 py-12 md:px-12 md:py-16">
  <div class="mx-auto max-w-7xl">
    <Eyebrow>Le prix</Eyebrow>
    <h2 class="text-[clamp(2rem,4.5vw,3.5rem)] font-normal leading-[1.05] tracking-[-0.03em] text-foreground">
      Une formule. <em class="text-lime">Sans engagement.</em>
    </h2>

    <div class="mt-10 grid items-stretch gap-5 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
      <div class="rounded-2xl border border-lime bg-lime/[0.05] p-8 md:p-10">
        <div class={surTitre}>Chaque mois, dès le premier</div>
        <div class="mt-3 flex flex-wrap items-baseline gap-x-3">
          <span class={`${montant} text-lime`}>2&nbsp;500&nbsp;€</span>
          <span class="text-base text-ink-3">HT / mois, installation comprise</span>
        </div>

        <ul class="mt-8 grid gap-x-8 border-t border-line pt-6 sm:grid-cols-2">
          {inclus.map((i) => (
            <li class="flex gap-3 py-2 text-base leading-relaxed text-ink-2">
              <span class="text-lime" aria-hidden="true">✓</span>
              {i}
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col gap-5">
        <div class="rounded-2xl border border-line bg-background p-7">
          <h3 class="text-lg font-medium text-foreground">Vous gardez tout.</h3>
          <p class="mt-1.5 text-base leading-relaxed text-ink-2">
            Si vous arrêtez après le premier mois, le positionnement, l'identité et le plan vous
            restent.
          </p>
        </div>
        <div class="rounded-2xl border border-line bg-background p-7">
          <h3 class="text-lg font-medium text-foreground">Pause possible.</h3>
          <p class="mt-1.5 text-base leading-relaxed text-ink-2">Votre place est gardée.</p>
        </div>
        <div class="mt-auto flex flex-col items-start gap-4 pt-2">
          <CtaButton ouvre="diagnostic">Suis-je éligible&nbsp;?</CtaButton>
          <p class="text-sm text-ink-3">Au-delà de 30&nbsp;salariés&nbsp;: sur devis.</p>
        </div>
      </div>
    </div>
  </div>
</section>
