---
/**
 * Le prix — seule section sombre au milieu de la page : c'est le moment de
 * la décision, il doit rompre avec le parcours clair (hero et clôture sont
 * les deux autres). Une carte, un montant, six lignes incluses ; à côté, les
 * conditions :
 * trois mois d'engagement avec 30 jours d'essai, ensuite arrêt et reprise à
 * tout moment ; le premier mois peut partir d'un projet précis du client
 * (décisions du 01/10/2026), prélèvement en début de
 * mois. La preuve « Quatre ans » est passée dans la section Preuves.
 *
 * Aucune garantie de remboursement n'est écrite : il n'en existe pas.
 *
 * `isolate` : sans stacking context, les halos en -z-10 passeraient derrière
 * le fond et disparaîtraient.
 */
import Eyebrow from "@/components/Eyebrow.astro";
import CtaButton from "@/components/CtaButton.astro";
import { accueil } from "@/lib/contenu";
import { enLigne } from "@/lib/texte";

const t = accueil.prix;
const inclus = t.inclus;

---

<section
  id="offres"
  class="relative isolate overflow-hidden bg-foreground px-6 py-16 text-white md:px-12 md:py-24"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(45% 55% at 30% 55%, rgba(108,76,241,0.28), transparent 70%), radial-gradient(35% 40% at 85% 10%, rgba(185,166,255,0.10), transparent 70%);"
  >
  </div>

  <div class="mx-auto max-w-7xl">
    <div data-reveal>
      <Eyebrow onDark>{t.surtitre}</Eyebrow>
      <h2 class="text-[clamp(2.2rem,5vw,4rem)] font-normal leading-[1.02] tracking-[-0.035em]">
        {t.titre}<br class="sm:hidden" />
        <em class="text-violet-soft">{t.titreAccent}</em>
      </h2>
    </div>

    <div class="mt-12 grid items-stretch gap-5 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)]">
      <!-- Bordure en dégradé violet : un fond dégradé dans un cadre de 1 px. -->
      <div
        data-reveal
        style="--reveal-delay: 100ms"
        class="rounded-[1.75rem] bg-gradient-to-br from-violet-soft/70 via-lime/60 to-lime/10 p-px shadow-[0_40px_120px_-40px_rgba(108,76,241,0.75)]"
      >
        <div class="h-full rounded-[calc(1.75rem-1px)] bg-[#17151f] p-8 md:p-11">
          <div class="text-[11px] uppercase tracking-[0.22em] text-violet-soft">
            {t.etiquette}
          </div>
          <div class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <span class="font-serif text-[clamp(4.5rem,11vw,8.5rem)] italic leading-[0.82] tracking-tight text-white">
              {t.montant}
            </span>
            <span class="text-base text-white/60">{t.montantDetail}</span>
          </div>

          <ul class="mt-10 grid gap-x-10 border-t border-white/10 pt-7 sm:grid-cols-2">
            {inclus.map((i) => (
              <li class="flex gap-3 py-2 text-base leading-relaxed text-white/85">
                <span class="text-violet-soft" aria-hidden="true">✓</span>
                {i}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div data-reveal style="--reveal-delay: 200ms" class="flex flex-col gap-5">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-7 backdrop-blur-sm">
          <h3 class="text-[11px] uppercase tracking-[0.22em] text-violet-soft">{t.conditionsTitre}</h3>
          <div class="mt-4 space-y-4 text-base leading-relaxed text-white/75">
            {t.conditions.map((c) => (
              <p set:html={enLigne(c, { fort: "font-medium text-white", accent: "text-violet-soft" })} />
            ))}
          </div>
        </div>
        <div class="mt-auto flex flex-col items-start gap-4 pt-2">
          <CtaButton onDark ouvre="diagnostic">{accueil.bouton}</CtaButton>
          <p class="text-sm text-white/55">{t.mention}</p>
        </div>
      </div>
    </div>
  </div>
</section>
