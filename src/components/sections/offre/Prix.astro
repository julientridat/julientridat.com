---
import Eyebrow from "@/components/Eyebrow.astro";
import CtaButton from "@/components/CtaButton.astro";

// Les insécables de ces libellés sont de vrais caractères U+00A0 : dans une
// chaîne du frontmatter, une entité HTML ressortirait telle quelle à l'écran.
// `fort` = ligne appuyée : les deux engagements qui tiennent l'offre debout —
// le rythme de livraison, et ce qui vous reste après.
const inclus = [
  { texte: "45 minutes de point stratégique chaque semaine", fort: false },
  { texte: "Accès direct de vos équipes, sans intermédiaire", fort: false },
  { texte: "Une demande active à la fois, livrée en 48 à 72 heures", fort: true },
  { texte: "Sans engagement, résiliable à tout moment", fort: false },
  { texte: "Pause possible, place gardée — pas de salaire à vide en période creuse", fort: false },
  { texte: "Vous gardez tous les livrables et les outils installés, y compris après résiliation", fort: true },
  { texte: "Un seul interlocuteur : moi", fort: false },
];
---

<section id="offres" class="border-t border-line px-6 py-24 md:px-12 md:py-32">
  <div class="mx-auto max-w-7xl">
    <Eyebrow>Le prix</Eyebrow>
    <h2 class="max-w-4xl text-[clamp(2rem,4.5vw,3.5rem)] font-light leading-[1.05] tracking-[-0.03em] text-foreground">
      Deux lignes.
      <br />
      <em class="text-lime">Rien d'autre.</em>
    </h2>

    <div class="mt-16 max-w-4xl rounded-2xl border border-line bg-card p-8 md:p-12">
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <div class="text-[11px] uppercase tracking-[0.22em] text-ink-3">Le premier mois</div>
          <div class="mt-4 flex flex-wrap items-baseline gap-x-3">
            <span class="font-serif text-[clamp(2.5rem,5vw,3.5rem)] italic leading-none tracking-tight text-foreground">
              4&nbsp;000&nbsp;€
            </span>
            <span class="font-sans text-base not-italic text-ink-3">HT</span>
          </div>
        </div>

        <div>
          <div class="text-[11px] uppercase tracking-[0.22em] text-ink-3">Puis, chaque mois</div>
          <div class="mt-4 flex flex-wrap items-baseline gap-x-3">
            <span class="font-serif text-[clamp(2.5rem,5vw,3.5rem)] italic leading-none tracking-tight text-lime">
              2&nbsp;500&nbsp;€
            </span>
            <span class="font-sans text-base not-italic text-ink-3">/ mois HT</span>
          </div>
        </div>
      </div>

      <p class="mt-8 font-serif text-lg italic text-lime">
        Quatre clients en abonnement. Pas plus.
      </p>

      <ul class="mt-8">
        {inclus.map((i) => (
          <li class="border-t border-line py-3.5 text-sm leading-relaxed text-ink-2">
            {i.fort ? <strong class="font-medium text-foreground">{i.texte}</strong> : i.texte}
          </li>
        ))}
      </ul>

      <div class="mt-10">
        <CtaButton>Réserver 20&nbsp;minutes</CtaButton>
      </div>
    </div>
  </div>
</section>
