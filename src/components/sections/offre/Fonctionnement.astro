---
/**
 * Comment ça marche — trois étapes, et une MÉCANIQUE qui les montre au lieu
 * de les raconter : une file de demandes qui avance toute seule. Une demande
 * passe « en cours », est livrée (de J+1 à J+3 selon sa complexité), sort de la file, et une autre
 * arrive derrière. C'est « autant de demandes que vous voulez, traitées
 * l'une après l'autre » rendu visible.
 *
 * La file est décorative (aria-hidden) : son contenu est dit en toutes
 * lettres par les trois étapes. Sans JS ou en mouvement réduit, elle reste
 * figée dans son état initial, lisible.
 *
 * En pied de section, le bandeau de livrables défile — l'équivalent du
 * bandeau de Designjoy.
 */
import Eyebrow from "@/components/Eyebrow.astro";

const etapes = [
  {
    titre: "J'installe.",
    texte:
      "Le premier mois : positionnement, identité, plan marketing sur douze mois, assistants IA dans vos outils.",
  },
  {
    titre: "Vous demandez.",
    texte:
      "Autant que vous voulez, dans l'ordre que vous fixez. Vos équipes m'écrivent en direct.",
  },
  {
    titre: "C'est livré.",
    texte: "De J+1 à J+3 selon la demande, avec un point de 45 minutes chaque semaine.",
  },
];

// État initial de la file, identique à ce que le script affiche au démarrage.
// Des demandes ambitieuses, pas des micro-tâches : afficher « 57 h » pour un
// post LinkedIn faisait peur. Les délais sont en jours, J+1 à J+3.
const fileInitiale = [
  "Refonte complète de la page Offre",
  "Campagne de relance : 3 e-mails",
  "Présentation commerciale, 15 slides",
  "Étude de 5 concurrents",
];

const livrables = [
  "Site",
  "Supports de vente",
  "Devis et présentations",
  "Relances",
  "Publications",
  "Identité",
  "Plan marketing",
  "Assistants IA",
];

const badge = {
  attente: "border border-line text-ink-3",
  cours: "bg-lime/10 text-lime",
};
---

<section id="comment" class="overflow-hidden border-t border-line pt-14 md:pt-20">
  <div class="px-6 md:px-12">
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:items-center lg:gap-16">
      <div data-reveal>
        <Eyebrow>Comment ça marche</Eyebrow>
        <h2 class="text-[clamp(2.2rem,5vw,4rem)] font-normal leading-[1.02] tracking-[-0.035em] text-foreground lg:text-[clamp(2.4rem,3.6vw,3.4rem)]">
          Un mois pour installer.
          <br />
          <em class="text-lime">Puis ça tourne.</em>
        </h2>

        <ol class="mt-10 space-y-7">
          {etapes.map((e, i) => (
            <li class="grid grid-cols-[3.25rem_1fr] gap-x-4">
              <span class="font-serif text-[2.6rem] italic leading-[0.85] text-lime">
                {String(i + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="text-xl font-medium text-foreground">{e.titre}</h3>
                <p class="mt-1 text-base leading-relaxed text-ink-2">{e.texte}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- La file de demandes, animée par le script plus bas. -->
      <div data-reveal style="--reveal-delay: 120ms" class="relative min-w-0">
        <div
          class="pointer-events-none absolute -inset-10 -z-10 rounded-[3rem] opacity-70 blur-3xl"
          style="background: radial-gradient(60% 60% at 60% 40%, rgba(108,76,241,0.18), transparent 70%);"
        >
        </div>
        <div
          id="file"
          aria-hidden="true"
          class="rounded-3xl border border-line bg-card p-5 shadow-[0_40px_90px_-45px_rgba(17,18,22,0.45)] md:p-7"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="text-[11px] uppercase tracking-[0.22em] text-ink-3">Votre file de demandes</span>
            <span class="text-sm text-ink-2">
              <span id="file-compteur" class="font-serif text-3xl italic leading-none text-lime">12</span>
              livrées
            </span>
          </div>

          <ul id="file-liste" class="relative mt-5 h-[18.5rem] overflow-hidden md:h-[19.5rem]">
            {fileInitiale.map((t, i) => (
              <li class="file-ligne mb-2.5 rounded-2xl border border-line bg-background px-4 py-3.5">
                <div class="flex items-center justify-between gap-3">
                  <span class="min-w-0 truncate text-sm font-medium text-foreground sm:text-[15px]">{t}</span>
                  <span class={`file-badge shrink-0 whitespace-nowrap rounded-full px-3 py-1 text-xs font-medium ${i === 0 ? badge.cours : badge.attente}`}>
                    {i === 0 ? "En cours" : `En attente · ${i}`}
                  </span>
                </div>
                <div class={`mt-2.5 h-1 overflow-hidden rounded-full bg-line ${i === 0 ? "" : "hidden"}`}>
                  <div class="file-barre h-full w-1/3 rounded-full bg-lime"></div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Bandeau de livrables. La seconde copie ne sert qu'à boucler le défilement. -->
  <div class="marquee mt-16 border-t border-line py-7 md:mt-20 md:py-9" aria-label="Ce que vous pouvez demander">
    <div class="marquee-piste flex w-max">
      {[0, 1].map((k) => (
        <ul class="flex shrink-0 items-center" aria-hidden={k === 1 ? "true" : undefined}>
          {livrables.map((l, i) => (
            <li class="flex items-center">
              <span
                class={`px-7 text-[clamp(1.9rem,4.2vw,3.4rem)] leading-none tracking-[-0.03em] whitespace-nowrap ${
                  i % 2 ? "font-serif italic text-lime" : "font-medium text-foreground"
                }`}
              >
                {l}
              </span>
              <span class="text-lg text-lime/50">✦</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee {
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-piste {
    animation: defile 42s linear infinite;
  }
  .marquee:hover .marquee-piste {
    animation-play-state: paused;
  }
  @keyframes defile {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-piste {
      animation: none;
    }
  }
</style>

<script>
  /* La file avance d'une demande toutes les 3,2 s : la première est livrée,
     sort par le haut, les autres remontent, une nouvelle arrive en bas.
     Tourne seulement quand la file est à l'écran et l'onglet visible. */
  const liste = document.getElementById("file-liste");
  const compteur = document.getElementById("file-compteur");
  const reduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Chaque demande a son délai : J+1 pour les plus directes, J+3 pour les
  // plus lourdes. Les quatre dernières sont celles affichées au chargement.
  const reserve: [string, string][] = [
    ["Landing page salon + formulaire", "J+2"],
    ["Séquence de prospection LinkedIn", "J+1"],
    ["Plaquette produit, 8 pages", "J+3"],
    ["Assistant IA pour rédiger les devis", "J+3"],
    ["Argumentaire de la nouvelle gamme", "J+1"],
    ["Kit visuels réseaux sociaux du mois", "J+2"],
    ["Page recrutement + offre d'emploi", "J+1"],
    ["Newsletter clients + visuels", "J+2"],
    ["Refonte complète de la page Offre", "J+3"],
    ["Campagne de relance : 3 e-mails", "J+1"],
    ["Présentation commerciale, 15 slides", "J+2"],
    ["Étude de 5 concurrents", "J+2"],
  ];
  // Délais des quatre lignes présentes au chargement, dans l'ordre.
  const delaisInitiaux = ["J+3", "J+1", "J+2", "J+2"];

  const CLS_ATTENTE = "border border-line text-ink-3";
  const CLS_COURS = "bg-lime/10 text-lime";
  const CLS_LIVRE = "bg-lime text-white";
  const BASE_BADGE =
    "file-badge shrink-0 whitespace-nowrap rounded-full px-3 py-1 text-xs font-medium";

  if (liste && compteur && !reduit) {
    let prochain = 0;
    let livrees = 12;
    let visible = false;
    let occupe = false;

    const badgeDe = (li: Element) => li.querySelector(".file-badge") as HTMLElement;
    const barreDe = (li: Element) => li.querySelector(".file-barre") as HTMLElement;

    const renumeroter = () => {
      [...liste.children].forEach((li, i) => {
        if (i === 0) return;
        const b = badgeDe(li);
        b.className = `${BASE_BADGE} ${CLS_ATTENTE}`;
        b.textContent = `En attente · ${i}`;
      });
    };

    const lancer = (li: Element) => {
      const b = badgeDe(li);
      b.className = `${BASE_BADGE} ${CLS_COURS}`;
      b.textContent = "En cours";
      const piste = barreDe(li).parentElement as HTMLElement;
      piste.classList.remove("hidden");
      barreDe(li).animate([{ width: "4%" }, { width: "100%" }], {
        duration: 2400,
        easing: "cubic-bezier(.4,.1,.3,1)",
        fill: "forwards",
      });
    };

    const nouvelleLigne = (titre: string) => {
      const li = document.createElement("li");
      li.className = "file-ligne mb-2.5 rounded-2xl border border-line bg-background px-4 py-3.5";
      li.innerHTML = `<div class="flex items-center justify-between gap-3"><span class="min-w-0 truncate text-sm font-medium text-foreground sm:text-[15px]"></span><span class="${BASE_BADGE} ${CLS_ATTENTE}"></span></div><div class="mt-2.5 hidden h-1 overflow-hidden rounded-full bg-line"><div class="file-barre h-full w-0 rounded-full bg-lime"></div></div>`;
      (li.querySelector("span") as HTMLElement).textContent = titre;
      return li;
    };

    const avancer = async () => {
      if (occupe || !visible || document.hidden) return;
      occupe = true;
      const premier = liste.children[0] as HTMLElement;

      // 1. Livrée.
      const b = badgeDe(premier);
      b.className = `${BASE_BADGE} ${CLS_LIVRE}`;
      const delai = delaisParLigne.get(premier) ?? "J+2";
      b.textContent = `✓ Livré à ${delai}`;
      b.animate([{ transform: "scale(.85)" }, { transform: "scale(1.06)" }, { transform: "scale(1)" }], {
        duration: 420,
        easing: "ease-out",
      });
      livrees += 1;
      compteur.textContent = String(livrees);
      compteur.animate([{ transform: "translateY(6px)", opacity: 0.3 }, { transform: "none", opacity: 1 }], {
        duration: 380,
        easing: "ease-out",
      });

      await new Promise((r) => setTimeout(r, 850));

      // 2. Elle sort, une nouvelle arrive en bas.
      const [titre, delaiArrivee] = reserve[prochain % reserve.length];
      const arrivee = nouvelleLigne(titre);
      delaisParLigne.set(arrivee, delaiArrivee);
      prochain += 1;
      liste.appendChild(arrivee);
      arrivee.animate([{ opacity: 0, transform: "translateY(14px)" }, { opacity: 1, transform: "none" }], {
        duration: 520,
        easing: "cubic-bezier(.2,.7,.2,1)",
      });

      const hauteur = premier.getBoundingClientRect().height + 10;
      await premier.animate(
        [
          { opacity: 1, marginTop: "0px" },
          { opacity: 0, marginTop: `-${hauteur}px` },
        ],
        { duration: 520, easing: "cubic-bezier(.4,0,.2,1)", fill: "forwards" },
      ).finished;
      premier.remove();

      // 3. La suivante passe en cours.
      renumeroter();
      lancer(liste.children[0]);
      occupe = false;
    };

    // Le délai de chaque ligne, retrouvé au moment de sa livraison.
    const delaisParLigne = new WeakMap<Element, string>();
    [...liste.children].forEach((li, i) => delaisParLigne.set(li, delaisInitiaux[i] ?? "J+2"));

    // Démarrage : la barre de la première ligne se remplit.
    const premiere = liste.children[0];
    if (premiere) lancer(premiere);

    new IntersectionObserver(
      (entrees) => {
        visible = entrees.some((e) => e.isIntersecting);
      },
      { threshold: 0.25 },
    ).observe(liste);

    setInterval(avancer, 3200);
  }
</script>
