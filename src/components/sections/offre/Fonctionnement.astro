---
import Eyebrow from "@/components/Eyebrow.astro";

// Les espaces insécables des données sont des U+00A0 littéraux : dans le
// frontmatter, une entité &nbsp; serait échappée et rendue telle quelle.
const installation = [
  {
    titre: "Ce que vous vendez tient en une phrase.",
    texte:
      "Une phrase que vos commerciaux répètent sans se tromper, et que vos clients comprennent du premier coup.",
  },
  {
    titre: "Tous vos documents se ressemblent enfin.",
    texte:
      "Logo, couleurs, modèles prêts à l'emploi : vos devis, vos présentations et vos supports commerciaux ne sont plus refaits de zéro à chaque fois.",
  },
  {
    titre: "Deux ou trois assistants IA travaillent dans les outils que vous utilisez déjà.",
    texte: "Pas une démonstration : installés, sur vos comptes, sur vos vrais dossiers.",
  },
  {
    titre: "Vos équipes savent se servir de tout ça.",
    texte: "Formées, pas informées.",
  },
];

const recurrence = [
  {
    titre: "45 minutes chaque semaine, dans votre agenda.",
    texte: "On fait le point, vous décidez ce qui passe en premier, je m'en occupe.",
  },
  {
    titre: "Vos équipes m'écrivent en direct.",
    texte: "Pas de ticket, pas d'intermédiaire, pas de brief à rédiger.",
  },
  {
    titre: "Au fil des mois :",
    texte:
      "refonte du site, campagnes, contenus, la façon dont un prospect devient client. Et vos assistants IA arrivent dans un service de plus à chaque fois : commerce, gestion, administratif.",
  },
  {
    titre: "Pause possible, place gardée.",
    texte:
      "Saison basse, coup dur, trésorerie tendue : vous suspendez, et vous reprenez plus tard sans repartir de zéro.",
  },
];

/**
 * Trois missions déjà publiées, choisies parce qu'elles ont une colonne
 * vertébrale marketing — les neuf autres études de cas du site sont des
 * missions d'installation d'IA ou de formation, hors sujet ici.
 */
const preuves = [
  {
    client: "Franchisé multi-clubs",
    livrable: "Charte et gabarits",
    texte:
      "La charte d'une enseigne nationale transformée en gabarits que l'équipe utilise seule : posts, stories, affichage en club. Plus de graphiste dans la boucle.",
    url: "/realisations/design-system-franchise-fitness",
  },
  {
    client: "Association de prévention",
    livrable: "Démarchage et relances",
    texte:
      "Un démarchage et des relances outillés de bout en bout, puis un emailing sur son propre domaine — 537 contacts, et des moyens qui ne dépendent plus d'un outil gratuit.",
    url: "/realisations/association-benevoles-autonome",
  },
  {
    client: "Enseigne, 600+ magasins",
    livrable: "Supports commerciaux",
    texte:
      "L'équipe marketing décline ses supports sur tout le réseau sans repasser par un prestataire, et sait lesquels outiller ensuite.",
    url: "/realisations/acculturation-enseigne-nationale",
  },
];

const phaseBlock = "border-t border-line py-10 md:py-14";
// Aucun montant ici : le prix est donné dans le hero et détaillé dans la
// section « Le prix ». Cette section-ci explique le fonctionnement.
//
// L'étiquette est en violet sur fond violet très dilué, et non en gris :
// « Mois 1 » et « Ensuite » donnent la séquence de l'offre, et l'ink-3 les
// rendait à 3,4:1 de contraste — sous le seuil de lisibilité.
const tagLabel =
  "inline-flex rounded-full border border-lime/30 bg-lime/[0.06] px-3.5 py-1.5 text-[11px] uppercase tracking-[0.22em] text-lime";
const phaseTitre = "mt-5 max-w-3xl text-2xl font-medium leading-snug text-foreground md:text-3xl";
// Treillis 1 px : les cellules sont posées sur un fond `bg-line` avec une
// gouttière d'un pixel, ce qui dessine un tableau continu. En filets par ligne,
// la gouttière de la grille coupait le trait en deux au milieu.
const itemRow = "bg-background px-6 py-4 md:px-7";
const itemListe =
  "mt-8 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-2";
---

<section id="comment" class="border-t border-line px-6 py-10 md:px-12 md:py-14">
  <div class="mx-auto max-w-7xl">
    <Eyebrow>Comment ça marche</Eyebrow>
    <h2
      class="text-[clamp(2rem,4.5vw,3.5rem)] font-normal leading-[1.05] tracking-[-0.03em] text-foreground"
    >
      Un mois pour installer.
      <br />
      <em class="text-lime">Puis chaque semaine pour faire tourner.</em>
    </h2>

    <!-- Phase 1 — le mois d'installation. -->
    <div class={phaseBlock}>
      <span class={tagLabel}>Mois&nbsp;1 · Installation</span>

      <h3 class={phaseTitre}>Au bout d'un mois, votre marketing existe.</h3>

      <ul class={itemListe}>
        {installation.map((i) => (
          <li class={itemRow}>
            <p class="text-lg leading-relaxed text-ink-2">
              <strong class="font-medium text-foreground">{i.titre}</strong>{" "}
              {i.texte}
            </p>
          </li>
        ))}
      </ul>

      <p class="mt-8 max-w-2xl font-serif text-xl italic text-ink-2">
        Tout cela vous appartient. Même si vous vous arrêtez là.
      </p>

      <!--
        « Déjà livré ailleurs », et pas « mêmes livrables » : ces trois missions
        ne sont pas des abonnements de direction marketing — l'offre est neuve.
        Ce sont des livrables du même type, produits ailleurs. L'alias du client
        est affiché sur chaque carte pour que personne ne confonde le profil
        (une enseigne de 600 magasins n'est pas une PME de 30 salariés).
      -->
      <p class="mt-12 text-[11px] uppercase tracking-[0.22em] text-ink-3">Déjà livré ailleurs</p>
      <div class="mt-5 grid gap-5 md:grid-cols-3">
        {preuves.map((c) => (
          <a
            href={c.url}
            class="group flex flex-col rounded-2xl border border-line bg-card p-6 transition-colors hover:border-lime/60"
          >
            <span class="text-[11px] uppercase tracking-[0.22em] text-ink-3">{c.client}</span>
            <h4 class="mt-3 text-base font-medium text-foreground transition-colors group-hover:text-lime">
              {c.livrable}
            </h4>
            <p class="mt-2 flex-1 text-base leading-relaxed text-ink-2">{c.texte}</p>
            <span class="mt-5 text-sm text-ink-3 transition-colors group-hover:text-lime">
              Voir le cas ↗
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Phase 2 — l'abonnement mensuel. -->
    <div class={`${phaseBlock} border-b`}>
      <span class={tagLabel}>Ensuite · Chaque mois, sans engagement</span>

      <!--
        La tuile agenda n'illustre pas le service : elle matérialise la place prise
        dans l'équipe. C'est le créneau récurrent qui rend l'abonnement concret,
        pas la liste qui suit. Décorative, donc masquée aux lecteurs d'écran —
        l'information est reprise en toutes lettres dans le premier item.

        Elle est posée à DROITE du titre de phase, dans la place que celui-ci
        laisse libre : seule sur sa ligne, elle traînait 900 px de vide derrière elle.
      -->
      <div class="mt-5 grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
        <h3 class="max-w-3xl text-2xl font-medium leading-snug text-foreground md:text-3xl">
          Chaque semaine, vos livrables sortent, votre marketing s'expose, vos équipes se
          renforcent.
        </h3>

        <div
          aria-hidden="true"
          class="rounded-2xl border border-line bg-card p-4 md:max-w-sm"
        >
          <div class="text-[11px] uppercase tracking-[0.22em] text-lime">
            MARDI · 9&nbsp;H&nbsp;15 — 10&nbsp;H
          </div>
          <div class="mt-1.5 text-base font-medium text-foreground">Point hebdo — Julien</div>
          <div class="mt-1 text-xs text-ink-3">Toutes les semaines · 45&nbsp;min</div>
        </div>
      </div>

      <ul class={itemListe}>
        {recurrence.map((i) => (
          <li class={itemRow}>
            <p class="text-lg leading-relaxed text-ink-2">
              <strong class="font-medium text-foreground">{i.titre}</strong>{" "}
              {i.texte}
            </p>
          </li>
        ))}
      </ul>

      <!-- Emphase maximale de la page : c'est la clause qui rend le délai tenable. -->
      <div class="mt-12 max-w-3xl rounded-2xl border border-lime bg-lime/[0.05] p-7">
        <h3 class="text-xl font-medium text-foreground">Une demande active à la fois.</h3>
        <p class="mt-3 text-lg leading-relaxed text-ink-2">
          Vous décidez de l'ordre des demandes. J'en traite une seule à la fois&nbsp;: je la livre
          en 48 à 72&nbsp;heures, puis j'attaque la suivante. C'est ce qui me permet de tenir ce
          délai — et c'est exactement la règle qui manque aux offres &laquo;&nbsp;demandes
          illimitées&nbsp;&raquo; qui livrent en trois semaines.
        </p>
      </div>
    </div>

    <p class="mt-10 max-w-2xl font-serif text-xl italic text-ink-2">
      Ce format vaut jusqu'à trente salariés. Au-delà, il y a plus de services à équiper&nbsp;:
      je fais un devis.
    </p>
  </div>
</section>
