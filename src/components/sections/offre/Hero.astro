---
/**
 * Hero de la page d'offre — fond papier, contenu centré.
 *
 * Le soulignement tracé à la main a été retiré (jugé « cheap » par Julien) :
 * l'accent passe par la convention maison — une chute en Instrument Serif
 * italique violet, exactement comme les H2 de toutes les autres sections.
 * Rien à inventer, c'est déjà la signature du site.
 */
import Nav from "@/components/Nav.astro";
import CtaButton from "@/components/CtaButton.astro";

// Les montants en serif italique : c'est la forme des prix partout sur le site
// (voir Prix.astro). font-normal neutralise le 700 de <strong>.
const montant = "font-serif text-[1.15em] font-normal italic text-foreground";
---

<section id="hero" class="relative overflow-hidden px-6 pb-14 pt-28 md:px-12 md:pb-16 md:pt-32">
  <!-- Halo violet très basse intensité, recentré sous le titre. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    style="background: radial-gradient(760px 420px at 50% 0%, rgba(108,76,241,0.09), transparent 70%);"
  >
  </div>

  <Nav home />

  <div class="mx-auto max-w-4xl text-center">
    <p class="mb-6 text-[11px] uppercase tracking-[0.22em] text-lime">
      Marketing externalisé · PME de 10 à 30 salariés
    </p>

    <h1
      class="mx-auto max-w-[20ch] text-[clamp(2.5rem,6vw,4.5rem)] font-medium leading-[1.05] tracking-[-0.03em] text-foreground"
    >
      Je rejoins votre équipe.
      <br />
      Pas votre <em class="text-lime">liste de prestataires.</em>
    </h1>

    <p class="mx-auto mt-8 max-w-2xl text-xl leading-relaxed text-ink-2">
      Un mois pour remettre à plat ce que vous vendez et comment vous le dites. Puis chaque
      semaine&nbsp;: le site, les supports de vos commerciaux, les relances, les publications —
      et vos équipes outillées pour aller plus vite.
    </p>

    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">
      <strong class={montant}>4&nbsp;000&nbsp;€</strong> le premier mois, tout compris. Puis{" "}
      <strong class={montant}>2&nbsp;500&nbsp;€</strong> par mois, sans engagement.
    </p>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
      <CtaButton>Réserver 20&nbsp;minutes</CtaButton>
      <button
        type="button"
        data-open-diagnostic
        class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-line px-6 py-3.5 text-base text-ink-2 transition-colors hover:border-lime hover:text-lime"
      >
        Faire le point en 2&nbsp;minutes
      </button>
    </div>
  </div>
</section>
