---
/**
 * Deux cas clients réels.
 *
 * Version précédente : eyebrow « Le travail », titre « Ce qui tient dans la
 * durée », et deux récits introduits par un simple label sectoriel. Julien :
 * « on ne comprend pas qu'il s'agit de cas clients réels ». Corrigé en le
 * disant — le mot « client », la durée en clair, et une phrase qui explique
 * pourquoi il n'y a pas de nom (sans quoi l'anonymat se lit comme du flou).
 *
 * La phrase « C'est le seul juge que j'accepte » est retirée : Julien l'a
 * citée lui-même comme exemple de formule sibylline.
 *
 * Toujours aucune métrique inventée. Le jour où Julien en a une de vérifiable,
 * elle vient ici — pas de placeholder en attendant.
 */
import Eyebrow from "@/components/Eyebrow.astro";

const clients = [
  {
    secteur: "Un éditeur et organisme de formation, secteur santé",
    duree: "Client depuis quatre ans",
    recit:
      "Sans contrat annuel ni engagement : chaque mois, il décide de continuer, et chaque mois il continue. C'est la preuve la plus solide que je puisse montrer.",
  },
  {
    secteur: "Un groupe immobilier",
    duree: "Client depuis deux ans",
    recit:
      "J'y ai lancé deux marques à partir de rien : ce qu'elles vendent et à qui, leur identité, leur site, leurs contenus et leurs outils. Au même rythme hebdomadaire que celui décrit plus haut.",
  },
];
---

<section id="travail" class="border-t border-line px-6 py-12 md:px-12 md:py-16">
  <div class="mx-auto max-w-7xl">
    <Eyebrow>Mes clients</Eyebrow>
    <h2 class="max-w-4xl text-[clamp(2rem,4.5vw,3.5rem)] font-normal leading-[1.05] tracking-[-0.03em] text-foreground">
      Deux clients.
      <br />
      <em class="text-lime">Quatre ans pour l'un, deux pour l'autre.</em>
    </h2>

    <p class="mt-6 max-w-2xl text-xl leading-relaxed text-ink-2">
      Deux entreprises qui travaillent avec moi aujourd'hui. Je les désigne par leur secteur&nbsp;;
      voici ce que j'y fais, et depuis quand.
    </p>

    <div class="mt-12 max-w-3xl">
      {clients.map((c) => (
        <article class="border-t border-line py-8 last:border-b">
          <div class="text-[11px] uppercase tracking-[0.22em] text-ink-3">{c.secteur}</div>
          <div class="mt-3 text-xl font-medium text-foreground">{c.duree}</div>
          <p class="mt-3 text-xl leading-relaxed text-ink-2">{c.recit}</p>
        </article>
      ))}
    </div>
  </div>
</section>
