---
import Eyebrow from "@/components/Eyebrow.astro";
import CtaButton from "@/components/CtaButton.astro";

const cardBase = "relative flex flex-col rounded-2xl border bg-card p-7 transition-all";
const cardDefault = "border-line hover:-translate-y-0.5 hover:border-ink-3/40 hover:shadow-[0_16px_36px_-18px_rgba(24,20,60,0.16)]";
const cardFeatured = "border-lime bg-lime/[0.05] hover:-translate-y-0.5";

const offres = [
  {
    tag: "JUSQU'À 10 SALARIÉS",
    name: "TPE Augmentée",
    prix: "8 000 €",
    detail: "4 à 6 semaines · 3 à 5 assistants IA",
    note: null,
    featured: false,
  },
  {
    tag: "JUSQU'À 30 SALARIÉS",
    name: "PME Augmentée",
    prix: "15 000 €",
    detail: "6 à 8 semaines · 5 à 7 assistants IA",
    note: "Pour l'entreprise dont 5 à 15 personnes produisent du document au quotidien. Dix personnes qui récupèrent 5 à 10 heures par semaine : l'équivalent d'un à deux temps pleins que vous ne recruterez pas.",
    featured: true,
  },
  {
    tag: "JUSQU'À 80 SALARIÉS",
    name: "PME Augmentée +",
    prix: "32 000 €",
    detail: "8 semaines · 7 à 10 assistants IA · coordination managériale et gouvernance",
    note: null,
    featured: false,
  },
];
---

<section id="offres" class="border-t border-line px-6 py-24 md:px-12 md:py-32">
  <div class="mx-auto max-w-7xl">
    <Eyebrow>Les offres</Eyebrow>
    <h2 class="max-w-4xl text-[clamp(2rem,4.5vw,3.5rem)] font-light leading-[1.05] tracking-[-0.03em] text-foreground">
      Un audit pour décider.
      <br />
      <em class="text-lime">Trois missions pour installer.</em>
    </h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">
      L'audit vaut pour lui-même : vous repartez avec de quoi arbitrer, même si vous n'installez
      rien avec moi.
    </p>

    <!--
      L'audit n'est pas une remise sur la mission : c'est l'offre d'entrée, et elle doit tenir
      debout seule. D'où le bloc développé (promesse, livrables, preuve) plutôt qu'un encart —
      la déduction n'arrive qu'en dernier, en note.
    -->
    <div class="mt-14 rounded-2xl border border-lime/40 bg-card p-7 md:p-10">
      <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] md:gap-14">
        <div>
          <div class="text-[11px] uppercase tracking-[0.22em] text-lime">L'offre d'entrée</div>
          <h3 class="mt-4 text-2xl font-medium text-foreground">L'audit</h3>
          <div class="mt-5 font-serif text-5xl italic tracking-tight text-lime">1 500 €</div>

          <p class="mt-7 text-lg leading-relaxed text-foreground">
            Savoir où l'IA vous fera gagner du temps. Avant d'en dépenser.
          </p>
          <p class="mt-4 text-base leading-relaxed text-ink-2">
            Le risque n'est pas de rater l'IA. C'est d'acheter des licences et de constater six mois
            plus tard que rien n'a bougé dans la production.
          </p>
          <p class="mt-4 text-base leading-relaxed text-ink-2">
            J'interroge individuellement ceux qui produisent — pas la direction seule. Chaque
            friction relevée est tranchée : ce que l'IA peut exécuter, ce qui doit rester au
            jugement humain.
          </p>
        </div>

        <div>
          <div class="text-xs uppercase tracking-wider text-ink-3">Ce qui vous reste</div>
          <div class="mt-5 space-y-4">
            <div class="rounded-xl border border-line bg-background p-5">
              <h4 class="text-base font-medium text-foreground">Le diagnostic</h4>
              <p class="mt-2 text-sm leading-relaxed text-ink-2">
                Vos frictions cartographiées poste par poste, et vos cas d'usage classés par effort
                et par impact. Une feuille de route séquencée — pas une liste de courses.
              </p>
            </div>
            <div class="rounded-xl border border-line bg-background p-5">
              <h4 class="text-base font-medium text-foreground">L'outil de pilotage</h4>
              <p class="mt-2 text-sm leading-relaxed text-ink-2">
                Dix onglets pour suivre l'exécution dans la durée. Il sert encore longtemps après la
                fin de la mission.
              </p>
            </div>
          </div>

          <p class="mt-5 text-sm leading-relaxed text-ink-2">
            <em class="not-italic font-medium text-foreground">Ces deux outils sont à vous.</em> Ils
            servent que vous installiez avec moi, avec un autre, ou avec personne.
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-5">
            <a
              href="/realisations/cartographie-ia-agence"
              class="group inline-flex items-center gap-2 text-sm text-lime"
            >
              Voir un audit réel
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </a>
            <span class="text-sm text-ink-3">
              Déduit de la mission si elle démarre sous 30 jours.
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-20 border-t border-line pt-14">
      <h3 class="text-2xl font-medium text-foreground">Une fois que vous savez où agir</h3>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-2">
        Trois missions, un seul critère : votre effectif. Un prix ferme, un délai contractualisé, le
        déploiement commence en semaine 3.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {offres.map((o) => (
        <div class={`${cardBase} ${o.featured ? cardFeatured : cardDefault}`}>
          {o.featured && (
            <div class="absolute -top-3 left-7 rounded-full bg-lime px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-white">
              Offre de référence
            </div>
          )}
          <div class="text-[11px] uppercase tracking-[0.22em] text-ink-3">{o.tag}</div>
          <div class="mt-4 text-xl font-medium text-foreground">{o.name}</div>
          <div class="mt-6">
            <div class={`font-serif text-4xl italic tracking-tight ${o.featured ? "text-lime" : "text-foreground"}`}>{o.prix}</div>
          </div>
          <div class="mt-2 text-xs text-ink-2">{o.detail}</div>
          {o.note && (
            <p class="mt-6 flex-1 border-t border-line pt-6 text-sm leading-relaxed text-ink-2">{o.note}</p>
          )}
        </div>
      ))}
    </div>

    <div class="mt-12">
      <CtaButton>Vérifier que c'est fait pour vous — 30 minutes</CtaButton>
    </div>
  </div>
</section>
