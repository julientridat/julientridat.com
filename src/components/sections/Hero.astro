---
import { Image } from "astro:assets";
import Nav from "@/components/Nav.astro";
import heroImg from "@/assets/hero.jpg";
---

<section class="relative isolate min-h-screen overflow-hidden bg-background">
  <Image
    src={heroImg}
    alt=""
    aria-hidden="true"
    widths={[768, 1280, 1920, 2688]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-black/55"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/60 via-black/30 to-black/85"></div>

  <Nav home onDark />

  <div class="relative mx-auto flex min-h-screen max-w-7xl flex-col justify-center px-6 pb-10 pt-32 md:px-12 md:pb-14 md:pt-40">
    <h1 class="max-w-[1100px] text-[clamp(3rem,9vw,8rem)] font-light leading-[0.95] tracking-[-0.04em] text-white">
      <span class="block">J'installe l'IA <em class="font-normal text-violet-soft">dans vos outils.</em></span>
      <span class="block">En <em class="font-normal text-violet-soft">2 mois.</em> Pas en 2 ans.</span>
    </h1>

    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-white/80">
      Pour les entreprises de services de 10 à 40 salariés dont les équipes produisent devis,
      rapports, propositions, dossiers — et qui n'arrivent plus à recruter.
    </p>

    <div class="mt-12 md:mt-14">
      <button
        type="button"
        data-open-booking
        aria-label="Vérifier que l'offre de Julien Tridat est faite pour votre entreprise — 30 minutes"
        class="group relative inline-flex cursor-pointer items-center gap-4 rounded-full bg-lime px-3 py-3 pr-8 text-[17px] font-medium text-white shadow-[0_0_60px_-15px_rgba(108,76,241,0.65)] transition-all hover:-translate-y-0.5 hover:bg-lime/90"
      >
        <span class="grid h-11 w-11 place-items-center rounded-full bg-black/25 text-white transition-transform group-hover:translate-x-0.5">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </span>
        Vérifier que c'est fait pour vous — 30 minutes
      </button>
      <p class="mt-4 max-w-md text-sm text-white/65">
        Pas un pitch. Je vous dis si mon offre colle à votre contexte. Sinon, je vous oriente.
      </p>
    </div>
  </div>
</section>
