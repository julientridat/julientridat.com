---
import Eyebrow from "@/components/Eyebrow.astro";

const stages = [
  {
    num: "01",
    week: "Audit terrain",
    title: "Les vraies journées de ceux qui produisent.",
    desc: "J'observe les vraies journées de ceux qui produisent. Relevé des tâches à forte répétition et faible valeur — pas un diagnostic théorique.",
  },
  {
    num: "02",
    week: "Construction des assistants",
    title: "Directement dans vos outils.",
    desc: "Bâtis directement dans vos outils — Microsoft 365, Google Workspace, Notion. Calibrés sur vos métiers, votre charte, vos données.",
  },
  {
    num: "03",
    week: "Déploiement par vague",
    title: "En production dès la semaine 3.",
    desc: "Les premiers assistants tournent en production dès la semaine 3. Vos équipes gagnent avant la fin du projet.",
  },
  {
    num: "04",
    week: "Formation métier",
    title: "Vos équipes deviennent autonomes.",
    desc: "2 à 3 demi-journées. Pas de théorie IA — vos cas réels, vos documents, vos clients.",
  },
];
---

<section id="methode" class="border-t border-line px-6 py-24 md:px-12 md:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 md:grid-cols-2 md:items-end">
      <div>
        <Eyebrow>La méthode</Eyebrow>
        <h2 class="text-[clamp(2rem,4.5vw,3.5rem)] font-light leading-[1.05] tracking-[-0.03em] text-foreground">
          4 étapes.
          <br />
          <em class="text-lime">Un système qui tourne dès la semaine 3.</em>
        </h2>
      </div>
      <p class="max-w-md text-lg leading-relaxed text-ink-2">
        Un cadre simple, testé auprès de 300+ dirigeants et cadres.{" "}
        <strong class="font-medium text-foreground">
          On installe, on construit, on déploie, on forme.
        </strong>
      </p>
    </div>

    <div class="relative mt-20">
      <div class="absolute left-0 right-0 top-6 hidden h-px bg-line md:block"></div>
      <div class="grid gap-12 md:grid-cols-4">
        {stages.map((s) => (
          <div class="relative">
            <div class="mb-6 hidden h-3 w-3 rounded-full bg-lime md:-mt-7 md:block"></div>
            <div class="text-xs uppercase tracking-[0.22em] text-lime">{s.num}</div>
            <div class="mt-2 text-sm text-ink-3">{s.week}</div>
            <h3 class="mt-4 text-xl font-medium leading-snug text-foreground">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-2">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-20 border-t border-line pt-10">
      <p class="max-w-2xl text-lg leading-relaxed text-ink-2">
        <strong class="font-medium text-foreground">Vos équipes gardent leurs outils.</strong>{" "}
        <strong class="font-medium text-foreground">Vos données restent chez vous.</strong>
      </p>
    </div>
  </div>
</section>
