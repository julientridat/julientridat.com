---
import { Image } from "astro:assets";
import Eyebrow from "@/components/Eyebrow.astro";
import julien from "@/assets/julien.jpg";
---

<section id="about" class="border-t border-line px-6 py-24 md:px-12 md:py-32">
  <div class="mx-auto grid max-w-7xl gap-16 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
    <div>
      <div class="overflow-hidden rounded-2xl border border-line">
        <Image src={julien} alt="Julien Tridat" widths={[400, 600]} sizes="(min-width: 768px) 40vw, 100vw" class="h-full w-full object-cover" />
      </div>
      <div class="mt-4 flex items-baseline justify-between text-sm">
        <span class="font-medium text-foreground">Julien Tridat</span>
        <span class="text-ink-3">Bordeaux — FR</span>
      </div>
    </div>

    <div>
      <Eyebrow>Qui installe ça chez vous</Eyebrow>
      <h2 class="text-[clamp(1.8rem,3.6vw,2.8rem)] font-light leading-tight tracking-[-0.02em] text-foreground">
        Julien Tridat
      </h2>

      <div class="mt-8 space-y-5 text-base leading-relaxed text-ink-2">
        <p>
          20 ans en marketing, communication et accompagnement de la croissance. 3 ans sur l'IA.
        </p>
        <p>
          Je ne laisse pas mes clients avec un PDF et de la motivation. Je construis les
          assistants IA dont leurs équipes ont besoin, je les déploie dans leurs outils, et je les
          forme à les utiliser. <em class="text-lime">Ce que je livre tourne encore 6 mois plus tard.</em>
        </p>
      </div>

      <div class="mt-10 grid gap-8 border-t border-line pt-8 sm:grid-cols-2">
        <div>
          <div class="font-serif text-5xl italic text-foreground">300+</div>
          <div class="mt-2 max-w-[10rem] text-xs uppercase tracking-wider text-ink-2">
            dirigeants et cadres formés
          </div>
        </div>
        <div>
          <div class="font-serif text-5xl italic text-foreground">50+</div>
          <div class="mt-2 max-w-[10rem] text-xs uppercase tracking-wider text-ink-2">
            organisations accompagnées
          </div>
        </div>
      </div>

      <div class="mt-8 space-y-5 border-t border-line pt-8 text-sm">
        <div>
          <div class="text-xs uppercase tracking-wider text-ink-3">Ils m'ont fait confiance</div>
          <div class="mt-2 flex flex-wrap gap-x-2 gap-y-2">
            {["Dassault Systèmes", "SNCF Fret", "Maison Chapoutier", "Cogefi", "Asqua BTP", "Bordeaux Négoce"].map((c) => (
              <span class="rounded-full border border-line px-3 py-1 text-xs text-ink-2">{c}</span>
            ))}
          </div>
        </div>
        <div>
          <div class="text-xs uppercase tracking-wider text-ink-3">Basé à</div>
          <div class="mt-1 text-ink-2"><strong class="font-medium text-foreground">Bordeaux</strong> — Grand Sud-Ouest et national</div>
        </div>
      </div>
    </div>
  </div>
</section>
