---
/**
 * Page d'accueil — offre de direction marketing externalisée.
 *
 * Remplace, depuis le 2026-08-29, l'ancienne home « J'installe l'IA dans vos
 * outils. En 2 mois. » (archivée, hors index, dans /installation-ia).
 *
 * Septembre 2026 : ramenée de 11 à 7 blocs sur le modèle de designjoy.co —
 * hero, comment ça marche, avantages, qui, prix, questions, clôture. Les autres
 * offres restent dans la nav et le pied de page.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/offre/Hero.astro";
import Fonctionnement from "@/components/sections/offre/Fonctionnement.astro";
import Avantages from "@/components/sections/offre/Avantages.astro";
import Bio from "@/components/sections/offre/Bio.astro";
import Prix from "@/components/sections/offre/Prix.astro";
import Faq from "@/components/sections/offre/Faq.astro";
import FinalCta from "@/components/sections/offre/FinalCta.astro";
import Footer from "@/components/Footer.astro";
import Reveal from "@/components/Reveal.astro";
import { SITE } from "@/lib/site";
import { FAQ_ACCUEIL } from "@/lib/faqAccueil";

// Moins de 60 caractères : au-delà, Google coupe le titre, ou le remplace
// par un texte de son choix pris dans la page. Les montants sont dans la
// description, où ils ont la place.
const title = "Direction marketing externalisée pour PME | Julien Tridat";
const description =
  "2 500 € par mois, starter pack compris : audit, plan marketing sur douze mois, positionnement, charte. Puis un livrable chaque semaine. Sans engagement.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": `${SITE.url}/#service`,
    name: "Direction marketing externalisée — abonnement, starter pack compris",
    description:
      "Abonnement mensuel sans engagement. Le premier mois est un starter pack : état des lieux (semaine 1), plan marketing sur douze mois avec les trois premiers mois détaillés et plan d'action validé (semaine 2), positionnement et charte (semaine 3), gabarits et premier livrable (semaine 4). Ensuite, un livrable à date chaque semaine selon le plan d'action, un point hebdomadaire de 45 minutes, et des demandes supplémentaires livrées de J+1 à J+3. Pour PME jusqu'à 30 salariés, sans équipe marketing interne.",
    provider: { "@id": `${SITE.url}/#julien-tridat` },
    areaServed: "FR",
    url: `${SITE.url}/`,
    makesOffer: [
      {
        "@type": "Offer",
        name: "Abonnement mensuel — quatre places",
        price: "2500",
        priceCurrency: "EUR",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "2500",
          priceCurrency: "EUR",
          unitText: "mois",
          valueAddedTaxIncluded: false,
        },
        description:
          "2 500 € HT par mois dès le premier mois, starter pack compris. Un livrable à date chaque semaine selon le plan d'action, point hebdomadaire de 45 minutes, demandes supplémentaires livrées de J+1 à J+3 sans engagement de volume. Sans engagement de durée, résiliable à tout moment. Pause possible après le starter pack : les semaines payées et non utilisées sont conservées six mois et la place est gardée. Le client conserve tous les livrables — contenus, charte, gabarits, fichiers sources — y compris après résiliation ; les agents IA utilisés pour produire restent la propriété du prestataire.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ_ACCUEIL.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.r },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={`${SITE.url}/`} jsonLd={jsonLd}>
  <main class="bg-background text-foreground">
    <Hero />
    <Fonctionnement />
    <Avantages />
    <Bio />
    <Prix />
    <Faq />
    <FinalCta />
    <Footer home />
  </main>
  <Reveal />
</BaseLayout>

