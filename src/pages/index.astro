---
/**
 * Accueil — intégration IA pour TPE et PME.
 *
 * Refonte de la copy du 12/11/2026 : le site ne vend plus « des agents IA », il vend
 * la compréhension de l'entreprise et de ses métiers, puis des processus que l'IA
 * exécute et que l'équipe valide. Règles de vocabulaire : « processus IA » ou
 * « outils IA métier » ; « agent IA » seulement dans la FAQ, en registre explicatif.
 * Charte « planning » (src/styles/vitrine.css).
 *
 * Champs prévus mais vides (non affichés tant qu'ils le restent) : voir TODO-site.md.
 *   - metiers[].processus, metiers[].gain ;
 *   - cas[].mesure, cas[].temoignage ;
 *   - faq[].confirme === false : question masquée en attendant la confirmation de Julien.
 * Tous les prix sont hors taxes : Julien est assujetti à la TVA (Julien, 11/11/2026).
 */
import { Image } from "astro:assets";
import VitrineLayout from "@/layouts/VitrineLayout.astro";
import { SITE } from "@/lib/site";
import portrait from "@/assets/julien-portrait.jpg";

const title = "Intégration IA pour TPE et PME à Bordeaux | Julien Tridat";
const description =
  "Comprendre votre entreprise avant d'installer l'IA : vos tâches répétitives deviennent des processus IA que votre équipe valide. Diagnostic de 90 min.";

// Les quatre livrables du diagnostic. Le kit est remis sous 48 h (Julien, 09/11/2026).
const livrables = [
  { quand: "En séance", titre: "La cartographie", texte: "Vos 3 à 5 processus les plus chronophages.", differe: false },
  { quand: "En séance", titre: "Le chiffrage", texte: "Les heures gagnées par semaine et par collaborateur.", differe: false },
  { quand: "En séance", titre: "La feuille de route", texte: "Votre feuille de route en 3 étapes.", differe: false },
  { quand: "Sous 48 h", titre: "Votre kit de lancement", texte: "De quoi lancer vos 3 premiers processus, avec la règle d'usage qui les encadre.", differe: true },
];

const methode = [
  {
    titre: "Je pars de votre métier",
    texte: "J'observe et j'écoute ceux qui font le travail. Ce sont eux qui savent où le temps se perd, et ce sont eux qui définissent ce que l'IA prend en charge.",
  },
  {
    titre: "Un cadre commun",
    texte: "Une règle d'usage partagée : quels outils, quelles données, qui valide quoi. Fini les usages dispersés.",
  },
];
const etapesTest = [
  "Je mesure le temps actuel.",
  "Je teste sur une dizaine de cas réels.",
  "Je note les résultats selon une grille définie avec vous.",
  "On ne déploie que ce qui tient la mesure.",
];

// Une carte par secteur. `processus` et `gain` : non affichés tant qu'ils sont vides
// (TODO-site.md). Ne les remplir qu'avec un processus construit et un gain mesuré.
type Metier = { secteur: string; processus?: string; gain?: string };
const metiers: Metier[] = [
  { secteur: "Agences" },
  { secteur: "Négociants" },
  { secteur: "Conseillers en gestion de patrimoine" },
  { secteur: "Marques e-commerce" },
];

// Résultats mesurés. `mesure` (« Mesuré sur [volume, période] ») et `temoignage` :
// non affichés tant qu'ils sont vides (TODO-site.md).
type Cas = {
  secteur: string;
  tache: string;
  avantLabel: string;
  avant: string;
  apres: string;
  texte: string;
  mesure?: string;
  temoignage?: { citation: string; nom: string; fonction: string; entreprise: string };
};
const cas: Cas[] = [
  {
    secteur: "Courtier en assurance BTP · Gironde",
    tache: "Synthèse et contrôle des dossiers chantier",
    avantLabel: "Avant",
    avant: "2 à 3 jours",
    apres: "Moins de 2 h",
    texte: "Synthétiser les dizaines de documents d'un dossier chantier, traquer les coquilles, chiffrer le contrat. Une tâche quasi quotidienne. Un outil IA pensé pour son métier la ramène à moins de 2 heures.",
  },
  {
    secteur: "Carrossier · Grand Sud-Ouest",
    tache: "Devis et facture par dictée",
    avantLabel: "Avant",
    avant: "1 h 30 à 2 h",
    apres: "8 à 12 min",
    texte: "Après sa journée d'atelier, il passait ses soirées sur l'évaluation, le devis et la facture. Il dicte désormais en faisant le tour du véhicule, photos à l'appui. Le devis sort avant qu'il ait raccroché.",
  },
  {
    secteur: "Centre de formation",
    tache: "Conception de parcours et supports",
    avantLabel: "Avant, par module",
    avant: "3 à 4 jours",
    apres: "4 à 6 h",
    texte: "Concevoir un parcours et ses supports prenait plusieurs journées. Les formatrices ont récupéré ce temps. Elles créent désormais le e-learning qu'elles n'avaient jamais eu le temps de lancer.",
  },
];

// Liste et format repris de l'ancienne section « Qui je suis » (texte, pas de logos).
const references = ["Dassault Systèmes", "SNCF Fret", "Lagardère Travel Retail", "Le Nouveau Bélier", "Maison des Vins et des Spiritueux"];

const offres = [
  { nom: "Dirigeant augmenté", utilisateurs: "1", duree: "1 semaine", prix: 2500 },
  { nom: "TPE augmentée", utilisateurs: "Jusqu'à 10", duree: "2 à 4 semaines", prix: 5000 },
  { nom: "PME augmentée", utilisateurs: "Jusqu'à 30", duree: "4 à 8 semaines", prix: 12000 },
  { nom: "PME augmentée +", utilisateurs: "Jusqu'à 80", duree: "8 à 12 semaines", prix: 25000 },
];
const inclus = [
  "Immersion et ateliers avec vos équipes",
  "Processus IA branchés sur vos outils",
  "Règle d'usage IA de l'entreprise",
  "Rapport de mesure avant/après",
  "Formation des utilisateurs",
];
const euros = (n: number) => `${n.toLocaleString("fr-FR").replace(/ |\s/g, " ")} €`;

// FAQ. `html` : réponse affichée (liens) ; `texte` : version brute pour le balisage FAQPage.
// `confirme: false` : question masquée en attendant la confirmation de Julien (TODO-site.md).
const SOURCE_ANTHROPIC = "https://www.anthropic.com/engineering/building-effective-agents";
const faq = [
  {
    q: "Qu'est-ce qu'un agent IA ?",
    texte: "Un modèle d'IA qui poursuit un objectif en choisissant lui-même ses actions : il utilise vos outils, observe les résultats et décide de l'étape suivante.",
    confirme: true,
  },
  {
    q: "Pourquoi ne vendez-vous pas « des agents » ?",
    texte:
      "Multiplier les agents ajoute du coût, de la lenteur et des pertes d'information. Même Anthropic, l'éditeur de Claude, recommande de commencer par la solution la plus simple et de n'ajouter des agents que lorsqu'elle ne suffit pas. Je vous livre des processus qui fonctionnent, pas un organigramme de robots.",
    html: `Multiplier les agents ajoute du coût, de la lenteur et des pertes d'information. Même Anthropic, l'éditeur de Claude, <a href="${SOURCE_ANTHROPIC}" rel="noopener">recommande de commencer par la solution la plus simple</a> et de n'ajouter des agents que lorsqu'elle ne suffit pas. Je vous livre des processus qui fonctionnent, pas un organigramme de robots.`,
    confirme: true,
  },
  {
    q: "Faut-il changer nos outils ?",
    texte: "Non. L'IA se branche sur ceux que vous utilisez déjà.",
    confirme: false,
  },
  {
    q: "Et si mon équipe résiste ?",
    texte: "C'est pour cela que je pars de son travail. On adopte ce qu'on a contribué à construire.",
    confirme: true,
  },
  {
    q: "Je cherche seulement une formation.",
    texte: `La formation à l'IA générative de vos équipes a sa page : ${SITE.url}/formation-ia`,
    html: `La formation à l'IA générative de vos équipes a sa page. <a href="/formation-ia" class="v-fort">Voir la page Formation →</a>`,
    confirme: true,
  },
].filter((f) => f.confirme);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": `${SITE.url}/#service`,
    name: "Intégration IA pour TPE et PME",
    description:
      "Comprendre l'entreprise et ses métiers, puis transformer les tâches répétitives en processus que l'IA exécute et que l'équipe valide. Formation des équipes, règle d'usage, mesure avant/après. Porte d'entrée : un diagnostic de 90 minutes. Bordeaux, partout en France.",
    provider: { "@id": `${SITE.url}/#julien-tridat` },
    // Signaux locaux (SEO Bordeaux, 11/11/2026) : la ville et sa métropole d'abord,
    // puis le reste de la France. Pas d'adresse de rue : le service se déplace.
    address: {
      "@type": "PostalAddress",
      addressLocality: "Bordeaux",
      postalCode: "33000",
      addressRegion: "Nouvelle-Aquitaine",
      addressCountry: "FR",
    },
    areaServed: [
      { "@type": "City", name: "Bordeaux" },
      { "@type": "AdministrativeArea", name: "Bordeaux Métropole" },
      { "@type": "AdministrativeArea", name: "Gironde" },
      { "@type": "Country", name: "France" },
    ],
    priceRange: "390 € – 25 000 € HT",
    knowsAbout: ["Intelligence artificielle générative", "Processus IA", "Automatisation des processus", "Formation à l'IA"],
    url: `${SITE.url}/`,
    makesOffer: [
      {
        "@type": "Offer",
        name: "Diagnostic IA — 90 minutes",
        price: "390",
        priceCurrency: "EUR",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "390",
          priceCurrency: "EUR",
          valueAddedTaxIncluded: false,
        },
        description:
          "Quatre livrables : cartographie des 3 à 5 processus les plus chronophages, chiffrage des heures gagnées par semaine et par collaborateur, feuille de route en 3 étapes, et sous 48 h un kit pour lancer ses 3 premiers processus avec la règle d'usage qui les encadre. Satisfait ou remboursé. Déductible de l'intégration si elle est lancée sous 30 jours.",
      },
      ...offres.map((o) => ({
        "@type": "Offer",
        name: o.nom,
        price: String(o.prix),
        priceCurrency: "EUR",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: String(o.prix),
          priceCurrency: "EUR",
          valueAddedTaxIncluded: false,
        },
        description: `${o.utilisateurs} utilisateur(s) formé(s) · ${o.duree.replace(" ", " ")}.`,
      })),
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    inLanguage: "fr-FR",
    publisher: { "@id": `${SITE.url}/#julien-tridat` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q.replace(/ /g, " "),
      acceptedAnswer: { "@type": "Answer", text: f.texte },
    })),
  },
];
---

<VitrineLayout title={title} description={description} canonical={`${SITE.url}/`} jsonLd={jsonLd} actif="accueil" cta="diagnostic">
  <section id="accueil" class="v-section v-section--premiere">
    <div class="v-hero v-pile" style="gap: 32px;">
      <p class="v-label">Intégration IA pour TPE et PME · Bordeaux et toute la France</p>
      <h1 class="v-h1" style="text-wrap: balance;">
        Installer l'IA, c'est la partie&nbsp;facile.<br />
        <span class="v-vert">Comprendre votre entreprise, c'est mon&nbsp;métier.</span>
      </h1>
      <div class="v-pile" style="max-width: 64ch;">
        <p class="v-chapo">
          Agence, négociant, conseiller en gestion de patrimoine, marque e-commerce&nbsp;: je comprends comment vous
          travaillez, puis je transforme vos tâches répétitives en processus que l'IA exécute et que votre équipe valide.
        </p>
        <div class="v-pile v-pile--serree" style="align-items: flex-start; gap: 8px;">
          <button type="button" class="v-bouton" data-open-booking="diagnostic">
            Réserver le diagnostic →<span class="v-surligne">90&nbsp;min</span>
          </button>
          <p class="v-petit">390&nbsp;€&nbsp;HT · <span class="v-fort" style="color: var(--v-vert);">satisfait ou remboursé</span> · <a href="#offres" style="color: inherit;">déductible de l'intégration</a> si vous la lancez sous 30&nbsp;jours</p>
          <button type="button" class="v-lien-action" style="font-size: 18px; padding: 4px 0;" data-open-rappel>Une question avant&nbsp;? →</button>
        </div>
      </div>
    </div>
  </section>

  <section id="constat" class="v-section">
    <p class="v-label">Le constat</p>
    <h2 class="v-h2">Votre problème n'est pas technique.</h2>
    <p class="v-chapo">
      Les outils d'IA sont là, accessibles à tous. Vos collaborateurs les utilisent probablement déjà, chacun à sa façon.
      Ce qui manque, c'est quelqu'un qui regarde comment votre entreprise fonctionne vraiment&nbsp;: où le temps se perd, ce
      qui relève du savoir-faire, ce qui peut être confié à l'IA. <span class="v-fort">C'est ce travail-là qui détermine le
      résultat. La technique vient après.</span>
    </p>
  </section>

  <section id="diagnostic" class="v-section">
    <p class="v-label">Le diagnostic</p>
    <h2 class="v-h2">Tout commence <span class="v-vert">par 90&nbsp;minutes.</span></h2>
    <p class="v-chapo">Vous me décrivez votre semaine. Je vous montre où l'IA vous fait gagner du temps, et combien cela vaut.</p>
    <p class="v-label" style="margin-top: 8px;">Vous repartez avec</p>
    <div class="v-grille" style="grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));">
      {livrables.map((l, i) => (
        <article class="v-carte v-carte--pad">
          <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px;">
            <span class="v-chiffre">{i + 1}</span>
            <span class:list={["v-label", { "v-vert": l.differe }]}>{l.quand}</span>
          </div>
          <h3 class="v-h3">{l.titre}</h3>
          <p>{l.texte}</p>
        </article>
      ))}
    </div>
    <div class="v-carte v-grille" style="padding: 22px; align-items: center; gap: 22px;">
      <div class="v-pile v-pile--serree" style="gap: 8px;">
        <p class="v-prix">390&nbsp;€&nbsp;HT</p>
        <p class="v-petit">90&nbsp;min · visio ou présentiel · <a href="#offres" style="color: inherit;">déductible de l'intégration</a> si vous la lancez sous 30&nbsp;jours</p>
        <p class="v-fort v-vert">Satisfait ou remboursé. <a href="/mentions-legales#conditions-diagnostic" class="v-petit" style="color: var(--v-encre); font-weight: 400;">Conditions</a></p>
      </div>
      <div class="v-pile v-pile--serree" style="gap: 4px; align-items: flex-start;">
        <button type="button" class="v-bouton v-bouton--petit" data-open-booking="diagnostic">
          Réserver →<span class="v-surligne">90&nbsp;min</span>
        </button>
        <button type="button" class="v-lien-action" style="font-size: 18px; padding: 4px 0;" data-open-rappel>Une question avant&nbsp;? →</button>
      </div>
    </div>
  </section>

  <section id="methode" class="v-section">
    <p class="v-label">Ma méthode</p>
    <h2 class="v-h2">Le terrain d'abord. <span class="v-vert">La technique ensuite.</span></h2>
    <div class="v-grille">
      {methode.map((m) => (
        <article class="v-carte v-carte--pad">
          <h3 class="v-h3">{m.titre}</h3>
          <p>{m.texte}</p>
        </article>
      ))}
      <article class="v-carte v-carte--pad">
        <h3 class="v-h3">Testé avant d'être déployé</h3>
        <p>Chaque processus est mesuré sur vos cas réels avant d'être mis en service&nbsp;:</p>
        <ol class="v-liste">
          {etapesTest.map((e, i) => (
            <li style="display: flex; gap: 12px; align-items: baseline;">
              <span class="v-chiffre" style="font-size: 22px;">{i + 1}</span>
              <span class:list={[{ "v-fort": i === etapesTest.length - 1 }]}>{e}</span>
            </li>
          ))}
        </ol>
      </article>
    </div>
  </section>

  <section id="metiers" class="v-section">
    <p class="v-label">Métiers</p>
    <h2 class="v-h2">Les métiers que j'accompagne</h2>
    <p class="v-chapo">Vos équipes repartent formées, avec leurs premiers outils IA en service.</p>
    <div class="v-grille" style="grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));">
      {metiers.map((m) => (
        <article class="v-carte" style="display: flex; flex-direction: column;">
          <h3 class="v-bandeau">{m.secteur}</h3>
          <div class="v-carte--pad" style="flex: 1;">
            <p>Formation des équipes et construction d'outils IA métier.</p>
            {m.processus && (
              <p><span class="v-label" style="display: block;">Processus construit</span>{m.processus}</p>
            )}
            {m.gain && (
              <p><span class="v-label" style="display: block;">Gain mesuré</span><span class="v-chiffre v-vert">{m.gain}</span></p>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="cas" class="v-section">
    <p class="v-label">Résultats</p>
    <h2 class="v-h2">Trois métiers, <span class="v-vert">trois résultats mesurés.</span></h2>
    <div class="v-grille">
      {cas.map((c) => (
        <article class="v-carte" style="display: flex; flex-direction: column;">
          <h3 class="v-bandeau">{c.secteur}</h3>
          <p class="v-fort" style="padding: 16px 22px 0;">{c.tache}</p>
          <div class="v-cols" style="grid-template-columns: repeat(2, minmax(0, 1fr)); border-bottom: 1px solid var(--v-grille);">
            <div class="v-ligne" style="border-bottom: 0;"><span class="v-label" style="display: block;">{c.avantLabel}</span><span class="v-chiffre">{c.avant}</span></div>
            <div class="v-ligne" style="border-bottom: 0; border-left: 1px solid var(--v-grille);"><span class="v-label" style="display: block;">Après</span><span class="v-chiffre v-vert">{c.apres}</span></div>
          </div>
          <p style="padding: 16px 22px 22px;">{c.texte}</p>
          {c.mesure && <p class="v-petit" style="padding: 0 22px 22px;">Mesuré sur {c.mesure}</p>}
          {c.temoignage && (
            <figure style="margin: 0; padding: 16px 22px 22px; border-top: 1px solid var(--v-grille);">
              <blockquote style="margin: 0;"><p>« {c.temoignage.citation} »</p></blockquote>
              <figcaption class="v-petit" style="margin-top: 8px;">
                <span class="v-fort" style="color: var(--v-encre);">{c.temoignage.nom}</span>, {c.temoignage.fonction}, {c.temoignage.entreprise}
              </figcaption>
            </figure>
          )}
        </article>
      ))}
    </div>
    <p class="v-petit">Les études de cas détaillées, en Gironde et dans le Sud-Ouest&nbsp;: <a href="/integration-ia-bordeaux#cas" class="v-fort">Intégration de l'IA à Bordeaux →</a></p>
  </section>

  <section id="references" class="v-section">
    <div class="v-carte v-carte--pad" style="gap: 16px;">
      <p class="v-label">Ils m'ont fait confiance</p>
      <h2 class="v-h2" style="max-width: none;">La rigueur des grands groupes, <span class="v-vert">au format et au prix d'une PME.</span></h2>
      <ul style="display: flex; flex-wrap: wrap; gap: 8px 28px;">
        {references.map((r) => <li class="v-h3" style="font-size: 22px;">{r}</li>)}
      </ul>
    </div>
  </section>

  <section id="offres" class="v-section">
    <p class="v-label">Offres</p>
    <h2 class="v-h2">Des délais et des prix <span class="v-vert">fixés à la signature.</span></h2>
    <div class="v-carte" style="overflow-x: auto;">
      <table class="v-tableau">
        <thead>
          <tr>
            <th scope="col">Offre</th>
            <th scope="col">Utilisateurs formés</th>
            <th scope="col">Durée</th>
            <th scope="col" class="v-droite">Prix HT</th>
          </tr>
        </thead>
        <tbody>
          {offres.map((o) => (
            <tr>
              <th scope="row" class="v-h3">{o.nom}</th>
              <td>{o.utilisateurs}</td>
              <td>{o.duree}</td>
              <td class="v-droite v-chiffre">{euros(o.prix)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="v-petit">Au-delà de 80&nbsp;utilisateurs&nbsp;: sur devis.</p>
    <div class="v-grille">
      <div class="v-carte v-carte--pad">
        <h3 class="v-h3">Inclus dans chaque formule</h3>
        <ul class="v-liste">
          {inclus.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="v-carte v-carte--pad">
        <h3 class="v-h3">Mon engagement</h3>
        <p class="v-texte">Vos premiers processus tournent pendant le projet. <span class="v-fort v-vert">Si je dérape sur le planning, je continue à mes frais.</span></p>
      </div>
    </div>
  </section>

  <section id="pilotage" class="v-section">
    <p class="v-label">Pilotage</p>
    <h2 class="v-h2">Après le déploiement, <span class="v-vert">je reste.</span></h2>
    <div class="v-carte v-grille" style="padding: 22px; align-items: center; gap: 22px;">
      <p class="v-texte">
        Les modèles d'IA et vos outils évoluent tous les mois. Un processus qui fonctionne aujourd'hui peut se dégrader
        demain. Le pilotage mensuel couvre trois choses&nbsp;: <span class="v-fort">retester vos processus, les mettre à jour, et
        suivre le gain réel.</span>
      </p>
      <div class="v-pile v-pile--serree" style="gap: 4px;">
        <p class="v-chiffre">De 300 à 1&nbsp;200&nbsp;€&nbsp;HT par mois</p>
        <p class="v-petit">selon la formule</p>
      </div>
    </div>
  </section>

  <section id="donnees" class="v-section">
    <p class="v-label">Vos données</p>
    <h2 class="v-h2">Vos données restent <span class="v-vert">sous contrôle.</span></h2>
    <ul class="v-carte">
      <li class="v-ligne">L'IA n'accède qu'aux outils et aux données nécessaires à chaque processus.</li>
      <li class="v-ligne">Aucun envoi ni aucune décision sans validation humaine.</li>
    </ul>
  </section>

  <section id="qui" class="v-section">
    <div class="v-bio">
      <div class="v-carte v-bio__photo" style="padding: 0; overflow: hidden;">
        <Image src={portrait} alt="Julien Tridat" widths={[280, 560]} sizes="280px" style="display: block; width: 100%; height: auto;" />
      </div>
      <div class="v-pile">
        <p class="v-label">Qui je suis</p>
        <h2 class="v-h2">20 ans à comprendre des métiers <span class="v-vert">avant de les transformer.</span></h2>
        <p class="v-texte">Publicité (Publicis, Saatchi &amp; Saatchi), production média (France&nbsp;24, Canal+, France&nbsp;2), puis conseil&nbsp;: j'ai passé ma carrière à entrer dans des entreprises très différentes et à comprendre vite comment elles fonctionnent.</p>
        <p class="v-texte"><span class="v-fort">J'ai accompagné plus de 300 dirigeants et cadres.</span> Je ne suis pas développeur. Je n'en ai pas besoin pour faire ce métier.</p>
        <p class="v-texte">Basé à Bordeaux, j'interviens partout en France.</p>
      </div>
    </div>
  </section>

  <section id="faq" class="v-section">
    <p class="v-label">Questions</p>
    <h2 class="v-h2">Questions fréquentes</h2>
    <div class="v-carte">
      {faq.map((f) => (
        <details class="v-ligne">
          <summary class="v-fort" style="cursor: pointer;">{f.q}</summary>
          {f.html ? <p style="margin-top: 8px;" set:html={f.html} /> : <p style="margin-top: 8px;">{f.texte}</p>}
        </details>
      ))}
    </div>
  </section>

  <section id="reserver" class="v-section v-section--fin">
    <div class="v-sombre v-grille v-grille--large" style="align-items: end;">
      <h2 class="v-h1" style="text-wrap: balance;">90&nbsp;minutes pour comprendre <span class="v-vert">ce que l'IA vaut chez vous.</span></h2>
      <div class="v-pile v-pile--serree" style="align-items: flex-start;">
        <button type="button" class="v-bouton v-bouton--inverse" data-open-booking="diagnostic">
          Réserver le diagnostic →<span class="v-surligne">90&nbsp;min</span>
        </button>
        <p class="v-petit">390&nbsp;€&nbsp;HT · satisfait ou remboursé · <a href="#offres" style="color: inherit;">déductible de l'intégration</a> si vous la lancez sous 30&nbsp;jours</p>
        <button type="button" class="v-lien-action" style="font-size: 18px; padding: 4px 0;" data-open-rappel>Une question avant&nbsp;? →</button>
      </div>
    </div>
  </section>
</VitrineLayout>
