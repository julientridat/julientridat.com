---
/**
 * Page d'accueil — offre de direction marketing externalisée.
 *
 * Remplace, depuis le 2026-08-29, l'ancienne home « J'installe l'IA dans vos
 * outils. En 2 mois. » (archivée, hors index, dans /installation-ia).
 *
 * Septembre 2026 : ramenée de 11 à 7 blocs sur le modèle de designjoy.co.
 * Copy du 29/09/2026 : neuf blocs — hero, problème, comment ça marche,
 * comparaison, preuves, qui, prix, questions, clôture — et un seul bouton,
 * « Réserver 20 minutes ». Les autres offres restent dans la nav et le pied
 * de page.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/offre/Hero.astro";
import Probleme from "@/components/sections/offre/Probleme.astro";
import Fonctionnement from "@/components/sections/offre/Fonctionnement.astro";
import Avantages from "@/components/sections/offre/Avantages.astro";
import Preuves from "@/components/sections/offre/Preuves.astro";
import Bio from "@/components/sections/offre/Bio.astro";
import Prix from "@/components/sections/offre/Prix.astro";
import Faq from "@/components/sections/offre/Faq.astro";
import FinalCta from "@/components/sections/offre/FinalCta.astro";
import Footer from "@/components/Footer.astro";
import Reveal from "@/components/Reveal.astro";
import { SITE } from "@/lib/site";
import { FAQ_ACCUEIL } from "@/lib/faqAccueil";
import { accueilBrut } from "@/lib/contenu";

// Mot-clé principal : « direction marketing externalisée », dans le title,
// la description, le H1 (surtitre du hero) et le sous-titre. Title et
// description sont repris tels quels en og: et twitter: par BaseLayout.
// Modifiables dans /admin (src/contenu/accueil.json, bloc seo).
const { title, description } = accueilBrut.seo;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": `${SITE.url}/#service`,
    name: "Direction marketing externalisée — abonnement mensuel, mois de démarrage compris",
    description:
      "Abonnement mensuel, trois mois minimum puis renouvelable chaque mois. Le premier mois est le mois de démarrage : état des lieux (semaine 1), plan sur douze mois avec les trois premiers mois détaillés et les actions du mois suivant validées (semaine 2), positionnement et charte (semaine 3), modèles et premier livrable (semaine 4). Ensuite, le plan mis en œuvre semaine après semaine, un livrable à date, un point hebdomadaire de 45 minutes, des demandes hors plan livrées entre J+1 et J+3, et un tableau de bord partagé. Pour PME jusqu'à 30 salariés, sans équipe marketing interne. Bordeaux et à distance.",
    provider: { "@id": `${SITE.url}/#julien-tridat` },
    areaServed: "FR",
    url: `${SITE.url}/`,
    makesOffer: [
      {
        "@type": "Offer",
        name: "Abonnement mensuel — six PME à la fois",
        price: "2500",
        priceCurrency: "EUR",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "2500",
          priceCurrency: "EUR",
          unitText: "mois",
          valueAddedTaxIncluded: false,
        },
        description:
          "2 500 € HT par mois dès le premier mois, mois de démarrage compris, prélevés en début de mois. Trois mois minimum, puis renouvelable chaque mois sans engagement. Le plan mis en œuvre chaque semaine, un livrable à date, point hebdomadaire de 45 minutes, demandes hors plan livrées entre J+1 et J+3, tableau de bord partagé. Pause possible après les trois premiers mois, jusqu'à 60 jours : le prélèvement s'arrête et la place est gardée. Le client conserve tous les livrables — contenus, charte, modèles, fichiers sources — y compris après résiliation ; les agents IA utilisés pour produire restent la propriété du prestataire.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ_ACCUEIL.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.r },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={`${SITE.url}/`} jsonLd={jsonLd}>
  <main class="bg-background text-foreground">
    <Hero />
    <Probleme />
    <Fonctionnement />
    <Avantages />
    <Preuves />
    <Bio />
    <Prix />
    <Faq />
    <FinalCta />
    <Footer home />
  </main>
  <Reveal />
</BaseLayout>

