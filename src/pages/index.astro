---
/**
 * Page d'accueil — offre de direction marketing externalisée.
 *
 * Remplace, depuis le 2026-08-29, l'ancienne home « J'installe l'IA dans vos
 * outils. En 2 mois. » (archivée, hors index, dans /installation-ia).
 *
 * Septembre 2026 : ramenée de 11 à 7 blocs sur le modèle de designjoy.co —
 * hero, comment ça marche, avantages, qui, prix, questions, clôture. Les autres
 * offres restent dans la nav et le pied de page.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/offre/Hero.astro";
import Fonctionnement from "@/components/sections/offre/Fonctionnement.astro";
import Avantages from "@/components/sections/offre/Avantages.astro";
import Bio from "@/components/sections/offre/Bio.astro";
import Prix from "@/components/sections/offre/Prix.astro";
import Faq from "@/components/sections/offre/Faq.astro";
import FinalCta from "@/components/sections/offre/FinalCta.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/lib/site";
import { FAQ_ACCUEIL } from "@/lib/faqAccueil";

// Moins de 60 caractères : au-delà, Google coupe le titre, ou le remplace
// par un texte de son choix pris dans la page. Les montants sont dans la
// description, où ils ont la place.
const title = "Direction marketing externalisée pour PME | Julien Tridat";
const description =
  "2 500 € par mois dès le premier, installation comprise : positionnement, identité, gabarits, plan marketing sur douze mois. Sans engagement.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": `${SITE.url}/#service`,
    name: "Direction marketing externalisée — abonnement, installation comprise",
    description:
      "Un abonnement mensuel dont le premier mois installe le système marketing (positionnement et structure d'offre, identité refaite et gabarits, plan marketing sur douze mois), puis le fait tourner, sans engagement : point stratégique hebdomadaire de 45 minutes, demandes non limitées, chacune livrée de J+1 à J+3 selon sa complexité, site, campagnes, contenus, parcours de vente, Pour PME jusqu'à 30 salariés, sans équipe marketing interne.",
    provider: { "@id": `${SITE.url}/#julien-tridat` },
    areaServed: "FR",
    url: `${SITE.url}/`,
    makesOffer: [
      {
        "@type": "Offer",
        name: "Abonnement mensuel — quatre places",
        price: "2500",
        priceCurrency: "EUR",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "2500",
          priceCurrency: "EUR",
          unitText: "mois",
          valueAddedTaxIncluded: false,
        },
        description:
          "Dès le premier mois, installation comprise : positionnement et structure d'offre, identité refaite avec charte et gabarits, plan marketing sur douze mois. Ensuite : point stratégique hebdomadaire de 45 minutes, accès direct des équipes, nombre de demandes non limité — elles sont traitées l'une après l'autre, chacune livrée de J+1 à J+3 une fois lancée selon sa complexité, sans engagement, résiliable à tout moment. Suspension possible sans perte de place. Le client conserve tous les livrables — contenus, charte, gabarits, fichiers sources — y compris après résiliation ; les agents IA utilisés pour produire restent la propriété du prestataire.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ_ACCUEIL.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.r },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={`${SITE.url}/`} jsonLd={jsonLd}>
  <main class="bg-background text-foreground">
    <Hero />
    <Fonctionnement />
    <Avantages />
    <Bio />
    <Prix />
    <Faq />
    <FinalCta />
    <Footer home />
  </main>
</BaseLayout>

<script>
  /* Apparitions au défilement. Garde-fou : si IntersectionObserver manque,
     la classe n'est jamais posée et tout reste visible. */
  if ("IntersectionObserver" in window) {
    document.documentElement.classList.add("js-reveal");
    const io = new IntersectionObserver(
      (entrees) => {
        for (const e of entrees) {
          if (e.isIntersecting) {
            e.target.classList.add("est-visible");
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );
    document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
  }
</script>
