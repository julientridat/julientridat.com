---
/**
 * Intégration IA — seconde offre du site, refaite en septembre 2026 sur le
 * modèle de la page d'accueil (fond et forme) : 8 blocs au lieu de 11,
 * environ 850 mots au lieu de 1 900.
 *
 * AXE : « Pas une démo de plus. Des agents qui travaillent chez vous. »
 * Tout ce qui suit oppose la démonstration à la production : agents sur les
 * comptes du client, construits avec ses équipes, encore en service après le
 * départ du consultant.
 *
 * DISTINCTION AVEC L'ACCUEIL. Dans la direction marketing, l'IA est l'outil
 * de production de Julien : le client reçoit ce qu'elle produit, pas les
 * agents. Ici, c'est l'inverse — les agents sont installés chez le client.
 * La FAQ le dit explicitement.
 *
 * PRIX. Adossés à la grille de juillet 2026 (6 000 € pour une équipe sur 4 à
 * 6 semaines, vendu tel quel en juin). Au-delà de trois pôles : devis.
 * Bpifrance n'est pas mentionné : l'agrément Diag Data IA est déposé, pas
 * obtenu. Aucun chiffre de résultat : le relevé avant/après est montré dans
 * sa forme, jamais avec des valeurs.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import CtaButton from "@/components/CtaButton.astro";
import Footer from "@/components/Footer.astro";
import Reveal from "@/components/Reveal.astro";
import { SITE } from "@/lib/site";

const title = "Intégration de l'IA en entreprise | Julien Tridat";
const description =
  "Pas une démo de plus : des agents installés sur vos comptes, construits avec vos équipes, encore en service six mois après. Audit 1 500 €, un pôle 6 000 €.";

const symptomes = [
  "Une démonstration bluffante en réunion. Rien dans la production le lendemain.",
  "Chacun a ouvert son compte dans son coin. Personne ne sait ce qui y circule.",
  "Des licences pour toute l'équipe. Deux personnes s'en servent.",
];

const phases = [
  {
    semaines: "S1-2",
    titre: "J'écoute.",
    texte:
      "Avec ceux qui font le travail : où passe le temps, où ça coince. Trois tâches chronométrées.",
    recu: "le relevé de départ.",
  },
  {
    semaines: "S3-4",
    titre: "On construit.",
    texte: "Avec vos équipes, d'abord sur la tâche qui leur pèse le plus.",
    recu: "les premiers agents et la règle d'usage écrite.",
  },
  {
    semaines: "S5-6",
    titre: "En production.",
    texte:
      "Un vrai dossier, vos équipes jugent, on corrige, puis l'agent entre dans le travail quotidien.",
    recu: "des agents en service, sur vos comptes.",
  },
  {
    semaines: "S7-8",
    titre: "Sans moi.",
    texte: "Vos équipes s'en servent et les modifient seules. Même relevé qu'en S1.",
    recu: "le mode d'emploi et l'écart avant/après, signé.",
  },
];

// Agents d'illustration de la frise : ils passent de « Démo » à « En service »
// quand la frise atteint S5-6. Décoratifs.
const agentsIllustration = [
  "Réponses aux appels d'offres",
  "Comptes rendus clients",
  "Relances des devis",
];

const tuiles = [
  { signe: "100 %", titre: "Sur vos comptes", texte: "Pas sur les miens." },
  { signe: "1", titre: "Une tâche, toujours la même", texte: "Faite de la même façon, à chaque fois." },
  {
    signe: "6 mois",
    titre: "Encore en service après mon départ",
    texte: "C'est le seul critère qui compte.",
    plein: true,
  },
  { signe: "3", titre: "Trois tâches chronométrées", texte: "Avant, puis huit semaines après." },
  { signe: "+0 €", titre: "Ce qui déborde ne se refacture pas", texte: "Un agent qui sert au pôle voisin, c'est du rab." },
  { signe: "OPCO", titre: "Le volet formation se finance", texte: "Jusqu'à 1 800 € par société et par an." },
];

const offres = [
  {
    nom: "Une équipe",
    montant: "6 000 €",
    duree: "4 à 6 semaines",
    texte: "Le pôle qui produit le plus de documents, ses agents en service et ses gens autonomes.",
  },
  {
    nom: "Deux à trois pôles",
    montant: "12 000 €",
    duree: "6 à 8 semaines",
    texte: "Commerce, gestion, administratif — ou les trois qui vous ralentissent le plus.",
    avant: true,
  },
];

const cas = [
  {
    client: "Agence créative, ~40 personnes",
    ligne: "Quatre agents, deux pôles outillés, les dossiers d'un annonceur ne croisent jamais ceux d'un autre.",
    url: "/realisations/agents-agence-creative",
  },
  {
    client: "Agence santé, 16 personnes",
    ligne: "Trois assistants qui tournent après mon départ, validation médicale préservée.",
    url: "/realisations/formation-ia-agence-sante",
  },
  {
    client: "Conseil et formation",
    ligne: "Les agents et les guides restent : l'organisme produit sans dépendre du consultant.",
    url: "/realisations/transformation-ia-organisme-formation",
  },
];

const questions = [
  {
    q: "Des agents autonomes qui font tout, vous faites ça ?",
    r: "Non. Un agent à qui on confie une chaîne entière dérive : il tient trois semaines en démonstration et lâche en production, au moment précis où plus personne ne le surveille. Ce que j'installe fait une chose, toujours la même, et de la même façon. Vos équipes gardent la main sur l'enchaînement. C'est moins spectaculaire en réunion. C'est ce qui tient.",
  },
  {
    q: "Et quand vous partez ?",
    r: "Tout est sur vos comptes, le mode d'emploi est écrit, les équipes ont été formées sur leurs propres dossiers. C'est le seul critère qui compte : ce qui tourne encore six mois après.",
  },
  {
    q: "On a déjà des licences. Ça sert à quoi de plus ?",
    r: "Une licence donne l'accès, pas l'usage. Ce que j'installe, c'est ce qui se passe entre l'outil et le travail réel : sur quoi il est branché, ce qu'il sait de votre métier, et qui sait s'en servir.",
  },
  {
    q: "Nos données peuvent-elles sortir ?",
    r: "C'est la question à poser, et peu la posent. Avant le premier agent, on écrit ensemble la règle : quels dossiers ont le droit d'y passer, lesquels n'y passeront jamais, et sur quels comptes.",
  },
  {
    q: "Combien d'agents pour 6 000 € ?",
    r: "Autant que le pôle en demande, et pas un de plus. Ce qui fixe le prix, c'est le périmètre et la durée — pas le nombre. Un agent qui rédige vos propositions vaut trois qui reformatent des e-mails.",
  },
  {
    q: "Et si le relevé de fin ne montre rien ?",
    r: "Il est écrit quand même, et je vous le dis en face. Je préfère un client qui sait où l'IA ne lui sert à rien qu'un client qui continue de payer des licences au cas où.",
  },
  {
    q: "Vous faites aussi du marketing. C'est la même chose ?",
    r: "Non. Ici, les agents sont installés chez vous et vos équipes s'en servent. Dans la direction marketing, l'IA reste mon outil de production : vous recevez ce qu'elle produit, pas les agents.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${SITE.url}/integration-ia#service`,
    name: "Intégration de l'IA dans les outils de l'entreprise",
    description:
      "Agents IA installés sur les comptes de l'entreprise, construits avec ses équipes, en production en huit semaines : écoute et relevé de trois tâches chronométrées (semaines 1-2), construction (3-4), mise en production (5-6), formation et relevé avant/après signé (7-8). Prix ferme et délai contractualisé. Volet formation éligible à une prise en charge OPCO.",
    provider: { "@id": `${SITE.url}/#julien-tridat` },
    areaServed: "FR",
    url: `${SITE.url}/integration-ia`,
    makesOffer: [
      {
        "@type": "Offer",
        name: "L'audit",
        price: "1500",
        priceCurrency: "EUR",
        description:
          "Avant toute installation : frictions cartographiées, cas d'usage classés par effort et par impact, feuille de route. Déduit de l'intégration si elle démarre sous trente jours.",
      },
      {
        "@type": "Offer",
        name: "Intégration — une équipe",
        price: "6000",
        priceCurrency: "EUR",
        description:
          "4 à 6 semaines. Agents installés sur les comptes de l'entreprise pour le pôle qui produit le plus de documents, mode d'emploi écrit, équipes formées, règle d'usage rédigée.",
      },
      {
        "@type": "Offer",
        name: "Intégration — deux à trois pôles",
        price: "12000",
        priceCurrency: "EUR",
        description:
          "6 à 8 semaines. Même dispositif étendu à deux ou trois pôles : commerce, gestion, administratif, ou ceux qui ralentissent le plus l'entreprise.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: questions.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.r },
    })),
  },
];

const h2 = "text-[clamp(2.2rem,5vw,4rem)] font-normal leading-[1.02] tracking-[-0.035em]";
const pastille =
  "rounded-full border border-lime/30 bg-lime/[0.06] px-3.5 py-1.5 text-[11px] uppercase tracking-[0.22em] text-lime";
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE.url}/integration-ia`}
  jsonLd={jsonLd}
>
  <main class="bg-background text-foreground">
    {/* ---------------------------------------------------------------- 1 · Hero
        Sombre, comme l'accueil, mais sans photo : à droite, des agents « En
        service » — l'objet même de la promesse. */}
    <section class="relative isolate overflow-hidden bg-foreground text-white">
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background: radial-gradient(45% 60% at 78% 45%, rgba(108,76,241,0.30), transparent 70%), radial-gradient(40% 50% at 10% 0%, rgba(185,166,255,0.10), transparent 70%);"
      >
      </div>
      <Nav onDark />

      <div class="mx-auto grid max-w-7xl gap-14 px-6 pb-20 pt-36 md:px-12 md:pb-24 md:pt-44 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:items-center lg:gap-10">
        <div>
          <p class="mb-7 w-fit rounded-full border border-white/15 bg-white/[0.06] px-4 py-1.5 text-[12px] font-medium uppercase tracking-[0.18em] text-white md:text-[13px]">
            Intégration IA&nbsp;· PME et ETI
          </p>
          <h1 class="text-[clamp(2.4rem,5.4vw,4.4rem)] font-medium leading-[1.02] tracking-[-0.035em] lg:text-[clamp(2.6rem,4.1vw,4rem)]">
            <span class="block text-balance">Pas une démo de plus.</span>
            {/* Blocs équilibrés : sinon « plus. » (mobile) et « vous. » (desktop) tombaient seuls sur leur ligne. */}
            <em class="block text-balance font-normal text-violet-soft">Des agents qui travaillent chez vous.</em>
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/85 md:text-xl">
            Installés sur vos comptes, construits avec vos équipes, encore en service six mois
            après mon départ.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <CtaButton onDark>Réserver 20&nbsp;minutes</CtaButton>
            <a
              href="#prix"
              class="inline-flex items-center rounded-full border border-white/25 px-6 py-3.5 text-[15px] font-medium leading-7 text-white/85 transition-colors hover:border-violet-soft hover:text-violet-soft"
            >
              Combien ça coûte&nbsp;?
            </a>
          </div>
          <p class="mt-6 text-sm text-white/70">
            Prix ferme&nbsp;· 8&nbsp;semaines&nbsp;· Financement OPCO possible
          </p>
        </div>

        <div aria-hidden="true" class="relative mx-auto w-full max-w-md">
          {agentsIllustration.map((a, i) => (
            <div
              class="hero-agent mb-3 flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-white/[0.05] px-5 py-4 backdrop-blur-sm"
              style={`margin-left: ${i * 1.25}rem; animation-delay: ${i * 0.9}s`}
            >
              <div class="min-w-0">
                <div class="text-[10px] uppercase tracking-[0.18em] text-white/50">Agent · sur vos comptes</div>
                <div class="mt-1 truncate text-[15px] font-medium text-white">{a}</div>
              </div>
              <span class="flex shrink-0 items-center gap-2 rounded-full bg-lime/20 px-3 py-1 text-xs font-medium text-violet-soft">
                <span class="hero-pouls h-1.5 w-1.5 rounded-full bg-violet-soft"></span>
                En service
              </span>
            </div>
          ))}
          <p class="mt-5 text-right font-serif text-lg italic text-white/45">…et toujours là après mon départ.</p>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------ 2 · Pour qui */}
    <section class="border-t border-line px-6 py-14 md:px-12 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div data-reveal>
          <Eyebrow>Pour qui</Eyebrow>
          <h2 class={h2}>
            Des démos, <em class="text-lime">vous en avez vu.</em>
          </h2>
        </div>

        <ul class="mt-10 grid gap-4 md:grid-cols-3">
          {symptomes.map((s, i) => (
            <li
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
              class="rounded-3xl border border-line bg-card p-7 text-lg leading-relaxed text-foreground"
            >
              <span class="mb-5 block font-serif text-3xl italic leading-none text-lime">
                {String(i + 1).padStart(2, "0")}
              </span>
              {s}
            </li>
          ))}
        </ul>

        <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-center">
          <p data-reveal class="border-l-2 border-lime pl-6 font-serif text-[clamp(1.6rem,3vw,2.3rem)] italic leading-snug text-lime">
            Le problème n'est pas l'outil. C'est que personne ne l'a installé.
          </p>
          <div data-reveal style="--reveal-delay: 120ms" class="rounded-3xl border border-line p-7">
            <p class="text-lg leading-relaxed text-ink-2">
              <strong class="font-medium text-foreground">Ce n'est pas pour vous si</strong> vous voulez
              tester (une démo, ça se trouve gratuitement), s'il n'y a pas de décideur, ou si vous
              cherchez une sensibilisation.
            </p>
            <p class="mt-4 font-serif text-xl italic text-foreground">J'en mène deux à la fois, pas six.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------ 3 · Comment ça marche
        La frise s'allume de S1 à S8 ; à S5-6, les agents d'illustration passent
        de « Démo » à « En service ». Décoratif pour la partie animée : le texte
        des phases porte l'information. */}
    <section id="comment" class="border-t border-line bg-card px-6 py-14 md:px-12 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div data-reveal>
          <Eyebrow>Comment ça marche</Eyebrow>
          <h2 class={h2}>
            De la démo à la production.
            <br />
            <em class="text-lime">En huit semaines.</em>
          </h2>
        </div>

        <div id="frise" class="relative mt-12">
          <div class="mb-6 hidden h-1 overflow-hidden rounded-full bg-line xl:block" aria-hidden="true">
            <div id="frise-barre" class="h-full w-1/4 rounded-full bg-lime transition-[width] duration-700 ease-out"></div>
          </div>

          <ol class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            {phases.map((p, i) => (
              <li
                data-reveal
                data-phase={i}
                style={`--reveal-delay: ${i * 90}ms`}
                class={`frise-phase flex flex-col rounded-3xl border p-6 transition-all duration-500 md:p-7 ${i === 0 ? "border-lime bg-background shadow-[0_24px_50px_-30px_rgba(108,76,241,0.55)]" : "border-line bg-background"}`}
              >
                <span class="frise-pastille grid h-12 w-fit place-items-center rounded-full bg-foreground px-4 font-serif text-lg italic text-white transition-colors duration-500">
                  {p.semaines}
                </span>
                <h3 class="mt-6 text-xl font-medium text-foreground">{p.titre}</h3>
                <p class="mt-2 flex-1 text-base leading-relaxed text-ink-2">{p.texte}</p>
                <p class="mt-5 border-t border-line pt-4 text-[15px] leading-relaxed text-ink-2">
                  <span class="font-medium text-lime">Vous recevez&nbsp;:</span> {p.recu}
                </p>
              </li>
            ))}
          </ol>

          <div data-reveal class="mt-8 flex flex-wrap items-center gap-3" aria-hidden="true">
            <span class="text-[11px] uppercase tracking-[0.22em] text-ink-3">Vos agents</span>
            {agentsIllustration.map((a) => (
              <span class="frise-agent flex items-center gap-2 rounded-full border border-line bg-background px-3.5 py-1.5 text-sm text-ink-2 transition-all duration-500">
                {a}
                <span class="frise-etat rounded-full bg-line px-2 py-0.5 text-[11px] font-medium text-ink-3">Démo</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ------------------------------------------- 4 · Ce qui sépare un agent d'une démo */}
    <section class="border-t border-line px-6 py-14 md:px-12 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div data-reveal>
          <Eyebrow>Ce qui tient</Eyebrow>
          <h2 class={h2}>
            Ce qui sépare un agent
            <br />
            <em class="text-lime">d'une démo.</em>
          </h2>
        </div>

        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {tuiles.map((t, i) => (
            <li
              data-reveal
              style={`--reveal-delay: ${i * 70}ms`}
              class={`flex flex-col rounded-3xl p-7 transition duration-300 md:p-8 ${
                t.plein
                  ? "bg-lime text-white shadow-[0_30px_70px_-30px_rgba(108,76,241,0.7)]"
                  : "border border-line bg-card hover:-translate-y-1 hover:border-lime/50 hover:shadow-[0_24px_50px_-30px_rgba(17,18,22,0.35)]"
              }`}
            >
              <span class={`font-serif text-[clamp(2.8rem,5vw,4.25rem)] italic leading-[0.9] tracking-tight ${t.plein ? "text-white" : "text-lime"}`}>
                {t.signe}
              </span>
              <h3 class={`mt-8 text-lg font-medium ${t.plein ? "text-white" : "text-foreground"}`}>{t.titre}</h3>
              <p class={`mt-1.5 text-base leading-relaxed ${t.plein ? "text-white/85" : "text-ink-2"}`}>{t.texte}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ----------------------------------------------------------------- 5 · Le prix */}
    <section id="prix" class="relative isolate overflow-hidden bg-foreground px-6 py-16 text-white md:px-12 md:py-24">
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background: radial-gradient(45% 55% at 70% 60%, rgba(108,76,241,0.28), transparent 70%), radial-gradient(35% 40% at 10% 10%, rgba(185,166,255,0.10), transparent 70%);"
      >
      </div>
      <div class="mx-auto max-w-7xl">
        <div data-reveal>
          <Eyebrow onDark>Le prix</Eyebrow>
          <h2 class={h2}>
            Un prix ferme. <em class="text-violet-soft">Pas un devis qui grossit.</em>
          </h2>
        </div>

        <div class="mt-12 grid items-stretch gap-5 lg:grid-cols-3">
          <div data-reveal class="flex flex-col rounded-3xl border border-white/10 bg-white/[0.04] p-8 backdrop-blur-sm">
            <div class="text-[11px] uppercase tracking-[0.22em] text-violet-soft">D'abord · L'audit</div>
            <div class="mt-4 flex items-baseline gap-2">
              <span class="font-serif text-[clamp(3rem,5vw,4rem)] italic leading-[0.85] tracking-tight">1&nbsp;500&nbsp;€</span>
              <span class="text-sm text-white/55">HT</span>
            </div>
            <p class="mt-6 flex-1 text-base leading-relaxed text-white/75">
              Avant d'installer quoi que ce soit&nbsp;: frictions cartographiées, cas d'usage classés,
              feuille de route.
            </p>
            <p class="mt-6 border-t border-white/10 pt-5 text-sm text-white/60">
              Déduit si l'intégration démarre dans les 30&nbsp;jours.
            </p>
          </div>

          {offres.map((o, i) =>
            o.avant ? (
              <div
                data-reveal
                style={`--reveal-delay: ${(i + 1) * 100}ms`}
                class="relative rounded-[1.75rem] bg-gradient-to-br from-violet-soft/70 via-lime/60 to-lime/10 p-px shadow-[0_40px_120px_-40px_rgba(108,76,241,0.75)]"
              >
                <span class="absolute -top-3 left-8 rounded-full bg-lime px-3.5 py-1 text-[11px] font-medium uppercase tracking-[0.22em] text-white">
                  Le plus fréquent
                </span>
                <div class="flex h-full flex-col rounded-[calc(1.75rem-1px)] bg-[#17151f] p-8">
                  <div class="text-[11px] uppercase tracking-[0.22em] text-violet-soft">{o.nom}</div>
                  <div class="mt-4 flex items-baseline gap-2">
                    <span class="font-serif text-[clamp(3rem,5vw,4rem)] italic leading-[0.85] tracking-tight" set:html={o.montant} />
                    <span class="text-sm text-white/55">HT</span>
                  </div>
                  <div class="mt-2 text-base text-white/70">{o.duree}</div>
                  <p class="mt-6 flex-1 border-t border-white/10 pt-5 text-base leading-relaxed text-white/80">{o.texte}</p>
                </div>
              </div>
            ) : (
              <div
                data-reveal
                style={`--reveal-delay: ${(i + 1) * 100}ms`}
                class="flex flex-col rounded-3xl border border-white/10 bg-white/[0.04] p-8 backdrop-blur-sm"
              >
                <div class="text-[11px] uppercase tracking-[0.22em] text-violet-soft">{o.nom}</div>
                <div class="mt-4 flex items-baseline gap-2">
                  <span class="font-serif text-[clamp(3rem,5vw,4rem)] italic leading-[0.85] tracking-tight" set:html={o.montant} />
                  <span class="text-sm text-white/55">HT</span>
                </div>
                <div class="mt-2 text-base text-white/70">{o.duree}</div>
                <p class="mt-6 flex-1 border-t border-white/10 pt-5 text-base leading-relaxed text-white/75">{o.texte}</p>
              </div>
            ),
          )}
        </div>

        <div data-reveal class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <CtaButton onDark>Réserver 20&nbsp;minutes</CtaButton>
          <p class="text-sm text-white/60">
            Au-delà de trois pôles&nbsp;: sur devis. Le dossier OPCO, c'est moi qui le monte.
          </p>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------ 6 · Déjà en production */}
    <section class="border-t border-line px-6 py-14 md:px-12 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div data-reveal>
          <Eyebrow>Déjà en production</Eyebrow>
          <h2 class={h2}>
            Six missions. <em class="text-lime">Ce qui tourne encore aujourd'hui.</em>
          </h2>
        </div>

        <div class="mt-12 grid gap-4 md:grid-cols-3">
          {cas.map((c, i) => (
            <a
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
              href={c.url}
              class="group flex flex-col rounded-3xl border border-line bg-card p-7 transition duration-300 hover:-translate-y-1 hover:border-lime/50 hover:shadow-[0_24px_50px_-30px_rgba(17,18,22,0.35)]"
            >
              <span class="flex w-fit items-center gap-2 rounded-full bg-lime/10 px-3 py-1 text-xs font-medium text-lime">
                <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>
                En service
              </span>
              <h3 class="mt-5 text-lg font-medium text-foreground">{c.client}</h3>
              <p class="mt-2 flex-1 text-base leading-relaxed text-ink-2">{c.ligne}</p>
              <span class="mt-6 text-sm text-ink-3 transition-colors group-hover:text-lime">Voir le cas ↗</span>
            </a>
          ))}
        </div>

        <div data-reveal class="mt-8 flex flex-wrap gap-x-10 gap-y-3 text-base">
          <a href="/realisations" class="group inline-flex items-center gap-2 text-lime">
            Toutes les missions <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
          <a href="/agences" class="group inline-flex items-center gap-2 text-ink-2 hover:text-lime">
            Vous êtes une agence&nbsp;? Une page parle votre métier
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>
    </section>

    {/* --------------------------------------------------------------- 7 · Questions */}
    <section id="faq" class="border-t border-line bg-card px-6 py-14 md:px-12 md:py-20">
      <div class="mx-auto max-w-7xl">
        <Eyebrow>Questions</Eyebrow>
        <div class="grid gap-8 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.4fr)] md:gap-16">
          <h2 data-reveal class={`${h2} md:sticky md:top-24 md:self-start`}>
            Ce que vous alliez <em class="text-lime">me demander.</em>
          </h2>
          <div data-reveal style="--reveal-delay: 100ms">
            {questions.map((item, i) => (
              <details class={`border-t border-line ${i === questions.length - 1 ? "border-b" : ""}`}>
                <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 py-5 text-lg font-medium text-foreground transition-colors hover:text-lime md:text-xl">
                  <span>{item.q}</span>
                  <span class="faq-marqueur shrink-0 font-serif text-2xl leading-none text-lime" aria-hidden="true"></span>
                </summary>
                <p class="pb-5 text-lg leading-relaxed text-ink-2">{item.r}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ----------------------------------------------------------------- 8 · Clôture */}
    <section id="contact" class="relative isolate overflow-hidden bg-foreground px-6 py-16 text-white md:px-12 md:py-20">
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background: radial-gradient(58% 90% at 50% 115%, rgba(108,76,241,0.22), transparent 70%);"
      >
      </div>
      <div class="mx-auto max-w-4xl text-center">
        <Eyebrow onDark>Prochaine étape</Eyebrow>
        <h2 class="text-[clamp(2.2rem,5.5vw,4.5rem)] font-normal leading-[1.02] tracking-[-0.03em]">
          Vingt minutes. <em class="text-violet-soft">Pas une démo.</em>
        </h2>
        <p class="mx-auto mt-8 max-w-2xl text-xl leading-relaxed text-white/80">
          Vous me décrivez ce que vos équipes produisent et où ça coince. Je vous dis si un agent y
          tiendrait en production — et si la réponse est non, je vous le dis aussi.
        </p>
        <div class="mt-12 flex justify-center">
          <CtaButton onDark>Réserver 20&nbsp;minutes</CtaButton>
        </div>
      </div>
    </section>

    <Footer />
  </main>
  <Reveal />
</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ""; }
  .faq-marqueur::after { content: "+"; }
  details[open] .faq-marqueur::after { content: "–"; }

  /* Hero : les agents flottent doucement, le point « En service » bat. */
  .hero-agent { animation: flotte 6s ease-in-out infinite; }
  .hero-pouls { animation: pouls 1.8s ease-out infinite; }
  @keyframes flotte {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  @keyframes pouls {
    0% { box-shadow: 0 0 0 0 rgba(185, 166, 255, 0.7); }
    100% { box-shadow: 0 0 0 8px rgba(185, 166, 255, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-agent, .hero-pouls { animation: none; }
  }
</style>

<script>
  /* Frise : une phase s'allume toutes les 2,4 s ; à partir de S5-6, les
     agents passent de « Démo » à « En service ». Boucle, et tourne seulement
     quand la frise est à l'écran. */
  const frise = document.getElementById("frise");
  const barre = document.getElementById("frise-barre");
  const reduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (frise && !reduit) {
    const phases = [...frise.querySelectorAll<HTMLElement>(".frise-phase")];
    const agents = [...frise.querySelectorAll<HTMLElement>(".frise-agent")];
    const ACTIF = ["border-lime", "shadow-[0_24px_50px_-30px_rgba(108,76,241,0.55)]"];
    let courant = 0;
    let visible = false;

    const afficher = (n: number) => {
      phases.forEach((p, i) => {
        p.classList.toggle("border-lime", i === n);
        p.classList.toggle("border-line", i !== n);
        p.classList.toggle(ACTIF[1], i === n);
        const pastille = p.querySelector(".frise-pastille") as HTMLElement;
        pastille.classList.toggle("bg-lime", i <= n);
        pastille.classList.toggle("bg-foreground", i > n);
      });
      if (barre) barre.style.width = `${((n + 1) / phases.length) * 100}%`;
      const enService = n >= 2;
      agents.forEach((a, i) => {
        const etat = a.querySelector(".frise-etat") as HTMLElement;
        window.setTimeout(() => {
          etat.textContent = enService ? "En service" : "Démo";
          etat.className = `frise-etat rounded-full px-2 py-0.5 text-[11px] font-medium ${enService ? "bg-lime text-white" : "bg-line text-ink-3"}`;
          a.classList.toggle("border-lime/50", enService);
          a.classList.toggle("text-foreground", enService);
        }, enService ? i * 250 : 0);
      });
    };

    new IntersectionObserver((e) => { visible = e.some((x) => x.isIntersecting); }, { threshold: 0.2 }).observe(frise);
    afficher(0);
    window.setInterval(() => {
      if (!visible || document.hidden) return;
      courant = (courant + 1) % phases.length;
      afficher(courant);
    }, 2400);
  }
</script>
