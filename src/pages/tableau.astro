              else { deplacer(c, "fait"); toast("« " + c.t + " » : fait."); }
            });
            li.appendChild(cb);
          }
          var titre = el("button", "sem-t");
          titre.type = "button";
          titre.appendChild(document.createTextNode(k ? k.t : c.t));
          var ou = [cl ? cl.nom : "", ch ? ch.nom : ""].filter(Boolean).join(" · ");
          var detail = section === "traiter"
            ? (c.statut ? majuscule(c.statut) : c.col === "demandes" ? "Nouvelle demande" : "Nouveau") + (ou ? " — " + ou : "")
            : (k ? "Dans « " + c.t + " »" + (ou ? " — " + ou : "") : ou + (c.col === "encours" ? " · en cours" : ""));
          titre.appendChild(el("small", null, detail));
          titre.addEventListener("click", function () { ouvrirCarte(c.id); });
          li.appendChild(titre);
          var d = it.date;
          li.appendChild(el("span", "quand" + (d && d < aujourdhui() ? " retard" : ""), d ? dateCourte(d) : section === "traiter" ? quand(c.majLe || Date.now()) : ""));
          return li;
        }

