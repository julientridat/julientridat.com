  <body>
    <div class="acces" id="acces" hidden>
      <div class="acces-in">
        <h1 id="acces-titre">Ce tableau s’ouvre avec <em>votre lien personnel</em>.</h1>
        <p id="acces-texte">Julien vous l’a envoyé par e-mail. Ouvrez-le une fois : ce navigateur s’en souviendra.</p>
        <p><button class="btn" type="button" id="reessayer" hidden>Réessayer</button></p>
        <form class="coller" id="coller">
          <input type="text" id="coller-lien" placeholder="Ou collez ici votre lien" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Votre lien personnel" />
          <button class="btn" type="submit">Ouvrir</button>
        </form>
        <p class="petit">Pas de lien, ou il ne fonctionne plus&nbsp;? Écrivez à <a href="mailto:julien@julientridat.com">julien@julientridat.com</a>.</p>
      </div>
    </div>

    <div class="apercu-bar" id="apercu-bar" hidden></div>
    <header class="top" id="top" hidden>
      <div class="top-in">
        <p class="wordmark">Julien Tridat <span id="sous-titre">le tableau</span></p>
        <span class="live" id="live"><i></i><span>connexion…</span></span>
        <span class="presence" id="presence"></span>
        <div class="filters" id="filtres"></div>
        <div class="right" id="outils"></div>
      </div>
    </header>

    <main id="contenu">
    <div class="periode" id="periode" hidden></div>
    <section class="aide-client" id="aide-client" hidden aria-labelledby="aide-titre"></section>
    <section class="projet" id="projet" hidden aria-label="Le projet"></section>

    <div class="barre" id="barre" hidden>
      <div class="f-groupe" id="f-ch"></div>
      <div class="f-groupe" id="f-mois"></div>
      <button type="button" class="pill f-st" id="f-st" aria-pressed="false" hidden>Sous-tâches</button>
      <label class="f-q">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="5"></circle><path d="m11 11 3.5 3.5"></path></svg>
        <input type="search" id="f-q" placeholder="Chercher une carte" autocomplete="off" aria-label="Chercher une carte" />
      </label>
      <span class="f-n" id="f-n"></span>
      <button type="button" class="f-raz" id="f-raz" hidden>Tout afficher</button>
    </div>

    <nav class="onglets" id="onglets" hidden aria-label="Colonnes du tableau"></nav>
    <section class="vue" id="vue" hidden></section>

    <div class="board" id="board" hidden>
      <section class="column" data-col="demandes">
        <div class="col-h"><h2>Demandes</h2><span class="n"></span><span class="hint">reçues</span></div>
        <div class="cards"></div>
        <div class="add"><input type="text" data-add="demandes" /></div>
        <p class="folded"></p>
      </section>
      <section class="column" data-col="prevu">
        <div class="col-h"><h2>Prévu</h2><span class="n"></span><span class="hint">au plan</span></div>
        <div class="cards"></div>
        <div class="add julien"><input type="text" data-add="prevu" placeholder="+ carte" /></div>
      </section>
      <section class="column" data-col="encours">
        <div class="col-h"><h2>En cours</h2><span class="n"></span><span class="hint">chez Julien</span></div>
        <div class="cards"></div>
        <div class="add julien"><input type="text" data-add="encours" placeholder="+ carte" /></div>
      </section>
      <section class="column vous" data-col="vous">
        <div class="col-h"><h2 data-titre-vous>Chez le client</h2><span class="n"></span><span class="hint">à régler</span></div>
        <div class="cards"></div>
        <div class="add julien"><input type="text" data-add="vous" placeholder="+ une question au client" /></div>
      </section>
      <section class="column" data-col="fait">
        <div class="col-h"><h2>Fait</h2><span class="n"></span><span class="hint">le plus récent en tête</span></div>
        <div class="cards"></div>
      </section>
    </div>
    </main>

    <button type="button" class="fab" id="fab" hidden aria-label="Discussion">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4H6.5A2.5 2.5 0 0 1 4 13.5z"></path></svg>
      <span>Discussion</span>
      <b class="badge" id="fab-n" hidden></b>
    </button>
    <aside class="chat" id="chat" hidden aria-label="Discussion">
      <header class="chat-h">
        <button type="button" id="chat-retour" aria-label="Toutes les discussions" hidden>‹</button>
        <span class="avatar" id="chat-av"></span>
        <div class="chat-qui"><b id="chat-nom"></b><small id="chat-etat"></small></div>
        <button type="button" id="chat-x" aria-label="Fermer la discussion">×</button>
      </header>
      <div class="chat-fils" id="chat-fils" role="tablist" aria-label="Fils de discussion"></div>
      <div class="chat-fil" id="chat-fil" aria-live="polite"></div>
      <form class="chat-saisie" id="chat-saisie">
        <textarea id="chat-txt" rows="1" placeholder="Message" aria-label="Votre message"></textarea>
        <button type="submit" class="chat-go" aria-label="Envoyer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12.6 2-12.6 2z"></path></svg>
        </button>
      </form>
    </aside>

    <div class="back" id="back"><div class="sheet" id="sheet" role="dialog" aria-modal="true" tabindex="-1"></div></div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script is:inline>
      (function () {
        "use strict";
        var CLE_STOCK = "tableau.cle";
        var COLS = ["demandes", "prevu", "encours", "vous", "fait"];
        var NOM_COL = { demandes: "Demande", prevu: "Prévu", encours: "En cours", vous: "Chez le client", fait: "Fait", mensuel: "Au point mensuel" };
        var COULEURS = ["c1", "c2", "c3", "c4", "c5", "c6"];
        var JOUR = 86400000;
        var PROCESS = [
          { type: "formation", test: /formation|former|atelier|session/i, intro: "C’est une formation. Pour qu’elle serve vraiment, voici les étapes :", jalons: ["Programme proposé — sous 48 h", "Votre validation, et le choix de la date", "Session animée + support remis"] },
          { type: "site", test: /site|page|landing|refonte|vitrine|e-?commerce/i, intro: "Un site ne se livre pas fini en 72 h — et c’est ce qui vous protège. Voici comment ça se passe :", jalons: ["Maquette — sous 48 h", "Votre validation — un aller-retour", "V1 en ligne — sous 72 h après validation"] },
          { type: "contenu", test: /mail|s[ée]quence|article|blog|post|linkedin|newsletter|contenu|campagne|visuel/i, intro: "C’est du contenu. On valide l’angle avant d’écrire — jamais l’inverse :", jalons: ["Angle et plan — sous 24 h", "Votre validation", "Version complète — sous 48 h"] },
          { type: "outil", test: /outil|crm|automatis|install|\bia\b|assistant|logiciel|brevo/i, intro: "C’est une installation d’outil. Personne ne reçoit un outil sans savoir s’en servir :", jalons: ["Cadrage — trois questions", "Installation sur vos comptes", "Démonstration à l’équipe — 30 min"] }
        ];
        var HORS_CADRE = { type: "à cadrer", intro: "Reçu. Pour éviter tout malentendu sur les délais, Julien découpe chaque demande en étapes — la première arrive toujours sous 48 à 72 h :", jalons: ["Découpage proposé — sous 24 h", "Votre validation", "Premier livrable — sous 48 à 72 h"] };

        var S = { cle: null, me: null, clients: [], cartes: [], acces: [], enLigne: [], filtre: "tous", apercu: false, connecte: false, recu: false,
          f: { ch: null, mois: null, q: "" }, msgs: {}, lus: {}, debutFil: {}, moisOuverts: {}, aide: false, colMobile: null, stDeplie: null };
        var tactile = window.matchMedia("(pointer: coarse)").matches;
        var autonome = window.matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
        var feuille = { mode: null, id: null };
        var ws = null, essais = 0, pingT = null, reconnexionT = null;

        var $ = function (id) { return document.getElementById(id); };
        function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
        function bouton(txt, cls, fn) { var b = el("button", cls || "btn-ghost btn-sm", txt); b.type = "button"; b.addEventListener("click", function (e) { e.stopPropagation(); fn(e); }); return b; }
        var toastT;
        function toast(m) { var t = $("toast"); t.textContent = m; t.classList.add("on"); clearTimeout(toastT); toastT = setTimeout(function () { t.classList.remove("on"); }, 3200); }

        /* ————— Clé et connexion ————— */
        function lireCle() {
          var m = location.hash.match(/cle=([^&]+)/);
          if (m) {
            var k = decodeURIComponent(m[1]);
            try { localStorage.setItem(CLE_STOCK, k); } catch (e) {}
            history.replaceState(null, "", location.pathname + location.search);
            return k;
          }
          try { return localStorage.getItem(CLE_STOCK); } catch (e) { return null; }
        }
        function montrerAcces(message) {
          $("acces").hidden = false;
          ["top", "periode", "aide-client", "projet", "barre", "onglets", "vue", "board", "apercu-bar", "fab", "chat"].forEach(function (id) { $(id).hidden = true; });
          if (message) $("acces-texte").textContent = message;
          else if (autonome) $("acces-texte").textContent = "Collez ci-dessous le lien reçu par e-mail : l’app s’en souviendra.";
          $("reessayer").hidden = !S.cle;
        }
        function connecter() {
          clearTimeout(reconnexionT);
          if (!S.cle) return montrerAcces();
          if (ws && (ws.readyState === 0 || ws.readyState === 1)) return;
          ws = new WebSocket((location.protocol === "https:" ? "wss://" : "ws://") + location.host + "/api/tableau/ws");
          ws.onopen = function () {
            essais = 0;
            ws.send(JSON.stringify({ type: "bonjour", cle: S.cle }));
            clearInterval(pingT);
            pingT = setInterval(function () { if (ws && ws.readyState === 1) ws.send("ping"); }, 25000);
          };
          ws.onmessage = function (e) {
            if (e.data === "pong") return;
            var m;
            try { m = JSON.parse(e.data); } catch (x) { return; }
            recevoir(m);
          };
          ws.onclose = function (e) {
            clearInterval(pingT);
            S.connecte = false;
            majLive();
            if (e.code === 4001) return;
            reconnexionT = setTimeout(connecter, Math.min(15000, 1000 * Math.pow(2, essais++)));
          };
        }
        document.addEventListener("visibilitychange", function () { if (!document.hidden && (!ws || ws.readyState > 1)) { essais = 0; connecter(); } });
        window.addEventListener("online", function () { essais = 0; connecter(); });

        function op(o) {
          if (!ws || ws.readyState !== 1) { toast("Hors ligne — le geste n’est pas parti. Reconnexion en cours…"); return false; }
          ws.send(JSON.stringify({ type: "op", op: o }));
          return true;
        }

        function recevoir(m) {
          if (m.type === "session") { S.me = m.me; return; }
          if (m.type === "erreur") {
            if (m.code === "cle") return montrerAcces(m.message);
            return toast(m.message);
          }
          if (m.type === "etat") {
            S.clients = m.clients || [];
            S.cartes = m.cartes || [];
            S.acces = m.acces || [];
            S.enLigne = m.enLigne || [];
            S.connecte = true;
            if (S.filtre !== "tous" && S.filtre !== "semaine" && !clientParId(S.filtre)) S.filtre = "tous";
            if (!S.recu) {
              S.recu = true;
              $("acces").hidden = true; $("top").hidden = false; $("board").hidden = false; $("fab").hidden = false;
              // Julien ouvre sur sa semaine au téléphone, sur sa place s'il n'en a qu'une, sinon sur la vue d'ensemble.
              if (julien()) {
                var actives = S.clients.filter(function (c) { return !c.archive; });
                S.filtre = tactile ? "semaine" : actives.length === 1 ? actives[0].id : "tous";
              }
            }
            if (G || saisieEnCours()) S.enAttente = true;
            else rendre();
            rafraichirFeuille();
            rendreChat();
            return;
          }
          if (m.type === "discussion") return recevoirDiscussion(m);
          if (m.type === "message") return recevoirMessage(m);
          if (m.type === "lu") { var l = lusDe(m.client, m.fil || ""); l[m.qui] = Math.max(l[m.qui] || 0, m.ts); return rendreChat(); }
          if (m.type === "frappe") return recevoirFrappe(m);
          if (m.type === "historique") return recevoirHistorique(m);
          if (m.type === "cree") return montrerLien(m);
          if (m.type === "import") return toast(rapportImport(m.rapport));
          if (m.type === "export") return telecharger(m.data);
        }

        /* Une réponse en cours de frappe sur une carte ne doit pas disparaître parce
           que l'autre côté vient de bouger une carte : le rendu attend la fin de la saisie. */
        function saisieEnCours() {
          var a = document.activeElement;
          return !!(a && a.closest && (a.closest("#board .zone") || (a.closest("#projet") && /^(INPUT|TEXTAREA)$/.test(a.tagName))));
        }
        ["board", "projet"].forEach(function (id) {
          $(id).addEventListener("focusout", function () {
            setTimeout(function () { if (S.enAttente && !saisieEnCours() && !G) { S.enAttente = false; rendre(); } }, 0);
          });
        });

        /* ————— Vue courante ————— */
        function julien() { return S.me && S.me.role === "julien"; }
        function faceClient() { return !julien() || S.apercu; }
        function clientParId(id) { for (var i = 0; i < S.clients.length; i++) if (S.clients[i].id === id) return S.clients[i]; return null; }
        function clientCourant() {
          if (!julien()) return S.clients[0] || null;
          return clientParId(S.filtre);
        }
        /* « tous » : la vue d'ensemble ; « semaine » : Ma semaine ; sinon le tableau d'une place. */
        function modeVue() { return julien() && !S.apercu && (S.filtre === "tous" || S.filtre === "semaine") ? S.filtre : null; }
        function cartesVisibles() {
          if (!julien()) return S.cartes;
          if (S.filtre === "tous") return S.cartes.filter(function (c) { var cl = clientParId(c.client); return cl && !cl.archive; });
          return S.cartes.filter(function (c) { return c.client === S.filtre; });
        }
        /* Les filtres de la barre — chantier, mois, mots — ne jouent que sur les colonnes. */
        var MOIS = ["janvier", "fevrier", "mars", "avril", "mai", "juin", "juillet", "aout", "septembre", "octobre", "novembre", "decembre"];
        var MOIS_AFFICHE = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"];
        function sansAccent(t) { return String(t || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase(); }
        function moisDe(c) {
          if (c.date) return Number(c.date.slice(5, 7)) - 1;
          var e = sansAccent(c.echeance);
          for (var i = 0; i < 12; i++) if (new RegExp("\\b" + MOIS[i] + "\\b").test(e)) return i;
          return -1;
        }
        function filtreActif() { return !!(S.f.ch || filtreBarre()); }
        /* Mois et mots : les filtres que « Tout afficher » efface ; le projet ouvert reste ouvert. */
        function filtreBarre() { return !!(S.f.mois !== null || S.f.q.trim()); }
        function passeFiltre(c) {
          if (S.f.ch && c.ch !== S.f.ch) return false;
          if (S.f.mois !== null && moisDe(c) !== S.f.mois) return false;
          var mots = sansAccent(S.f.q).split(/\s+/).filter(Boolean);
          if (mots.length) {
            var ch = chantier(c), cl = clientParId(c.client);
            var foin = sansAccent([c.t, c.desc, c.echeance, c.type, c.note, c.statut, ch ? ch.nom : "", cl ? cl.nom : ""].concat((c.st || []).map(function (x) { return x.t + " " + x.qui; })).join(" "));
            for (var i = 0; i < mots.length; i++) if (foin.indexOf(mots[i]) < 0) return false;
          }
          return true;
        }
        function cartesAffichees() { return cartesVisibles().filter(passeFiltre); }
        function chantier(c) {
          var cl = clientParId(c.client);
          if (!cl || !c.ch) return null;
          for (var i = 0; i < cl.chantiers.length; i++) if (cl.chantiers[i].id === c.ch) return cl.chantiers[i];
          return null;
        }
        function couleur(c) { var ch = chantier(c); return "var(--" + (ch ? ch.couleur : "c0") + ")"; }
        function roleVue() { return faceClient() ? "client" : "julien"; }
        function jours(ts) { return Math.floor((Date.now() - ts) / JOUR); }
        function depuis(ts) { var j = jours(ts); return j <= 0 ? "arrivée aujourd’hui" : j === 1 ? "arrivée hier" : "depuis " + j + " jours"; }
        function quand(ts) {
          var d = new Date(ts), n = new Date();
          if (d.toDateString() === n.toDateString()) return d.toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" }).replace(":", " h ");
          if (Date.now() - ts < 6 * JOUR) return d.toLocaleDateString("fr-FR", { weekday: "long" });
          return d.toLocaleDateString("fr-FR", { day: "numeric", month: "short" });
        }
        function dateLongue(iso) { if (!iso) return ""; var d = new Date(iso + "T12:00:00"); return isNaN(d) ? iso : d.toLocaleDateString("fr-FR", { day: "numeric", month: "long" }); }
        function nombre(n, un, plusieurs) { return n === 0 ? "aucune " + un : n === 1 ? "une " + un : n + " " + plusieurs; }
        function majuscule(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

        /* ————— Rendu ————— */
        function majLive() {
          var l = $("live");
          l.classList.toggle("on", S.connecte);
          l.lastChild.textContent = S.connecte ? "en direct" : "reconnexion…";
        }

        function rendre() {
          majLive();
          var cl = clientCourant();
          var fc = faceClient();
          document.body.classList.toggle("face-client", fc);
          majTitre();

          $("sous-titre").textContent = fc ? "votre tableau · " + (cl ? cl.nom : "") : "le tableau · " + (S.filtre === "tous" ? "toutes les places" : S.filtre === "semaine" ? "ma semaine" : cl ? cl.nom : "");
          var bar = $("apercu-bar");
          bar.hidden = !S.apercu;
          if (S.apercu && cl) {
            bar.textContent = "Aperçu — vous voyez le tableau comme " + (cl.contact || "votre client") + " le voit. Ses boutons sont inactifs ici.";
            bar.appendChild(bouton("Revenir à mon tableau", "", function () { S.apercu = false; rendre(); }));
          }

          var presence = $("presence");
          presence.textContent = "";
          if (!julien()) {
            if (S.enLigne.some(function (p) { return p.role === "julien"; })) presence.textContent = "Julien est en ligne";
          } else if (cl && !S.apercu) {
            var la = S.enLigne.filter(function (p) { return p.client === cl.id; }).map(function (p) { return p.nom; });
            if (la.length) presence.textContent = la.join(", ") + (la.length > 1 ? " sont" : " est") + " en ligne";
          }

          rendreFiltres();
          rendreOutils(cl);
          rendrePeriode(cl);
          rendreAide();
          var vue = modeVue();
          $("vue").hidden = !vue;
          $("board").hidden = !!vue;
          $("onglets").hidden = !!vue;
          if (vue) {
            $("projet").hidden = true;
            $("barre").hidden = true;
            if (vue === "tous") rendreEnsemble(); else rendreSemaine();
            return;
          }
          rendreProjet(cl);
          rendreBarre(cl);
          rendreColonnes(cl);
        }
        function majTitre() {
          var nouveaux = S.cartes.filter(function (c) { return c.nouveau === (julien() ? "julien" : "client"); }).length + nonLusTotal();
          document.title = (nouveaux ? "(" + nouveaux + ") " : "") + "Le tableau · Julien Tridat";
        }

        function majDebord(g) {
          if (!g.dataset.suivi) { g.dataset.suivi = "1"; g.addEventListener("scroll", function () { majDebord(g); }, { passive: true }); }
          var deborde = g.scrollWidth > g.clientWidth + 2;
          g.classList.toggle("deborde", deborde && g.scrollLeft + g.clientWidth < g.scrollWidth - 4);
        }
        window.addEventListener("resize", function () { ["f-ch", "f-mois", "onglets"].forEach(function (id) { var g = $(id); if (g) majDebord(g); }); });
        function rendreBarre(cl) {
          var visibles = cartesVisibles();
          $("barre").hidden = !visibles.length;
          // Chantiers : ceux de la place affichée — une place à la fois.
          var chantiers = cl ? cl.chantiers : [];
          if (S.f.ch && !chantiers.some(function (x) { return x.id === S.f.ch; })) S.f.ch = null;
          var fch = $("f-ch");
          fch.innerHTML = "";
          if (chantiers.length > 1) chantiers.forEach(function (x) {
            var n = visibles.filter(function (c) { return c.ch === x.id; }).length;
            if (!n) return;
            var b = el("button", "pill" + (S.f.ch === x.id ? " on" : ""));
            b.type = "button";
            var sw = el("span", "sw"); sw.style.background = "var(--" + x.couleur + ")";
            b.appendChild(sw); b.appendChild(document.createTextNode(x.nom));
            b.setAttribute("aria-pressed", S.f.ch === x.id ? "true" : "false");
            b.title = S.f.ch === x.id ? "Revenir à toute la mission" : "Ouvrir le projet";
            b.addEventListener("click", function () { S.f.ch = S.f.ch === x.id ? null : x.id; rendre(); window.scrollTo({ top: 0, behavior: "smooth" }); });
            fch.appendChild(b);
          });
          // Mois : ceux que portent les échéances, dans l'ordre de la période.
          var present = {};
          visibles.forEach(function (c) { var m = moisDe(c); if (m >= 0) present[m] = true; });
          var depart = cl && cl.debut ? new Date(cl.debut + "T12:00:00").getMonth() : new Date().getMonth();
          if (isNaN(depart)) depart = new Date().getMonth();
          var mois = Object.keys(present).map(Number).sort(function (a, b) { return ((a - depart + 12) % 12) - ((b - depart + 12) % 12); });
          if (S.f.mois !== null && !present[S.f.mois]) S.f.mois = null;
          var fm = $("f-mois");
          fm.innerHTML = "";
          if (mois.length > 1) mois.forEach(function (m) {
            var b = el("button", "pill" + (S.f.mois === m ? " on" : ""), MOIS_AFFICHE[m]);
            b.type = "button";
            b.setAttribute("aria-pressed", S.f.mois === m ? "true" : "false");
            b.addEventListener("click", function () { S.f.mois = S.f.mois === m ? null : m; rendre(); });
            fm.appendChild(b);
          });
          ["f-ch", "f-mois"].forEach(function (id) { majDebord($(id)); });
          var fst = $("f-st"), deplie = sousTachesDepliees();
          fst.hidden = !!S.f.ch || !visibles.some(function (c) { return c.st && c.st.length; });
          fst.classList.toggle("on", deplie);
          fst.setAttribute("aria-pressed", deplie ? "true" : "false");
          fst.title = deplie ? "Replier les sous-tâches" : "Afficher les sous-tâches sous chaque carte";
          var actif = filtreBarre();
          $("f-raz").hidden = !actif;
          var base = S.f.ch ? visibles.filter(function (c) { return c.ch === S.f.ch; }) : visibles;
          $("f-n").textContent = actif ? base.filter(passeFiltre).length + " sur " + base.length : "";
        }
        var rechercheT;
        $("f-q").addEventListener("input", function () {
          clearTimeout(rechercheT);
          rechercheT = setTimeout(function () { S.f.q = $("f-q").value; rendre(); }, 120);
        });
        $("f-q").addEventListener("keydown", function (e) { if (e.key === "Escape") { $("f-q").value = ""; S.f.q = ""; rendre(); } });
        $("f-raz").addEventListener("click", function () { S.f.mois = null; S.f.q = ""; $("f-q").value = ""; rendre(); });

        /* Les sous-tâches dépliées sous chaque carte : un bouton, retenu dans ce navigateur.
