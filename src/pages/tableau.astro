          S.msgs[m.client] = (m.messages || []).filter(function (x) { return !connus[x.id]; }).concat(fil).sort(function (a, b) { return (a.id || 1e15) - (b.id || 1e15); });
          if ((m.messages || []).length < 200) S.debutFil[m.client + "|" + (m.fil || "")] = true;
