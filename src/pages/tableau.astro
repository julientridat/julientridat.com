                var ul = el("ul", "st-liste");
                g.s.forEach(function (x) { ul.appendChild(ligneSousTache(g.c, x, "groupe")); });
                box.appendChild(ul);
              });
              wrap.appendChild(box);
            }
            if (!liste.length && !confiees.length) wrap.appendChild(el("p", "vide", filtreActif() ? "Rien avec ce filtre." : name === "vous" && fc ? "Rien ne vous attend." : name === "fait" ? "Rien de terminé pour l’instant." : "Rien pour l’instant."));

            if (name === "demandes") {
              var fold = colEl.querySelector(".folded");
              fold.innerHTML = "";
              var mensuel = visibles.filter(function (c) { return c.col === "mensuel"; });
              if (mensuel.length) {
                fold.appendChild(el("b", null, mensuel.length + " au point mensuel"));
                fold.appendChild(document.createTextNode((cl && cl.mensuel ? " (" + cl.mensuel + ")" : "") + " — "));
                mensuel.forEach(function (c, i) {
                  if (i) fold.appendChild(document.createTextNode(", "));
                  var b = el("button", null, c.t);
                  b.addEventListener("click", function () { ouvrirCarte(c.id); });
                  fold.appendChild(b);
                });
              }
            }
          });
          dejaVues = vuesCeRendu;
          rendreOnglets(fc, nombres);
        }

        /* Sur téléphone et tablette, une colonne à la fois : des onglets avec leur nombre, au lieu
           d'un défilement de côté qui cachait les autres colonnes (et laissait un grand vide sous
           la plus courte). Côté client, « Chez vous » d'abord : c'est là qu'il agit. */
        var NOM_ONGLET = { demandes: "Demandes", prevu: "Prévu", encours: "En cours", fait: "Fait" };
        function rendreOnglets(fc, nombres) {
          var nav = $("onglets");
          nav.innerHTML = "";
          var ordre = fc ? ["vous", "demandes", "prevu", "encours", "fait"] : ["demandes", "prevu", "encours", "vous", "fait"];
          var actif = S.colMobile && ordre.indexOf(S.colMobile) >= 0 ? S.colMobile : fc ? "vous" : "encours";
          ordre.forEach(function (col) {
            var b = el("button", "onglet" + (col === actif ? " on" : ""));
            b.type = "button";
            b.appendChild(document.createTextNode(col === "vous" ? (fc ? "Chez vous" : "Chez le client") : NOM_ONGLET[col]));
            b.appendChild(el("span", "nb", String(nombres[col] || 0)));
            b.setAttribute("aria-pressed", col === actif ? "true" : "false");
            b.addEventListener("click", function () {
              S.colMobile = col;
              rendreOnglets(fc, nombres);
              var y = nav.getBoundingClientRect().top - $("top").offsetHeight - 8;
              if (y < 0) window.scrollBy({ top: y, behavior: "smooth" });
            });
            nav.appendChild(b);
          });
          document.querySelectorAll("#board .column").forEach(function (k) { k.classList.toggle("actif", k.dataset.col === actif); });
          majDebord(nav);
        }

        function chip(txt, cls) { return el("span", "chip" + (cls ? " " + cls : ""), txt); }

        /* Côté client, « Prévu » se lit par mois : les mois passés, le mois en cours et le suivant
           ouverts, les autres repliés (un clic les ouvre). Julien garde sa liste d'un seul tenant. */
        function rendreParMois(wrap, liste, cl) {
          var debut = cl && cl.debut ? new Date(cl.debut + "T12:00:00").getMonth() : new Date().getMonth();
          if (isNaN(debut)) debut = new Date().getMonth();
          function rang(m) { return m < 0 ? 99 : (m - debut + 12) % 12; }
          var maintenant = rang(new Date().getMonth());
          var groupes = {};
          liste.forEach(function (c) { var m = moisDe(c); (groupes[m] = groupes[m] || []).push(c); });
          Object.keys(groupes).map(Number).sort(function (a, b) { return rang(a) - rang(b); }).forEach(function (m) {
            var cartes = groupes[m];
            var ouvert = S.moisOuverts[m] != null ? S.moisOuverts[m] : m < 0 || rang(m) <= maintenant + 1;
            var t = bouton((m < 0 ? "Sans mois" : MOIS_AFFICHE[m]) + " · " + cartes.length, "mois-t", function () { S.moisOuverts[m] = !ouvert; rendre(); });
            t.setAttribute("aria-expanded", ouvert ? "true" : "false");
            wrap.appendChild(t);
            if (ouvert) cartes.forEach(function (c) { wrap.appendChild(carteEl(c, { sansMois: m >= 0 })); });
          });
        }

        var dejaVues = {}, vuesCeRendu = {};
        function carteEl(c, opts) {
          var fc = faceClient();
          var e = el("article", "card");
          var trace = c.id + ":" + c.col;
          if (!dejaVues[trace]) e.classList.add("neuve");
          vuesCeRendu[trace] = true;
          e.style.setProperty("--mc", couleur(c));
          e.dataset.id = c.id;
          var h3 = el("h3");
          var titreCarte = el("button", "card-t", c.t);
          titreCarte.type = "button";
          h3.appendChild(titreCarte);
          e.appendChild(h3);
          var chips = el("div", "chips");
          var estNouveau = c.nouveau === roleVue();
          if (estNouveau) chips.appendChild(chip("nouveau", "neuf"));
          if (!fc && S.filtre === "tous") { var cl = clientParId(c.client); if (cl) chips.appendChild(chip(cl.nom, "client")); }
          var ch = chantier(c);
          if (ch && !S.f.ch) chips.appendChild(chip(ch.nom));
          if (c.col === "demandes" && c.type) chips.appendChild(chip(c.type));
          // Rangée sous l'en-tête de son mois, la carte ne répète pas « Octobre ».
          if (c.echeance && !(opts && opts.sansMois && MOIS.indexOf(sansAccent(c.echeance).trim().toLowerCase()) >= 0)) chips.appendChild(chip(c.echeance));
          if (c.date) chips.appendChild(chip(dateCourte(c.date), c.col !== "fait" && c.date < aujourdhui() ? "late" : ""));
          if (c.livrable) chips.appendChild(chip("livrable"));
          var st = c.st || [];
          if (st.length) { var faites = st.filter(function (x) { return x.ok; }).length; chips.appendChild(chip("✓ " + faites + "/" + st.length, faites === st.length ? "fini" : "etapes")); }
          var aLui = c.col === "fait" ? 0 : st.filter(function (x) { return !x.ok && coteClient(x.qui); }).length;
          if (aLui) chips.appendChild(chip(aLui + (fc ? " à vous" : " au client"), "vous"));
          if (st.some(function (x) { return enRetard(c, x); })) chips.appendChild(chip("sous-tâche en retard", "late"));
          if (c.col === "vous" && c.chezClientDepuis) {
            var j = jours(c.chezClientDepuis);
            // « nouveau » dit déjà « arrivée aujourd'hui ».
            if (!(estNouveau && j <= 0)) chips.appendChild(chip(depuis(c.chezClientDepuis) + (j > 5 ? " — en retard" : ""), j > 5 ? "late" : "vous"));
          }
          if (c.statut) chips.appendChild(chip(c.statut, "ok"));
          if (c.com && c.com.length) chips.appendChild(chip(c.com.length + " comm."));
          e.appendChild(chips);
          if (c.note) e.appendChild(el("p", "note", c.statut === "répondu" ? "« " + c.note + " »" : c.note));
          if (sousTachesDepliees() && st.length) {
            var liste = el("ul", "st-liste");
            st.forEach(function (x) { liste.appendChild(ligneSousTache(c, x, false)); });
            e.appendChild(liste);
          }

          if (c.col === "vous" && fc) e.appendChild(actionsClient(c, e));
          if (!fc && c.col === "demandes") {
            var a = el("div", "acts");
            a.appendChild(bouton("Prévoir", "btn btn-sm", function () { deplacer(c, "prevu"); }));
            a.appendChild(bouton("Point mensuel", "btn-ghost btn-sm", function () { deplacer(c, "mensuel"); toast("Gardée pour le point mensuel."); }));
            a.appendChild(bouton("Faire arbitrer", "btn-ghost btn-sm", function () { ouvrirCarte(c.id, true); }));
            e.appendChild(a);
          }
          if (!fc && c.col === "vous" && c.chezClientDepuis && jours(c.chezClientDepuis) > 5) {
            var r = el("div", "acts");
            r.appendChild(bouton("Relancer", "btn-ghost btn-sm", function () { op({ type: "carte.relancer", id: c.id }); toast("Relancée — la carte le dit chez le client. Envoyez-lui un mot avec le lien."); }));
            e.appendChild(r);
          }
          if (peutGlisser(c)) {
            e.classList.add("mobile");
            e.addEventListener("mousedown", function (ev) { preparerSouris(ev, c, e); });
            e.addEventListener("touchstart", function (ev) { preparerDoigt(ev, c, e); }, { passive: true });
            e.addEventListener("contextmenu", function (ev) { if (G || e.classList.contains("presse")) ev.preventDefault(); });
          }
          e.addEventListener("click", function () { if (Date.now() - dernierLacher < 400) return; ouvrirCarte(c.id); });
          return e;
        }
        /* ————— Sous-tâches ————— */
        function coteClient(qui) { return !!qui && qui !== "Julien"; }
        function deux(n) { return (n < 10 ? "0" : "") + n; }
        function aujourdhui() { var d = new Date(); return d.getFullYear() + "-" + deux(d.getMonth() + 1) + "-" + deux(d.getDate()); }
        function dateCourte(iso) { return iso ? new Date(iso + "T12:00:00").toLocaleDateString("fr-FR", { day: "numeric", month: "short" }) : ""; }
        function enRetard(c, x) { return !x.ok && !!x.date && x.date < aujourdhui() && c.col !== "fait"; }
        function idLocal() { return "n" + Date.now().toString(36).slice(-5) + Math.random().toString(36).slice(2, 5); }
        /* Julien coche tout ; le client, ce qui est confié à quelqu'un de chez lui. */
        function peutCocher(c, x) {
          if (S.apercu) return false;
          if (julien()) return true;
          var cl = clientParId(c.client);
          return !!cl && !cl.archive && coteClient(x.qui);
        }
        function cocher(c, x, ok) {
          if (!op({ type: "carte.cocher", id: c.id, st: x.id, ok: ok })) return false;
          x.ok = ok;
          rendre();
          if (feuille.mode === "carte" && feuille.id === c.id) refaireFeuille();
          if (!julien() && ok) toast("Cochée — Julien le voit à l’instant.");
          return true;
        }
        function dansJours(n) { var d = new Date(); d.setDate(d.getDate() + n); return d.getFullYear() + "-" + deux(d.getMonth() + 1) + "-" + deux(d.getDate()); }
        /* Une sous-tâche est « du moment » si sa carte avance (en cours, chez le client), ou si
           sa date tombe dans les deux semaines (ou est passée). Les autres attendent sur leur carte. */
        function duMoment(c, x) { return c.col === "encours" || c.col === "vous" || (!!x.date && x.date <= dansJours(14)); }
        /* Les sous-tâches ouvertes confiées au client, du moment, de la plus proche à la plus lointaine. */
        function tachesConfiees(cartes) {
          var out = [];
          cartes.forEach(function (c) {
            if (c.col === "fait" || c.col === "demandes") return;
            (c.st || []).forEach(function (x) { if (!x.ok && coteClient(x.qui) && duMoment(c, x)) out.push({ c: c, s: x }); });
          });
          return out.sort(function (a, b) { return (a.s.date || "9999") < (b.s.date || "9999") ? -1 : (a.s.date || "9999") > (b.s.date || "9999") ? 1 : 0; });
        }
        /* avecCarte : true = rappeler la carte sous la tâche ; "groupe" = la carte est déjà en titre au-dessus. */
        function ligneSousTache(c, x, avecCarte) {
          var li = el("li", x.ok ? "ok" : "");
          var clApercu = S.apercu ? clientParId(c.client) : null;
          var enApercu = !!clApercu && !clApercu.archive && coteClient(x.qui);
          if (peutCocher(c, x) || enApercu) {
            var cb = el("input");
            cb.type = "checkbox";
            cb.checked = x.ok;
            cb.id = "st-" + c.id.slice(0, 8) + "-" + x.id + (avecCarte ? "-v" : "");
            cb.setAttribute("aria-label", (x.ok ? "Rouvrir : " : "Fait : ") + x.t);
            // Cocher ne doit pas ouvrir la carte ; un clic sur le texte, lui, l'ouvre.
            cb.addEventListener("click", function (e) { e.stopPropagation(); });
            cb.addEventListener("change", function () {
              if (enApercu) { cb.checked = !cb.checked; return toast("Aperçu — c’est " + (clApercu.contact || "le client") + " qui coche ici."); }
              if (!cocher(c, x, cb.checked)) cb.checked = !cb.checked;
            });
            li.appendChild(cb);
          } else li.appendChild(el("span", "coche-fixe", x.ok ? "✓" : "○"));
          var t = el("span", "t", x.t);
          if (avecCarte === true) {
            t.appendChild(el("br"));
            t.appendChild(bouton(c.t, "parent", function () { ouvrirCarte(c.id); }));
          }
          li.appendChild(t);
          var meta = [];
          var aMoi = !julien() && S.me && x.qui === S.me.nom;
          if (x.qui && !(aMoi && avecCarte === "groupe")) meta.push(aMoi ? "vous" : x.qui);
          if (x.date) meta.push(dateCourte(x.date));
          if (meta.length) li.appendChild(el("span", "meta" + (enRetard(c, x) ? " retard" : coteClient(x.qui) ? " client" : ""), meta.join(" · ")));
          return li;
        }
        function personnesDe(cl) {
          var noms = ["Julien"];
          function ajouter(n) { if (n && noms.indexOf(n) < 0) noms.push(n); }
          if (cl) { ajouter(cl.contact); (cl.equipe || []).forEach(ajouter); S.acces.forEach(function (a) { if (a.client === cl.id) ajouter(a.nom); }); }
          return noms;
        }

        /* ————— Le sous-tableau d'un projet ————— */
        function chantierDe(cl, id) { for (var i = 0; cl && i < cl.chantiers.length; i++) if (cl.chantiers[i].id === id) return cl.chantiers[i]; return null; }
        function avancement(x) { return avancementDe(cartesVisibles().filter(function (c) { return c.ch === x.id; })); }
        /* Cartes faites et sous-tâches cochées, sur le total (les demandes n'en sont pas encore). */
        function avancementDe(cartes) {
          var fait = 0, total = 0;
          cartes.forEach(function (c) {
            if (c.col === "demandes" || c.col === "mensuel") return;
            var st = c.st || [];
            if (st.length) { total += st.length; fait += c.col === "fait" ? st.length : st.filter(function (k) { return k.ok; }).length; }
            else { total += 1; if (c.col === "fait") fait += 1; }
          });
          return { fait: fait, total: total, pct: total ? Math.round((fait / total) * 100) : 0 };
        }
        /* Ce qui a une date dans le projet : ses dates clés, et les sous-tâches datées. */
        function echeancesDe(x) {
          var out = [];
          (x.dates || []).forEach(function (d) { if (d.date) out.push({ date: d.date, t: d.t, cle: true }); });
          cartesVisibles().forEach(function (c) {
            if (c.ch !== x.id) return;
            if (c.date) out.push({ date: c.date, t: c.t, qui: c.col === "vous" ? "client" : "Julien", ok: c.col === "fait", retard: c.col !== "fait" && c.date < aujourdhui() });
            (c.st || []).forEach(function (k) { if (k.date) out.push({ date: k.date, t: k.t, qui: k.qui, ok: k.ok || c.col === "fait", retard: enRetard(c, k) }); });
          });
          return out.sort(function (a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
        }
        function rendreProjet(cl) {
          var p = $("projet");
          var x = cl ? chantierDe(cl, S.f.ch) : null;
          // Le panneau des dates clés reste ouvert d'un rendu à l'autre.
          var ouvert = p.querySelector(".pj-dates");
          if (ouvert) S.datesOuvertes = ouvert.open;
          p.hidden = !x;
          if (!x) { p.innerHTML = ""; delete p.dataset.sig; return; }
          var edite = julien() && !S.apercu;
          var a = avancement(x), dates = echeancesDe(x), auj = aujourdhui();
          // Rien n'a changé : on ne touche pas au DOM (un clic en cours n'est pas perdu).
          var sig = JSON.stringify([x, a, dates, edite, auj, cl.debut, cl.fin, cl.contact, S.acces.length]);
          if (p.dataset.sig === sig) return;
          p.dataset.sig = sig;
          p.innerHTML = "";
          p.style.setProperty("--pc", "var(--" + x.couleur + ")");
          var bloc = el("div", "pj");
          var h = el("div", "pj-h");
          var t = el("h2");
          t.appendChild(el("span", "sw"));
          t.appendChild(document.createTextNode(x.nom));
          h.appendChild(t);
          h.appendChild(bouton("‹ Toute la mission", "pj-retour", function () { S.f.ch = null; rendre(); }));
          bloc.appendChild(h);
          if (edite) {
            var obj = saisie("textarea", x.objectif, function (v) { majChantier(cl, x, { objectif: v }); }, "L’objectif du projet, en une phrase — le client le lit ici");
            obj.rows = 2;
            obj.className = "pj-objectif";
            obj.id = "pj-objectif";
            bloc.appendChild(obj);
          } else if (x.objectif) bloc.appendChild(el("p", "pj-objectif", x.objectif));

          var prochaine = dates.filter(function (d) { return d.date >= auj && !d.ok; })[0];
          var retards = dates.filter(function (d) { return d.retard; }).length;
          var av = el("div", "pj-avance");
          var jauge = el("div", "jauge"), trait = el("i");
          trait.style.width = a.pct + "%";
          jauge.appendChild(trait);
          av.appendChild(jauge);
          var ligne = el("p");
          ligne.appendChild(el("b", null, a.pct + " %"));
          ligne.appendChild(document.createTextNode(" — " + a.fait + " sur " + a.total + (a.total > 1 ? " tâches faites" : " tâche faite")));
          if (prochaine) ligne.appendChild(document.createTextNode(" · Prochaine échéance : " + prochaine.t + ", " + dateLongue(prochaine.date)));
          if (retards) { ligne.appendChild(document.createTextNode(" · ")); ligne.appendChild(el("span", "retard", nombre(retards, "sous-tâche", "sous-tâches") + " en retard")); }
          av.appendChild(ligne);
          bloc.appendChild(av);
          bloc.appendChild(frise(cl, x, dates));
          if (edite) bloc.appendChild(editeurDates(cl, x));
          p.appendChild(bloc);
        }
        function majChantier(cl, x, champs) { op({ type: "chantier.maj", client: cl.id, ch: x.id, champs: champs }); }

        /* La frise : la période de la mission, les mois, aujourd'hui, les dates clés au-dessus,
           les sous-tâches datées en points (violet : chez le client ; rouge : en retard). */
        function frise(cl, x, dates) {
          var boite = el("div", "frise-boite");
          var jalon = function (iso) { return new Date(iso + "T12:00:00").getTime(); };
          var bornes = dates.map(function (d) { return jalon(d.date); });
          if (cl.debut) bornes.push(jalon(cl.debut));
          if (cl.fin) bornes.push(jalon(cl.fin));
          if (!dates.length) {
            boite.appendChild(el("p", "frise-leg", julien() ? "Pas encore de date : ajoutez les dates clés du projet, ou datez des sous-tâches." : "Les dates clés du projet s’afficheront ici."));
            if (bornes.length < 2) return boite;
          }
          var t0 = Math.min.apply(null, bornes), t1 = Math.max.apply(null, bornes);
          if (t1 - t0 < 20 * JOUR) { t0 -= 10 * JOUR; t1 += 10 * JOUR; }
          var marge = (t1 - t0) * 0.03;
          t0 -= marge; t1 += marge;
          var pos = function (t) { return ((t - t0) / (t1 - t0)) * 100; };
          var zone = el("div", "frise"), dedans = el("div", "frise-in");
          dedans.appendChild(el("div", "axe"));
          if (cl.debut && cl.fin) {
            var du = el("div", "duree");
            du.style.left = pos(jalon(cl.debut)) + "%";
            du.style.width = pos(jalon(cl.fin)) - pos(jalon(cl.debut)) + "%";
            du.title = "La période : " + dateLongue(cl.debut) + " → " + dateLongue(cl.fin);
            dedans.appendChild(du);
          }
          var m = new Date(t0); m = new Date(m.getFullYear(), m.getMonth() + 1, 1);
          while (m.getTime() < t1) {
            var mo = el("span", "mois", m.toLocaleDateString("fr-FR", { month: "short" }) + (m.getMonth() === 0 ? " " + m.getFullYear() : ""));
            mo.style.left = pos(m.getTime()) + "%";
            dedans.appendChild(mo);
            m = new Date(m.getFullYear(), m.getMonth() + 1, 1);
          }
          var maintenant = Date.now();
          if (maintenant > t0 && maintenant < t1) {
            var au = el("div", "auj");
            au.style.left = pos(maintenant) + "%";
            au.appendChild(el("span", null, "aujourd’hui"));
            dedans.appendChild(au);
          }
          var n = 0;
          dates.forEach(function (d) {
            var x0 = pos(jalon(d.date));
            if (!d.cle) {
              var pt = el("span", "pt" + (d.retard ? " retard" : coteClient(d.qui) ? " client" : "") + (d.ok ? " ok" : ""));
              pt.style.left = x0 + "%";
              pt.title = d.t + (d.qui ? " — " + d.qui : "") + " — " + dateLongue(d.date) + (d.ok ? " (fait)" : "");
              dedans.appendChild(pt);
              return;
            }
            var point = el("span", "cle" + (d.date < aujourdhui() ? " passee" : ""));
            point.style.left = x0 + "%";
            point.title = d.t + " — " + dateLongue(d.date);
            dedans.appendChild(point);
            // Étiquettes alternées au-dessus et au-dessous, calées sur les bords.
            var etiq = el("span", "etiq " + (n++ % 2 ? "bas" : "haut"));
            etiq.appendChild(document.createTextNode(d.t));
            etiq.appendChild(el("small", null, dateLongue(d.date)));
            etiq.style.left = x0 + "%";
            etiq.style.transform = x0 < 10 ? "none" : x0 > 90 ? "translateX(-100%)" : "translateX(-50%)";
            dedans.appendChild(etiq);
          });
          zone.appendChild(dedans);
          boite.appendChild(zone);
          var leg = el("p", "frise-leg");
          [["cle", "date clé"], ["client", "chez le client"], ["", "chez Julien"]].forEach(function (l) {
            var s0 = el("span"); s0.appendChild(el("i", l[0])); s0.appendChild(document.createTextNode(l[1])); leg.appendChild(s0);
          });
          boite.appendChild(leg);
          return boite;
        }
        function editeurDates(cl, x) {
          var d = el("details", "pj-dates");
          d.open = !!S.datesOuvertes;
          d.addEventListener("toggle", function () { S.datesOuvertes = d.open; });
          var liste = (x.dates || []).map(function (k) { return { id: k.id, t: k.t, date: k.date }; });
          d.appendChild(el("summary", null, liste.length ? "Dates clés (" + liste.length + ") — modifier" : "Ajouter les dates clés du projet"));
          // Chaque geste repart de l'état du moment (un rendu venu de l'autre côté a pu le remplacer).
          function courant() { return chantierDe(clientParId(cl.id), x.id) || x; }
