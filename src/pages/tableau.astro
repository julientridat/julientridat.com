          var place = clientDuChat() ? clientParId(clientDuChat()) : null;
          C.fil = S.f.ch && chantierDe(place, S.f.ch) ? S.f.ch : "";
          C.ouvert = true;
          $("chat").hidden = false;
          $("fab").hidden = true;
          document.body.classList.add("chat-plein");
          ajusterClavier();
          rendreChat("bas");
          if (!tactile && clientDuChat()) chatTxt.focus();
        }
        function fermerChat() {
          C.ouvert = false;
          $("chat").hidden = true;
          $("fab").hidden = !S.recu;
          document.body.classList.remove("chat-plein");
          majFab();
        }
        $("fab").addEventListener("click", ouvrirChat);
        $("chat-x").addEventListener("click", fermerChat);
        $("chat-retour").addEventListener("click", function () { C.client = null; rendreChat(); });
        // En capture, pour passer avant la fermeture des feuilles : Échap ferme d'abord la feuille.
        document.addEventListener("keydown", function (e) { if (e.key === "Escape" && C.ouvert && !back.classList.contains("on")) fermerChat(); }, true);

        function envoyerMessage() {
          var id = clientDuChat(), v = chatTxt.value.trim();
          if (!id || !v) return;
          var tmp = "t" + Date.now() + "-" + ++C.tmp;
          if (!op({ type: "chat.envoyer", client: id, fil: C.fil, txt: v, tmp: tmp })) return;
          filDe(id).push({ id: 0, tmp: tmp, client: id, fil: C.fil, ts: Date.now(), role: S.me.role, qui: julien() ? "Julien" : S.me.nom, txt: v, attente: true });
          chatTxt.value = "";
          ajusterHauteur();
          rendreChat("bas");
        }
        function ajusterHauteur() { chatTxt.style.height = "auto"; chatTxt.style.height = Math.min(chatTxt.scrollHeight, 128) + "px"; }
        $("chat-saisie").addEventListener("submit", function (e) { e.preventDefault(); envoyerMessage(); chatTxt.focus(); });
        // Entrée envoie à l'ordinateur ; au téléphone, Entrée va à la ligne et la flèche envoie.
        chatTxt.addEventListener("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey && !tactile && !e.isComposing) { e.preventDefault(); envoyerMessage(); } });
        chatTxt.addEventListener("input", function () {
          ajusterHauteur();
          var id = clientDuChat();
          if (id && chatTxt.value.trim() && S.connecte && Date.now() - C.frappeEnvoyee > 2500) { C.frappeEnvoyee = Date.now(); op({ type: "chat.frappe", client: id, fil: C.fil }); }
        });
        /* Téléphone : la discussion épouse la partie visible, clavier ouvert. */
        function ajusterClavier() {
          var ch = $("chat"), vv = window.visualViewport;
          if (!vv || !C.ouvert || window.innerWidth > 700) { ch.style.height = ""; ch.style.top = ""; return; }
          ch.style.height = vv.height + "px";
          ch.style.top = vv.offsetTop + "px";
          var fil = $("chat-fil");
          fil.scrollTop = fil.scrollHeight;
        }
        if (window.visualViewport) { window.visualViewport.addEventListener("resize", ajusterClavier); window.visualViewport.addEventListener("scroll", ajusterClavier); }

        /* ————— Sur le téléphone : le tableau s'installe comme une app ————— */
        var invite = null;
        window.addEventListener("beforeinstallprompt", function (e) { e.preventDefault(); invite = e; });
        window.addEventListener("appinstalled", function () { invite = null; toast("Installé — le tableau est sur votre écran d’accueil."); });
        function surIphone() { return /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1); }
        function ouvrirInstallation() {
          ouvrirFeuille("installer");
          sheet.appendChild(el("p", "kicker", "Sur votre téléphone"));
          sheet.appendChild(el("h2", null, "Le tableau, comme une app"));
          sheet.appendChild(el("p", "desc", "Une icône sur l’écran d’accueil, le tableau s’ouvre en plein écran. Rien à télécharger, rien à payer, aucun compte à créer."));
          var f = el("div", "foot");
          if (invite) {
            f.appendChild(bouton("Installer", "btn", function () { invite.prompt(); invite.userChoice.then(function () { invite = null; fermer(); }); }));
          } else if (surIphone()) {
            var ol = el("ol", "pas");
            ol.appendChild(el("li", null, "Touchez « Copier mon lien », ci-dessous : l’app vous le demandera une seule fois."));
            ol.appendChild(el("li", null, "Touchez « Partager » (le carré avec une flèche vers le haut), puis « Sur l’écran d’accueil » et « Ajouter »."));
            ol.appendChild(el("li", null, "Ouvrez l’icône « Le tableau » et collez le lien."));
            sheet.appendChild(ol);
            f.appendChild(bouton("Copier mon lien", "btn", function () { copier(lienPour(S.cle), "Lien copié — collez-le à l’ouverture de l’app."); }));
          } else {
            sheet.appendChild(el("p", "desc", "Dans le menu du navigateur (⋮), choisissez « Installer l’application » ou « Ajouter à l’écran d’accueil »."));
          }
          f.appendChild(bouton("Fermer", "btn-ghost", fermer));
          sheet.appendChild(f);
        }
        $("coller").addEventListener("submit", function (e) {
          e.preventDefault();
          var v = $("coller-lien").value.trim(), m = v.match(/cle=([^&\s#]+)/);
          var k = m ? decodeURIComponent(m[1]) : /^[\w-]{16,200}$/.test(v) ? v : null;
          if (!k) { $("acces-texte").textContent = "Ce n’est pas un lien de tableau : il ressemble à julientridat.com/tableau#cle=…"; return; }
          try { localStorage.setItem(CLE_STOCK, k); } catch (x) {}
          S.cle = k;
          $("coller-lien").value = "";
          $("acces-texte").textContent = "Connexion…";
          essais = 0;
          connecter();
        });

        /* L'âge des cartes chez le client bouge avec le temps, même sans geste. */
        setInterval(function () { if (S.recu && !feuille.mode && !saisieEnCours() && !G) rendre(); }, 60000);

        $("reessayer").addEventListener("click", function () {
          $("acces-texte").textContent = "Connexion…";
          essais = 0;
          connecter();
        });

        S.cle = lireCle();
        if (!S.cle) montrerAcces();
        else connecter();
      })();
    </script>
  </body>
</html>
