        /* ————— Vue d'ensemble : une tuile par place ————— */
        function semaineDe(cl) {
          if (!cl || !cl.debut || !cl.fin) return null;
          var d = new Date(cl.debut + "T00:00:00").getTime(), f = new Date(cl.fin + "T23:59:59").getTime();
          if (!(f > d)) return null;
          var total = Math.max(1, Math.round((f - d) / (7 * JOUR)));
          return {
            avant: Date.now() < d,
            r: Math.max(0, Math.min(1, (Date.now() - d) / (f - d))),
            total: total,
            sem: Math.max(1, Math.min(total, Math.floor((Date.now() - d) / (7 * JOUR)) + 1)),
          };
        }
        function donneesPlace(cl) {
          var cartes = S.cartes.filter(function (c) { return c.client === cl.id; });
          var auj = aujourdhui(), prochaine = null, retards = 0, derniere = 0;
          function candidate(date, t) { if (date >= auj && (!prochaine || date < prochaine.date)) prochaine = { date: date, t: t }; }
          cl.chantiers.forEach(function (x) { (x.dates || []).forEach(function (d) { if (d.date) candidate(d.date, d.t); }); });
          cartes.forEach(function (c) {
            derniere = Math.max(derniere, c.majLe || 0);
            if (c.col === "fait") return;
            if (c.date) { if (c.date < auj) retards++; else candidate(c.date, c.t); }
            (c.st || []).forEach(function (k) { if (k.ok || !k.date) return; if (k.date < auj) retards++; else candidate(k.date, k.t); });
          });
          filDe(cl.id).forEach(function (m) { derniere = Math.max(derniere, m.ts || 0); });
          var chez = cartes.filter(function (c) { return c.col === "vous"; });
          var depuisLe = chez.reduce(function (m, c) { return c.chezClientDepuis && (!m || c.chezClientDepuis < m) ? c.chezClientDepuis : m; }, 0);
          return {
            aTraiter: cartes.filter(function (c) { return c.col === "demandes" || c.nouveau === "julien"; }).length,
            enCours: cartes.filter(function (c) { return c.col === "encours"; }).length,
            chez: chez.length,
            taches: tachesConfiees(cartes).length,
            attente: depuisLe ? jours(depuisLe) : 0,
            av: avancementDe(cartes),
            retards: retards,
            prochaine: prochaine,
            nonLus: nonLus(cl.id),
            enLigne: S.enLigne.filter(function (p) { return p.client === cl.id; }).map(function (p) { return p.nom; }),
            derniere: derniere,
          };
        }
        function rendreEnsemble() {
          var zone = $("vue");
          zone.innerHTML = "";
          var places = S.clients.filter(function (c) { return !c.archive; }).map(function (cl) { return { cl: cl, d: donneesPlace(cl) }; });
          if (!places.length) return zone.appendChild(el("p", "vue-vide", "Aucune place pour l’instant : ouvrez la première avec « Nouvelle place »."));
          // Ce qui demande Julien d'abord : retards, retours à traiter, messages, attente longue chez le client.
          function score(x) { return x.d.retards * 4 + x.d.aTraiter * 3 + x.d.nonLus * 2 + (x.d.attente > 5 ? 2 : 0); }
          places.sort(function (a, b) { return score(b) - score(a) || a.cl.nom.localeCompare(b.cl.nom, "fr"); });
          var grille = el("div", "tuiles");
          places.forEach(function (x) { grille.appendChild(tuile(x.cl, x.d)); });
          zone.appendChild(grille);
        }
        function tuile(cl, d) {
          var t = el("article", "tuile" + (d.retards ? " urgente" : ""));
          t.tabIndex = 0;
          t.setAttribute("role", "link");
          t.setAttribute("aria-label", "Ouvrir le tableau de " + cl.nom);
          function ouvrir() { S.filtre = cl.id; rendre(); window.scrollTo(0, 0); }
          t.addEventListener("click", ouvrir);
          t.addEventListener("keydown", function (e) { if (e.key === "Enter") ouvrir(); });
          var h = el("div", "t-h");
          h.appendChild(el("h2", null, cl.nom));
          if (d.enLigne.length) h.appendChild(el("small", null, d.enLigne.join(", ") + (d.enLigne.length > 1 ? " en ligne" : " en ligne")));
          t.appendChild(h);
          var sem = semaineDe(cl);
          if (sem) t.appendChild(el("p", "t-periode", (sem.avant ? "Démarrage le " + dateLongue(cl.debut) : "Semaine " + sem.sem + " sur " + sem.total) + " · jusqu’au " + dateLongue(cl.fin)));
          var jauge = el("div", "jauge"), trait = el("i");
          trait.style.width = d.av.pct + "%";
          jauge.appendChild(trait);
          t.appendChild(jauge);
          var av = el("p", "t-av");
          av.appendChild(el("b", null, d.av.pct + " %"));
          av.appendChild(document.createTextNode(" — " + d.av.fait + " sur " + d.av.total + (d.av.total > 1 ? " tâches faites" : " tâche faite")));
          t.appendChild(av);
          var dl = el("dl", "t-chiffres");
          [["À traiter", d.aTraiter, ""], ["En cours", d.enCours, ""], ["Chez " + (cl.contact || "le client"), d.chez, d.taches ? "+ " + nombre(d.taches, "tâche", "tâches") : "", "vous"]].forEach(function (k) {
            var b = el("div", k[3] || "");
            b.appendChild(el("dt", null, k[0]));
            var dd = el("dd", null, String(k[1]));
            if (k[2]) { dd.appendChild(document.createTextNode(" ")); dd.appendChild(el("small", null, k[2])); }
            b.appendChild(dd);
            dl.appendChild(b);
          });
          t.appendChild(dl);
          if (d.prochaine) t.appendChild(el("p", "t-suite", "Prochaine échéance : " + d.prochaine.t + ", " + dateLongue(d.prochaine.date)));
          var chips = el("div", "chips");
          if (d.retards) chips.appendChild(chip(d.retards > 1 ? d.retards + " retards" : "1 retard", "late"));
          if (d.nonLus) chips.appendChild(chip(d.nonLus + (d.nonLus > 1 ? " messages non lus" : " message non lu"), "vous"));
          if (d.attente > 5) chips.appendChild(chip("attend " + (cl.contact || "le client") + " depuis " + d.attente + " jours", "late"));
          if (chips.childNodes.length) t.appendChild(chips);
          if (d.derniere) t.appendChild(el("p", "t-activite", "Dernière activité : " + quand(d.derniere)));
          return t;
        }

        /* ————— Ma semaine : tout ce qui est à Julien, toutes places confondues ————— */
        function finDeSemaine() { var d = new Date(); d.setDate(d.getDate() + ((7 - d.getDay()) % 7)); return d.getFullYear() + "-" + deux(d.getMonth() + 1) + "-" + deux(d.getDate()); }
        function maSemaine() {
          var auj = aujourdhui(), dimanche = finDeSemaine();
          var sections = { traiter: [], retard: [], auj: [], semaine: [], plusTard: [], sansDate: [] };
          S.cartes.forEach(function (c) {
            var cl = clientParId(c.client);
            if (!cl || cl.archive) return;
            var retour = c.nouveau === "julien";
            if (retour) sections.traiter.push({ c: c });
            var items = [];
            if (!retour && (c.col === "encours" || (c.col === "prevu" && c.date))) items.push({ c: c, date: c.date || "" });
            if (c.col !== "fait") (c.st || []).forEach(function (k) { if (!k.ok && k.qui === "Julien" && (k.date || c.col === "encours" || c.col === "vous")) items.push({ c: c, s: k, date: k.date || "" }); });
            items.forEach(function (it) {
              var d = it.date;
              (!d ? sections.sansDate : d < auj ? sections.retard : d === auj ? sections.auj : d <= dimanche ? sections.semaine : sections.plusTard).push(it);
            });
          });
          ["retard", "auj", "semaine", "plusTard"].forEach(function (k) { sections[k].sort(function (a, b) { return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; }); });
          sections.urgent = sections.traiter.length + sections.retard.length + sections.auj.length;
          sections.aFaire = sections.urgent + sections.semaine.length;
          return sections;
        }
        function rendreSemaine() {
          var zone = $("vue");
          zone.innerHTML = "";
          var m = maSemaine(), bloc = el("div", "semaine"), rien = true;
          [["traiter", "À traiter — ce que vos clients ont fait"], ["retard", "En retard"], ["auj", "Aujourd’hui"], ["semaine", "Cette semaine"], ["plusTard", "Plus tard"], ["sansDate", "En cours, sans date"]].forEach(function (k) {
            var liste = m[k[0]];
            if (!liste.length) return;
            rien = false;
            var sec = el("section", "sec-" + k[0]);
            var h = el("h2", null, k[1]);
            h.appendChild(el("span", "n", String(liste.length)));
            sec.appendChild(h);
            var ul = el("ul", "sem-liste");
            liste.forEach(function (it) { ul.appendChild(ligneSemaine(it, k[0])); });
            sec.appendChild(ul);
            bloc.appendChild(sec);
          });
          if (rien) bloc.appendChild(el("p", "vue-vide", "Rien ne vous attend : ni retour à traiter, ni tâche datée."));
          zone.appendChild(bloc);
        }
        function ligneSemaine(it, section) {
          var c = it.c, k = it.s, cl = clientParId(c.client), ch = chantier(c);
          var li = el("li");
          li.style.setProperty("--mc", couleur(c));
