  <Reveal />

  <script type="application/json" id="fi-spectre" set:html={JSON.stringify(SPECTRE)} />

  <script>
    /* Le contenu du spectre voyage en JSON dans le DOM : il faut donc le
       retyper à l'arrivée, JSON.parse ne rendant que du `any`. */
    type ItemSpectre = { t: string; d?: string };
    type AxeSpectre = {
      id: string;
      onglet: string;
      question: string;
      type: string;
      items: ItemSpectre[];
    };

    const source = document.getElementById("fi-spectre");
    const question = document.getElementById("sp-question");
    const corps = document.getElementById("sp-corps");

    // Les trois éléments sont vérifiés ici plutôt qu'à chaque usage : ce sont
    // des `const`, la restriction de type tient donc jusque dans les closures.
    if (source && question && corps) {
      const SPECTRE: AxeSpectre[] = JSON.parse(source.textContent || "[]");

      const rendre = (id: string) => {
        const axe = SPECTRE.find((a) => a.id === id);
        if (!axe) return;
        question.textContent = axe.question;

        if (axe.type === "etiquettes") {
          corps.className = "mt-6 flex flex-wrap gap-2.5";
          corps.innerHTML = axe.items
            .map(
              (i) =>
                `<span class="rounded-full border border-line bg-card px-4 py-2 text-[15px] text-ink-2">${i.t}</span>`,
            )
            .join("");
        } else {
          corps.className = "mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3";
          corps.innerHTML = axe.items
            .map(
              (i) =>
                `<div class="rounded-2xl border border-line bg-card p-5"><div class="text-[17px] font-medium text-foreground">${i.t}</div><p class="mt-2 text-[15px] leading-relaxed text-ink-2">${i.d ?? ""}</p></div>`,
            )
            .join("");
        }
      };

      // querySelectorAll<HTMLElement> : sur un Element nu, `dataset` n'existe pas.
      const onglets = document.querySelectorAll<HTMLElement>("[data-spectre-onglet]");
      onglets.forEach((btn) => {
        btn.addEventListener("click", () => {
          onglets.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          const val = btn.dataset.val;
          if (val) rendre(val);
        });
      });

      if (SPECTRE.length > 0) rendre(SPECTRE[0].id);
    }
  </script>

  <script>
    /* Le dossier : les huit pièces se décochent, puis se cochent une à une
       (0,45 s chacune) jusqu'à « Dossier complet », puis la boucle reprend.
       Tourne seulement à l'écran ; figé et complet en mouvement réduit. */
    const dossier = document.getElementById("dossier");
    const compte = document.getElementById("dossier-compte");
    const reduitD = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (dossier && compte && !reduitD) {
      const pieces = [...dossier.querySelectorAll<HTMLElement>(".dossier-piece")];
      const statut = document.getElementById("dossier-statut") as HTMLElement;
      let visibleD = false;
      let n = pieces.length;
      const peindre = () => {
        pieces.forEach((p, i) => {
          const c = p.querySelector(".dossier-coche") as HTMLElement;
          const fait = i < n;
          c.classList.toggle("bg-lime", fait);
          c.classList.toggle("text-white", fait);
          c.classList.toggle("bg-line", !fait);
          c.classList.toggle("text-transparent", !fait);
          p.classList.toggle("text-ink-3", !fait);
          p.classList.toggle("border-lime/40", fait && i === n - 1);
        });
        compte.textContent = `${n}\u00a0/\u00a0${pieces.length}`;
        statut.style.opacity = n === pieces.length ? "1" : "0.35";
      };
      new IntersectionObserver((e) => { visibleD = e.some((x) => x.isIntersecting); }, { threshold: 0.3 }).observe(dossier);
      let pauseFin = 0;
      window.setInterval(() => {
        if (!visibleD || document.hidden) return;
        if (n === pieces.length) {
          if (++pauseFin < 5) return;
          pauseFin = 0;
          n = 0;
        } else {
          n += 1;
        }
        peindre();
      }, 450);
    }
  </script>
