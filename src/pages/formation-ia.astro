            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------ Cadre admin */}
    <section class="border-b border-white/10 bg-[oklch(0.185_0.009_70)] px-6 py-24 md:px-12 md:py-28">
      <div class="mx-auto max-w-7xl">
        <Eyebrow>Cadre administratif &amp; pratique</Eyebrow>
        <h2 class="max-w-4xl text-[clamp(1.8rem,4vw,3rem)] font-light leading-[1.08] tracking-[-0.03em]">
          Tout ce qu'il vous faut
          <br />
          <em class="text-lime">pour me référencer.</em>
        </h2>

        <div class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-white/10 md:grid-cols-2">
          <dl class="space-y-6 bg-background p-8 md:p-10">
            <div class="text-[11px] uppercase tracking-[0.22em] text-lime">Identité</div>
            {[
              ["Intervenant", "Julien Tridat — consultant et formateur IA"],
              ["Forme juridique", v(ADMIN.formeJuridique)],
              ["SIRET", v(ADMIN.siret)],
              [
                "Déclaration d'activité",
                `${v(ADMIN.nda)} — préfecture de région ${ADMIN.ndaRegion}`,
              ],
              [
                "Certification Qualiopi",
                "Non détenue en propre. Intervention en sous-traitance sous la certification du centre.",
              ],
              ["Responsabilité civile professionnelle", v(ADMIN.rcPro)],
            ].map(([k, val]) => (
              <div class="grid gap-1 border-b border-white/10 pb-5 last:border-0 last:pb-0 sm:grid-cols-[13rem_1fr] sm:gap-4">
                <dt class="text-[13px] text-white/50">{k}</dt>
