    </section>

    <Footer />
  </main>

  <script type="application/json" id="fi-config" set:html={JSON.stringify(CONFIG)} />

  <script>
    const el = document.getElementById("fi-config");
    if (el) {
      const { MODULES, DUREES, FORMATS, GRILLES, EVALUATION, LIVRABLES_SOCLE } = JSON.parse(
        el.textContent || "{}",
      );

      const etat = { module: "socle", duree: "jour", format: "presentiel" };
      const par = (liste, id) => liste.find((x) => x.id === id);

      /** Assemble les lignes du séquençage : horaires réels + contenu du module. */
      function lignes(mod, duree) {
        const seqs = mod.sequences.slice(0, duree.nb);
        const grille = duree.id === "deux" ? [...GRILLES.jour, ...GRILLES.jour] : GRILLES[duree.id];
        const rows = [];
        let i = 0;
        let jour = 1;

        grille.forEach((creneau, idx) => {
          if (duree.id === "deux" && idx === GRILLES.jour.length) {
            jour = 2;
            rows.push({ type: "jour", horaire: "Journée 2" });
          }
          if (creneau.startsWith("PAUSE:")) {
            rows.push({ type: "pause", horaire: creneau.slice(6), label: "Pause" });
          } else if (creneau.startsWith("DEJEUNER:")) {
            rows.push({ type: "pause", horaire: creneau.slice(9), label: "Déjeuner" });
          } else {
            const s = seqs[i++];
            if (s) rows.push({ type: "seq", horaire: creneau, ...s });
          }
        });

        // La dernière séquence porte toujours l'évaluation de fin.
        const derniere = [...rows].reverse().find((r) => r.type === "seq");
        if (derniere && !derniere.moyens.includes("Quiz")) {
          derniere.moyens += " Quiz de fin de formation et tour de table des priorités.";
        }
        if (duree.id === "deux" && jour === 2) rows.unshift({ type: "jour", horaire: "Journée 1" });
        return rows;
      }

      function objectifs(mod, duree) {
        return mod.sequences.slice(0, duree.nb).map((s) => s.objectif);
      }

      function prerequis(mod) {
        return (
          mod.public +
          " Chaque participant doit disposer d'un poste connecté et d'un accès ouvert à l'outil retenu avant le démarrage."
        );
      }

      function livrables(mod, duree) {
        const out = [...LIVRABLES_SOCLE, ...mod.livrables];
        if (duree.id !== "demi") {
          out.push("Les assistants construits en séance, exportables et partageables");
        }
        if (duree.id === "deux") {
          out.push(
            "Une matrice de cas d'usage par métier : tâche, outil, licence, règle de confidentialité",
          );
          out.push("Une note de recommandations écrite au commanditaire, remise après la session");
        }
        return out;
      }

      function rendre() {
        const mod = par(MODULES, etat.module);
        const duree = par(DUREES, etat.duree);
        const format = par(FORMATS, etat.format);

        document.getElementById("p-ref").textContent =
          `JT-${mod.code}-${duree.code}-${format.code}`;
        document.getElementById("p-titre").textContent = mod.titre;
        document.getElementById("p-accroche").textContent = mod.accroche;
        document.getElementById("p-volume").textContent = duree.detail;
        document.getElementById("p-modalite").textContent = format.label;
        document.getElementById("p-effectif").textContent = format.effectif;
        document.getElementById("p-public").textContent = mod.public;
        document.getElementById("p-prerequis").textContent = prerequis(mod);
        document.getElementById("p-moyens").textContent = format.modalites;

        const puce = (t) =>
          `<li class="flex gap-3"><span class="mt-[0.55em] h-1 w-1 shrink-0 rounded-full bg-lime"></span><span>${t}</span></li>`;

        document.getElementById("p-objectifs").innerHTML = objectifs(mod, duree)
          .map(puce)
          .join("");
        document.getElementById("p-evaluation").innerHTML = EVALUATION[duree.id]
          .map(puce)
          .join("");
        document.getElementById("p-livrables").innerHTML = livrables(mod, duree)
          .map(puce)
          .join("");

        document.getElementById("p-sequences").innerHTML = lignes(mod, duree)
          .map((r) => {
            if (r.type === "jour") {
              return `<tr><td colspan="4" class="pt-7 pb-2 text-[11px] uppercase tracking-[0.22em] text-lime">${r.horaire}</td></tr>`;
            }
            if (r.type === "pause") {
              return `<tr class="border-b border-white/[0.06] text-white/35"><td class="py-2.5 pr-4 font-mono text-[12px] whitespace-nowrap">${r.horaire}</td><td class="py-2.5 pr-4 italic">${r.label}</td><td></td><td></td></tr>`;
            }
            return `<tr class="border-b border-white/10 align-top">
              <td class="py-4 pr-4 font-mono text-[12px] whitespace-nowrap text-lime/80">${r.horaire}</td>
              <td class="py-4 pr-4 text-white/90">${r.theme}</td>
              <td class="py-4 pr-4 text-white/60">${r.moyens}</td>
              <td class="py-4 text-white/60">${r.objectif}</td>
            </tr>`;
          })
          .join("");
      }

      /** Version texte brut, pour le presse-papier. */
      function versTexte() {
        const mod = par(MODULES, etat.module);
        const duree = par(DUREES, etat.duree);
        const format = par(FORMATS, etat.format);
        const L = [];
        L.push(`PROGRAMME DE FORMATION — JT-${mod.code}-${duree.code}-${format.code}`);
        L.push(mod.titre.toUpperCase());
        L.push("");
        L.push(`Volume : ${duree.detail}`);
        L.push(`Modalité : ${format.label}`);
        L.push(`Effectif conseillé : ${format.effectif}`);
        L.push("");
        L.push("PUBLIC VISÉ ET PRÉREQUIS");
        L.push(prerequis(mod));
        L.push("");
        L.push("OBJECTIFS PÉDAGOGIQUES VISÉS");
        objectifs(mod, duree).forEach((o) => L.push(`- ${o}`));
        L.push("");
        L.push("SÉQUENÇAGE");
        lignes(mod, duree).forEach((r) => {
          if (r.type === "jour") L.push(`\n${r.horaire.toUpperCase()}`);
          else if (r.type === "pause") L.push(`${r.horaire}  ${r.label}`);
          else L.push(`${r.horaire}  ${r.theme}\n    Méthodes & outils : ${r.moyens}\n    Objectif : ${r.objectif}`);
        });
        L.push("");
        L.push("MOYENS PÉDAGOGIQUES ET TECHNIQUES");
        L.push(format.modalites);
        L.push("");
        L.push("MODALITÉS D'ÉVALUATION");
        EVALUATION[duree.id].forEach((e) => L.push(`- ${e}`));
        L.push("");
        L.push("LIVRABLES REMIS");
        livrables(mod, duree).forEach((l) => L.push(`- ${l}`));
        L.push("");
        L.push("ACCESSIBILITÉ");
        L.push(
          "Besoin d'adaptation recueilli au questionnaire de positionnement ; adaptation arbitrée avec le référent handicap de l'organisme avant la session.",
        );
        L.push("");
        L.push("Trame type — s'ajuste au public, aux outils et aux contraintes lors du cadrage.");
        L.push("Julien Tridat — julientridat.com");
        return L.join("\n");
      }

      document.querySelectorAll("[data-fi-choix]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const axe = btn.dataset.axe;
          etat[axe] = btn.dataset.val;
          document
            .querySelectorAll(`[data-axe="${axe}"]`)
            .forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          rendre();
        });
      });

      const copier = document.getElementById("p-copier");
      const repli = document.getElementById("p-repli");
      const zoneTexte = document.getElementById("p-texte");

      copier?.addEventListener("click", async () => {
        const texte = versTexte();
        try {
          await navigator.clipboard.writeText(texte);
          repli.hidden = true;
          copier.textContent = "Copié ✓";
          setTimeout(() => (copier.textContent = "Copier le programme"), 2000);
        } catch {
          // Presse-papier refusé (permission, contexte non sécurisé) : on rend
          // le texte récupérable à la main plutôt que de laisser l'utilisateur bloqué.
          zoneTexte.value = texte;
          repli.hidden = false;
          zoneTexte.focus();
          zoneTexte.select();
          copier.textContent = "Copiez ci-dessous ↓";
          setTimeout(() => (copier.textContent = "Copier le programme"), 4000);
        }
      });

      document.getElementById("p-imprimer")?.addEventListener("click", () => window.print());

      rendre();
    }
  </script>

  <style is:global>
    /* Impression : seul le programme sort, en noir sur blanc. */
    @media print {
      body {
        background: #fff !important;
      }
      body * {
        visibility: hidden !important;
      }
      #programme,
      #programme * {
        visibility: visible !important;
      }
      #programme {
        position: absolute;
        inset: 0;
        margin: 0;
        border: 0 !important;
        border-radius: 0 !important;
      }
      #programme * {
        color: #000 !important;
        background: transparent !important;
        border-color: #bbb !important;
      }
      #programme table {
        min-width: 0 !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</BaseLayout>
