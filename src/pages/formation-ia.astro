---
/**
 * Fiche formateur — page volontairement NON INDEXÉE et NON LIÉE.
 *
 * Destinataire : responsable pédagogique / dirigeant d'un organisme ou centre de
 * formation professionnelle, à qui Julien envoie l'URL directement.
 *
 * « Cachée » = trois choses, réunies ici :
 *   1. aucun `canonical` transmis à BaseLayout → <meta name="robots" content="noindex">
 *   2. absente de `src/pages/sitemap.xml.ts` et de `src/pages/llms.txt.ts`
 *   3. aucun lien depuis Nav.astro / Footer.astro
 * Pour la rendre publique : passer `canonical` et ajouter l'entrée au sitemap.
 *
 * Parti pris éditorial : page courte, ton sobre, première personne. L'argument
 * est l'ÉTENDUE de l'expérience (du comité de direction à l'équipe de TPE, tous
 * secteurs) — elle se démontre en laissant le lecteur chercher son propre public
 * dans le spectre, jamais en la revendiquant.
 *
 * Règle éditoriale du dépôt : aucun chiffre invérifiable. Tout est adossé aux
 * études de cas publiées, aux références déjà nommées sur la page d'accueil, ou
 * aux déroulés réellement livrés. Les données administratives inconnues sont
 * nulles ci-dessous et s'affichent « [À VALIDER] ».
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import Footer from "@/components/Footer.astro";

const title = "Fiche formateur IA — Julien Tridat | Intervenant pour organismes de formation";
const description =
  "Formateur IA générative depuis trois ans, des comités de direction aux équipes de terrain. Intervention en sous-traitance pour organismes de formation. Bordeaux et national.";

/* ------------------------------------------------------------------ *
 * Données administratives — À COMPLÉTER PAR JULIEN AVANT DIFFUSION.
 * Tant qu'une valeur vaut null, la fiche affiche « [À VALIDER] ».
 * ------------------------------------------------------------------ */
const ADMIN = {
  formeJuridique: null as string | null,
  siret: null as string | null,
  /** N° de déclaration d'activité de formateur (préfecture de région). */
  nda: null as string | null,
  ndaRegion: "Nouvelle-Aquitaine",
  /** Assureur + n° de police de la RC professionnelle. */
  rcPro: null as string | null,
  /** Délai entre l'accord et la première session. */
  delaiAcces: null as string | null,
};
const v = (x: string | null) => x ?? "[À VALIDER]";

/* ------------------------------------------------------------------ *
 * Le spectre — la seule mécanique de la page.
 * Quatre axes, une seule bande à l'écran : le lecteur y cherche SON public.
 * ------------------------------------------------------------------ */
const SPECTRE = [
  {
    id: "taille",
    onglet: "Par taille",
    question: "Quelle taille d'organisation ?",
    type: "cartes",
    items: [
      {
        t: "Groupes internationaux",
        d: "Équipes siège d'un groupe de travel retail, enseigne de plus de 600 points de vente, environnements verrouillés par la direction informatique et licences hétérogènes.",
      },
      {
        t: "ETI et grands comptes",
        d: "Dassault Systèmes, SNCF Fret, un réseau de conseil de plusieurs centaines d'experts.",
      },
      {
        t: "PME et agences",
        d: "Agences de communication et de création, cabinets de conseil, maisons de vin et de spiritueux, franchises.",
      },
      {
        t: "TPE et indépendants",
        d: "Artisans, professions libérales, commerces, dirigeants sans service informatique ni service marketing derrière eux.",
      },
    ],
  },
  {
    id: "niveau",
    onglet: "Par niveau",
    question: "Quel niveau dans l'organisation ?",
    type: "cartes",
    items: [
      {
        t: "Comités de direction",
        d: "Sessions stratégiques avec le dirigeant, cadrage de la gouvernance, arbitrage des priorités. Et des keynotes devant des comités et des clubs de dirigeants.",
      },
      {
        t: "Encadrement et chefs de projet",
        d: "Où l'IA entre dans le processus, qui devient propriétaire de quoi, et ce qu'on décide de ne pas automatiser.",
      },
      {
        t: "Équipes opérationnelles",
        d: "Celles qui produisent tous les jours — sur leurs propres dossiers, leurs propres fichiers, leurs propres contraintes d'outil.",
      },
    ],
  },
  {
    id: "metier",
    onglet: "Par métier",
    question: "Quel métier dans la salle ?",
    type: "cartes",
    items: [
      {
        t: "Marketing et communication",
        d: "Contenus, déclinaison de supports à l'échelle d'un réseau, brief de création, plan éditorial, charte maison encodée dans l'assistant.",
      },
      {
        t: "Commercial et développement",
        d: "Propositions, argumentaires, relances, prospection personnalisée, veille marché.",
      },
      {
        t: "Administration et fonctions support",
        d: "Comptes-rendus, courriers, synthèses, suivi de dossiers, pilotage de projet.",
      },
      {
        t: "Direction et stratégie",
        d: "Feuille de route, règles d'usage internes, visibilité de la marque dans les réponses des IA.",
      },
      {
        t: "Métiers en secteur réglementé",
        d: "Sourcing restreint aux autorités de référence, validation humaine préservée, périmètre autorisé par la direction informatique.",
      },
    ],
  },
  {
    id: "secteur",
    onglet: "Par secteur",
    question: "Quel secteur ?",
    type: "etiquettes",
    items: [
      { t: "Agences de communication et de création" },
      { t: "Vin et spiritueux" },
      { t: "Santé et communication médicale" },
      { t: "Retail et réseaux de points de vente" },
      { t: "BTP" },
      { t: "Industrie" },
      { t: "Transport et logistique" },
      { t: "Conseil et formation professionnelle" },
      { t: "Immobilier" },
      { t: "Banque et finance" },
      { t: "Associations et réseaux d'affaires" },
    ],
  },
];

/** Artefacts réels, anonymisés, déjà publiés sur le site. La preuve tient au lien. */
const ARTEFACTS = [
  {
    titre: "Un support de formation",
    detail:
      "Le support « IA & Texte » d'une mission en agence santé, en défilement plutôt qu'en diapositives mortes.",
    url: "/demos/deck-formation/",
    lien: "Parcourir le support",
  },
  {
    titre: "Un support de grand groupe",
    detail:
      "Le support d'un parcours déployé par vagues auprès des équipes siège d'un groupe international.",
    url: "/demos/support-groupe-retail.html",
    lien: "Dérouler le support",
  },
  {
    titre: "Un guide d'autonomie",
    detail:
      "Six niveaux de progression sur un outil de gestion de projet : à chaque palier, la commande, le résultat attendu, le piège à éviter.",
    url: "/demos/guide-claude-clickup.html",
    lien: "Parcourir le guide",
  },
];

const MODES = [
  {
    titre: "J'anime, vous vendez",
    texte:
      "Vous portez la convention, le financement et la relation client. J'interviens comme formateur et je vous rends le dossier complet. C'est déjà mon mode de travail avec trois organismes.",
  },
  {
    titre: "On construit votre offre IA",
    texte:
      "Vous voulez ouvrir l'IA à votre catalogue sans savoir par quel segment commencer. On mesure, on score les cibles, on écrit les programmes, et vous gardez la méthode pour ouvrir les suivants.",
  },
  {
    titre: "J'interviens sur vos événements",
    texte:
      "Petits-déjeuners prescripteurs, salons, clubs clients. Je construis un livrable réel devant la salle plutôt que d'exposer le potentiel de l'IA.",
  },
];

/** Verbatims déjà publiés sur la page d'accueil — participants de sessions réelles. */
const VERBATIMS = [
  [
    "Un accompagnement orienté sur les spécificités de nos métiers, parfaitement ajusté à nos besoins.",
    "Aurélie M., consultante",
  ],
  [
    "Julien a su adapter le programme à notre métier tout en apportant des exemples concrets et des cas pratiques pertinents.",
    "Daphné G., consultante",
  ],
];
---

<BaseLayout title={title} description={description}>
  <main class="bg-background text-foreground">
    {/* ---------------------------------------------------------------- Hero */}
    <header class="relative overflow-hidden border-b border-white/10 px-6 pb-16 pt-36 md:px-12 md:pb-20 md:pt-44">
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background: radial-gradient(720px 400px at 18% 0%, oklch(0.92 0.21 125 / 0.07), transparent 70%);"
      >
      </div>
      <Nav />
      <div class="mx-auto max-w-7xl">
        <Eyebrow>Fiche formateur — organismes de formation</Eyebrow>
        <h1 class="max-w-4xl text-[clamp(2.2rem,5.2vw,4rem)] font-light leading-[1.04] tracking-[-0.03em]">
          Je forme à l'IA générative depuis trois ans.
          <br class="hidden sm:block" />
          <em class="text-lime">Des comités de direction aux équipes de terrain.</em>
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-white/75">
          Grands groupes, ETI, PME, TPE. Marketing, commercial, administration, direction. Une
          cinquantaine d'organisations accompagnées, dans une dizaine de secteurs.
          <strong class="font-medium text-white">
            Je travaille déjà en sous-traitance pour trois organismes de formation certifiés
          </strong>{" "}
          — vous portez la convention, je conçois, j'anime et je vous rends le dossier.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <button
            type="button"
            data-open-booking
            class="group inline-flex cursor-pointer items-center gap-3 rounded-full bg-lime px-6 py-3.5 text-[15px] font-medium text-black transition-all hover:bg-lime/90"
          >
            <span class="grid h-7 w-7 place-items-center rounded-full bg-black/10 text-base transition-transform group-hover:translate-x-0.5">
              →
            </span>
            Réserver 30 minutes
          </button>
          <button
            type="button"
            data-open-contact
            class="cursor-pointer rounded-full border border-white/20 px-6 py-3.5 text-[15px] font-medium text-white transition-colors hover:border-lime hover:text-lime"
          >
            Envoyer un message
          </button>
        </div>
      </div>
    </header>

    {/* -------------------------------------------------------------- Spectre */}
    <section class="border-b border-white/10 bg-[oklch(0.185_0.009_70)] px-6 py-20 md:px-12 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 md:grid-cols-2 md:items-end">
          <div>
            <Eyebrow>Le spectre</Eyebrow>
            <h2 class="text-[clamp(1.7rem,3.6vw,2.7rem)] font-light leading-[1.1] tracking-[-0.03em]">
              Quel public voulez-vous
              <br />
              <em class="text-lime">me confier&nbsp;?</em>
            </h2>
          </div>
          <p class="max-w-lg text-[15px] leading-relaxed text-white/70">
            Trois ans à animer sur des terrains très différents m'ont surtout appris à ajuster.
            Cherchez le vôtre&nbsp;: il y a de bonnes chances que je l'aie déjà eu en face de moi.
          </p>
        </div>

        <div class="mt-10 flex flex-wrap gap-2">
          {SPECTRE.map((axe, i) => (
            <button
              type="button"
              data-spectre-onglet
              data-val={axe.id}
              aria-pressed={i === 0 ? "true" : "false"}
              class="cursor-pointer rounded-full border border-white/20 px-4 py-2 text-[13px] text-white/70 transition-colors hover:border-lime hover:text-lime aria-pressed:border-lime aria-pressed:bg-lime aria-pressed:text-black"
            >
              {axe.onglet}
            </button>
          ))}
        </div>

        <div class="mt-8 rounded-2xl border border-white/15 bg-background p-7 md:p-9">
          <h3 class="text-[11px] uppercase tracking-[0.22em] text-lime" id="sp-question"></h3>
          <div class="mt-6" id="sp-corps"></div>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------ Artefacts */}
    <section class="border-b border-white/10 px-6 py-20 md:px-12 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 md:grid-cols-2 md:items-end">
          <div>
            <Eyebrow>Les supports</Eyebrow>
            <h2 class="text-[clamp(1.7rem,3.6vw,2.7rem)] font-light leading-[1.1] tracking-[-0.03em]">
              Je conçois mes supports.
              <br />
              <em class="text-lime">Les voici.</em>
            </h2>
          </div>
          <p class="max-w-lg text-[15px] leading-relaxed text-white/70">
            Ingénierie pédagogique comprise&nbsp;: programme, supports, exercices, quiz de fin,
            livrets par outil. Trois artefacts réels, anonymisés — ouvrez-les plutôt que de me
            croire sur parole.
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {ARTEFACTS.map((a) => (
            <a
              href={a.url}
              target="_blank"
              rel="noopener"
              class="group flex flex-col rounded-2xl border border-white/15 p-7 transition-colors hover:border-lime/60"
            >
              <h3 class="text-[17px] font-medium transition-colors group-hover:text-lime">
                {a.titre}
              </h3>
              <p class="mt-3 flex-1 text-[14px] leading-relaxed text-white/65">{a.detail}</p>
              <span class="mt-6 text-[13px] text-white/45 transition-colors group-hover:text-lime">
                {a.lien} ↗
              </span>
            </a>
          ))}
        </div>

        <div class="mt-10 grid gap-6 border-t border-white/10 pt-10 md:grid-cols-2">
          {VERBATIMS.map(([q, qui]) => (
            <figure>
              <blockquote class="text-[15px] leading-relaxed text-white/80">
                <span class="font-serif text-2xl leading-none text-lime">"</span>
                {q}
              </blockquote>
              <figcaption class="mt-2 text-[13px] text-white/45">{qui}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* ----------------------------------------------------------- Le cadre */}
    <section class="border-b border-white/10 bg-[oklch(0.185_0.009_70)] px-6 py-20 md:px-12 md:py-24">
      <div class="mx-auto max-w-7xl">
        <Eyebrow>Le cadre</Eyebrow>
        <h2 class="max-w-3xl text-[clamp(1.7rem,3.6vw,2.7rem)] font-light leading-[1.1] tracking-[-0.03em]">
          Ce qu'il vous faut <em class="text-lime">pour me référencer.</em>
        </h2>

        <div class="mt-12 grid gap-px overflow-hidden rounded-2xl bg-white/10 md:grid-cols-2">
          <dl class="space-y-5 bg-background p-8 md:p-9">
            <div class="text-[11px] uppercase tracking-[0.22em] text-lime">Administratif</div>
            {[
              ["Forme juridique", v(ADMIN.formeJuridique)],
              ["SIRET", v(ADMIN.siret)],
              [
                "Déclaration d'activité",
                `${v(ADMIN.nda)} — préfecture de région ${ADMIN.ndaRegion}`,
              ],
              [
                "Qualiopi",
                "Non détenue en propre. J'interviens sous la certification du centre, en sous-traitance.",
              ],
              ["RC professionnelle", v(ADMIN.rcPro)],
              ["Délai d'accès", v(ADMIN.delaiAcces)],
            ].map(([k, val]) => (
              <div class="grid gap-1 border-b border-white/10 pb-4 last:border-0 last:pb-0 sm:grid-cols-[11rem_1fr] sm:gap-4">
                <dt class="text-[13px] text-white/50">{k}</dt>
                <dd
                  class:list={[
                    "text-[14px]",
                    String(val).includes("[À VALIDER]") ? "text-lime/80" : "text-white/90",
                  ]}
                >
                  {val}
                </dd>
              </div>
            ))}
          </dl>

          <dl class="space-y-5 bg-background p-8 md:p-9">
            <div class="text-[11px] uppercase tracking-[0.22em] text-lime">Intervention</div>
            {[
              ["Zone", "Bordeaux et Nouvelle-Aquitaine, national, et classe virtuelle partout"],
              ["Formats", "Présentiel intra, classe virtuelle, mixte avec suivi à distance"],
              ["Durées", "De la demi-journée d'acculturation au parcours déployé par vagues"],
              [
                "Outils",
                "ChatGPT, Claude, Copilot, Gemini, Perplexity, NotebookLM — et l'outil déjà déployé chez votre client, s'il y en a un",
              ],
              ["Tarifs", "Sur demande — ils dépendent du format, du volume et de l'ingénierie"],
            ].map(([k, val]) => (
              <div class="grid gap-1 border-b border-white/10 pb-4 last:border-0 last:pb-0 sm:grid-cols-[11rem_1fr] sm:gap-4">
                <dt class="text-[13px] text-white/50">{k}</dt>
                <dd class="text-[14px] text-white/90">{val}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="mt-6 rounded-2xl border border-white/15 bg-background p-7 md:p-8">
          <p class="text-[15px] leading-relaxed text-white/75">
            <strong class="font-medium text-white">Le dossier que je vous remets à chaque session.</strong>{" "}
            Vous restez responsable de la qualité de vos sous-traitants — vous n'avez rien à me
            réclamer.
          </p>
          <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-[14px] text-white/65">
            {[
              "CV formateur à jour",
              "Programme daté",
              "Questionnaire de positionnement",
              "Supports de séance",
              "Feuilles d'émargement",
              "Quiz de fin et résultats",
              "Questionnaires de satisfaction",
              "Attestations",
            ].map((d) => (
              <li class="flex items-center gap-2">
                <span class="text-lime">+</span>
                {d}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------- Modes + CTA */}
    <section class="px-6 py-20 md:px-12 md:py-24">
      <div class="mx-auto max-w-7xl">
        <Eyebrow>Travailler ensemble</Eyebrow>
        <h2 class="max-w-3xl text-[clamp(1.7rem,3.6vw,2.7rem)] font-light leading-[1.1] tracking-[-0.03em]">
          Trois façons, <em class="text-lime">selon ce qui vous manque.</em>
        </h2>

        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {MODES.map((m) => (
            <article class="rounded-2xl border border-white/15 p-7">
              <h3 class="text-[17px] font-medium">{m.titre}</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-white/70">{m.texte}</p>
            </article>
          ))}
        </div>

        <div class="mt-16 rounded-2xl border border-lime/40 bg-lime/[0.04] px-7 py-12 text-center md:px-12">
          <h2 class="text-[clamp(1.6rem,3.4vw,2.5rem)] font-light leading-[1.1] tracking-[-0.03em]">
            Une session à remplir&nbsp;?
            <em class="text-lime"> Parlons-en trente minutes.</em>
          </h2>
          <p class="mx-auto mt-5 max-w-xl text-[15px] leading-relaxed text-white/70">
            Dites-moi le public, la durée et le contexte&nbsp;: je vous renvoie un programme
            ajusté sous quarante-huit heures, prêt à entrer dans votre convention.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <button
              type="button"
              data-open-booking
              class="group inline-flex cursor-pointer items-center gap-3 rounded-full bg-lime px-6 py-3.5 text-[15px] font-medium text-black transition-all hover:bg-lime/90"
            >
              <span class="grid h-7 w-7 place-items-center rounded-full bg-black/10 text-base transition-transform group-hover:translate-x-0.5">
                →
              </span>
              Réserver 30 minutes
            </button>
            <button
              type="button"
              data-open-contact
              class="cursor-pointer rounded-full border border-white/20 px-6 py-3.5 text-[15px] font-medium text-white transition-colors hover:border-lime hover:text-lime"
            >
              Envoyer un message
            </button>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </main>

  <script type="application/json" id="fi-spectre" set:html={JSON.stringify(SPECTRE)} />

  <script>
    const source = document.getElementById("fi-spectre");
    if (source) {
      const SPECTRE = JSON.parse(source.textContent || "[]");
      const question = document.getElementById("sp-question");
      const corps = document.getElementById("sp-corps");

      function rendre(id) {
        const axe = SPECTRE.find((a) => a.id === id);
        if (!axe) return;
        question.textContent = axe.question;

        if (axe.type === "etiquettes") {
          corps.className = "mt-6 flex flex-wrap gap-2.5";
          corps.innerHTML = axe.items
            .map(
              (i) =>
                `<span class="rounded-full border border-lime/30 bg-lime/[0.06] px-4 py-2 text-[14px] text-white/85">${i.t}</span>`,
            )
            .join("");
        } else {
          corps.className = "mt-6 grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-3";
          corps.innerHTML = axe.items
            .map(
              (i) =>
                `<div><div class="text-[16px] font-medium text-white">${i.t}</div><p class="mt-2 text-[14px] leading-relaxed text-white/65">${i.d}</p></div>`,
            )
            .join("");
        }
      }

      document.querySelectorAll("[data-spectre-onglet]").forEach((btn) => {
        btn.addEventListener("click", () => {
          document
            .querySelectorAll("[data-spectre-onglet]")
            .forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
          rendre(btn.dataset.val);
        });
      });

      rendre(SPECTRE[0].id);
    }
  </script>
</BaseLayout>
