---
/**
 * Formation à l'IA générative — refaite en septembre 2026 sur le modèle de
 * la page d'accueil (fond et forme), comme /integration-ia : hero sombre,
 * aiguillage, déroulé « Vous recevez » avec une mécanique animée (le dossier
 * qui se remplit), tuiles à grand signe, prix sur fond sombre, FAQ fermée,
 * clôture sombre.
 *
 * DEUX destinataires, nommés dès l'aiguillage : l'entreprise qui forme ses
 * équipes (argument : financement OPCO via un organisme partenaire) et
 * l'organisme de formation qui cherche un intervenant (argument : le dossier
 * complet, la Qualiopi portée par son centre).
 *
 * Le titre du hero est calé ligne par ligne par Julien : deux lignes sur
 * desktop, quatre en responsive. Ne pas y toucher sans lui.
 *
 * PRIX : à partir de 790 € HT la demi-journée (Julien, 15/09/2026).
 * Aucun organisme partenaire n'est nommé à côté d'un client : les contrats
 * l'interdisent.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import CtaButton from "@/components/CtaButton.astro";
import Footer from "@/components/Footer.astro";
import Reveal from "@/components/Reveal.astro";
import { SITE } from "@/lib/site";

const title = "Formation à l'IA générative | Julien Tridat";
const description =
  "Formation IA générative en intra ou pour organismes de formation. Plus de 300 dirigeants et cadres formés. Dès 790 € HT la demi-journée, OPCO possible.";

/* ------------------------------------------------------------------ *
 * Données administratives — à compléter par Julien. Une valeur absente
 * n'affiche rien : elle rejoint la liste des pièces « sur demande ».
 * ------------------------------------------------------------------ */
const ADMIN = {
  formeJuridique: null as string | null,
  siret: null as string | null,
  /** N° de déclaration d'activité de formateur (préfecture de région). */
  nda: null as string | null,
  ndaRegion: "Nouvelle-Aquitaine",
  /** Assureur + n° de police de la RC professionnelle. */
  rcPro: null as string | null,
  /** Délai entre l'accord et la première session. */
  delaiAcces: null as string | null,
};

/** Lignes administratives réellement renseignées, prêtes à l'affichage. */
const lignesAdmin: [string, string][] = [
  ADMIN.formeJuridique ? (["Forme juridique", ADMIN.formeJuridique] as [string, string]) : null,
  ADMIN.siret ? (["SIRET", ADMIN.siret] as [string, string]) : null,
  ADMIN.nda
    ? (["Déclaration d'activité", `${ADMIN.nda} — préfecture de région ${ADMIN.ndaRegion}`] as [
        string,
        string,
      ])
    : null,
  [
    "Qualiopi",
    "Non détenue en propre. J'interviens sous la certification du centre, en sous-traitance.",
  ] as [string, string],
  ADMIN.rcPro ? (["RC professionnelle", ADMIN.rcPro] as [string, string]) : null,
  ADMIN.delaiAcces ? (["Délai d'accès", ADMIN.delaiAcces] as [string, string]) : null,
].filter((l): l is [string, string] => l !== null);

/** Intitulés des pièces encore absentes, listés en une phrase plutôt qu'en trous. */
const piecesSurDemande = [
  ADMIN.formeJuridique ? null : "forme juridique",
  ADMIN.siret ? null : "SIRET",
  ADMIN.nda ? null : "n° de déclaration d'activité",
  ADMIN.rcPro ? null : "attestation de RC professionnelle",
  ADMIN.delaiAcces ? null : "délai d'accès",
].filter((x): x is string => x !== null);

/* ------------------------------------------------------------------ *
 * Le spectre — la seule mécanique de la page.
 * Quatre axes, une seule bande à l'écran : le lecteur y cherche SON public.
 * ------------------------------------------------------------------ */
const SPECTRE = [
  {
    id: "taille",
    onglet: "Par taille",
    question: "Quelle taille d'organisation ?",
    type: "cartes",
    items: [
      {
        t: "Groupes internationaux",
        d: "Équipes siège d'un groupe de travel retail, enseigne de plus de 600 points de vente, environnements verrouillés par la direction informatique et licences hétérogènes.",
      },
      {
        t: "ETI et grands comptes",
        d: "Dassault Systèmes, SNCF Fret, un réseau de conseil de plusieurs centaines d'experts.",
      },
      {
        t: "PME et agences",
        d: "Agences de communication et de création, cabinets de conseil, maisons de vin et de spiritueux, franchises.",
      },
      {
        t: "TPE et indépendants",
        d: "Artisans, professions libérales, commerces, dirigeants sans service informatique ni service marketing derrière eux.",
      },
    ],
  },
  {
    id: "niveau",
    onglet: "Par niveau",
    question: "Quel niveau dans l'organisation ?",
    type: "cartes",
    items: [
      {
        t: "Comités de direction",
        d: "Sessions stratégiques avec le dirigeant, cadrage de la gouvernance, arbitrage des priorités. Et des keynotes devant des comités et des clubs de dirigeants.",
      },
      {
        t: "Encadrement et chefs de projet",
        d: "Où l'IA entre dans le processus, qui devient propriétaire de quoi, et ce qu'on décide de ne pas automatiser.",
      },
      {
        t: "Équipes opérationnelles",
        d: "Celles qui produisent tous les jours — sur leurs propres dossiers, leurs propres fichiers, leurs propres contraintes d'outil.",
      },
    ],
  },
  {
    id: "metier",
    onglet: "Par métier",
    question: "Quel métier dans la salle ?",
    type: "cartes",
    items: [
      {
        t: "Marketing et communication",
        d: "Contenus, déclinaison de supports à l'échelle d'un réseau, brief de création, plan éditorial, charte maison encodée dans l'assistant.",
      },
      {
        t: "Commercial et développement",
        d: "Propositions, argumentaires, relances, prospection personnalisée, veille marché.",
      },
      {
        t: "Administration et fonctions support",
        d: "Comptes-rendus, courriers, synthèses, suivi de dossiers, pilotage de projet.",
      },
      {
        t: "Direction et stratégie",
        d: "Feuille de route, règles d'usage internes, visibilité de la marque dans les réponses des IA.",
      },
      {
        t: "Métiers en secteur réglementé",
        d: "Sourcing restreint aux autorités de référence, validation humaine préservée, périmètre autorisé par la direction informatique.",
      },
    ],
  },
  {
    id: "secteur",
    onglet: "Par secteur",
    question: "Quel secteur ?",
    type: "etiquettes",
    items: [
      { t: "Agences de communication et de création" },
      { t: "Vin et spiritueux" },
      { t: "Santé et communication médicale" },
      { t: "Retail et réseaux de points de vente" },
      { t: "BTP" },
      { t: "Industrie" },
      { t: "Transport et logistique" },
      { t: "Conseil et formation professionnelle" },
      { t: "Immobilier" },
      { t: "Banque et finance" },
      { t: "Associations et réseaux d'affaires" },
    ],
  },
];

/** Artefacts réels, anonymisés, déjà publiés sur le site. La preuve tient au lien. */
const ARTEFACTS = [
  {
    titre: "Un support de formation",
    detail:
      "Le support « IA & Texte » d'une mission en agence santé, en défilement plutôt qu'en diapositives mortes.",
    url: "/demos/deck-formation/",
    lien: "Parcourir le support",
  },
  {
    titre: "Un support de grand groupe",
    detail:
      "Le support d'un parcours déployé par vagues auprès des équipes siège d'un groupe international.",
    url: "/demos/support-groupe-retail.html",
    lien: "Dérouler le support",
  },
  {
    titre: "Un guide d'autonomie",
    detail:
      "Six niveaux de progression sur un outil de gestion de projet : à chaque palier, la commande, le résultat attendu, le piège à éviter.",
    url: "/demos/guide-claude-clickup.html",
    lien: "Parcourir le guide",
  },
];


const etapes = [
  {
    moment: "Avant",
    texte: "Questionnaire de positionnement, puis un programme construit sur vos métiers et vos dossiers.",
    recu: "un programme daté, prêt à entrer dans la convention.",
  },
  {
    moment: "Le jour J",
    texte: "J'anime en présentiel, en classe virtuelle ou en mixte, sur vos vrais cas.",
    recu: "les supports de séance et les livrets par outil.",
  },
  {
    moment: "Après",
    texte: "Quiz de fin, questionnaires de satisfaction, attestations.",
    recu: "le dossier complet.",
  },
];

/** Les pièces du dossier, cochées une à une par l'animation du bloc 3. */
const DOSSIER = [
  "CV formateur à jour",
  "Programme daté",
  "Questionnaire de positionnement",
  "Supports de séance",
  "Feuilles d'émargement",
  "Quiz de fin et résultats",
  "Questionnaires de satisfaction",
  "Attestations",
];

const chiffres = [
  { signe: "300+", titre: "dirigeants et cadres formés", plein: true },
  { signe: "50", titre: "organisations" },
  { signe: "10", titre: "secteurs" },
];

/* Références : les noms déjà publiés sur le site (archive
   docs/verbatims-et-references.md) et Lagardère Travel Retail. Le club
   d'affaires du Marmandais n'y est pas : hors financement de la formation. */
const REFERENCES = [
  "Dassault Systèmes",
  "SNCF Fret",
  "Lagardère Travel Retail",
  "Le Nouveau Bélier",
  "Maison Chapoutier",
  "Zorba Group",
  "WeThePeople",
  "Cogefi",
  "Bordeaux Négoce",
  "Maison des Vins et des Spiritueux",
  "Asqua BTP",
  "Qwertys",
];

const cadre = [
  "Qualiopi via l'organisme qui porte la convention",
  "Bordeaux, Nouvelle-Aquitaine, national",
  "Présentiel, classe virtuelle, mixte",
  "De la demi-journée au parcours par vagues",
  "ChatGPT · Claude · Copilot · Gemini · Perplexity · NotebookLM",
];

const questions = [
  {
    q: "Vous êtes certifié Qualiopi\u00a0?",
    r: "Pas en propre. J'interviens sous la certification de l'organisme qui porte la convention — c'est déjà le cas avec trois organismes certifiés. Pour une entreprise, c'est un organisme partenaire qui la porte : vous n'avez pas à le chercher.",
  },
  {
    q: "Comment marche le financement OPCO\u00a0?",
    r: "La convention est portée par un organisme certifié Qualiopi, ce qui rend la formation éligible à une prise en charge par votre OPCO. Le montant dépend de votre OPCO et de votre entreprise.",
  },
  {
    q: "Quelles durées, quels formats\u00a0?",
    r: "De la demi-journée d'acculturation au parcours déployé par vagues. En présentiel intra, en classe virtuelle, ou en mixte avec suivi à distance. Bordeaux et Nouvelle-Aquitaine, national, et à distance partout.",
  },
  {
    q: "Sur quels outils\u00a0?",
    r: "ChatGPT, Claude, Copilot, Gemini, Perplexity, NotebookLM — et l'outil déjà déployé chez vous ou chez votre client, s'il y en a un.",
  },
  {
    q: "Vous pouvez construire notre offre de formation IA\u00a0?",
    r: "Oui. Vous voulez ouvrir l'IA à votre catalogue sans savoir par quel segment commencer : on mesure, on score les cibles, on écrit les programmes, et vous gardez la méthode pour ouvrir les suivants.",
  },
  {
    q: "Vous intervenez sur des événements\u00a0?",
    r: "Petits-déjeuners prescripteurs, salons, clubs clients. Je construis un livrable réel devant la salle plutôt que d'exposer le potentiel de l'IA.",
  },
  {
    q: "Vous faites aussi du marketing et de l'intégration IA\u00a0?",
    r: "Ce sont deux autres offres. Marketing IA : je deviens le service marketing d'une PME, avec un livrable chaque semaine. Intégration IA : j'installe des agents dans les outils d'une entreprise, en huit semaines.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${SITE.url}/formation-ia#service`,
    name: "Formation à l'IA générative",
    description:
      "Formations à l'IA générative en intra-entreprise (convention portée par un organisme partenaire certifié Qualiopi, financement OPCO possible) ou en sous-traitance pour organismes de formation. Programme sous 48 heures, dossier complet remis à chaque session.",
    provider: { "@id": `${SITE.url}/#julien-tridat` },
    areaServed: "FR",
    url: `${SITE.url}/formation-ia`,
    makesOffer: [
      {
        "@type": "Offer",
        name: "Demi-journée de formation",
        priceCurrency: "EUR",
        priceSpecification: {
          "@type": "PriceSpecification",
          minPrice: "790",
          priceCurrency: "EUR",
          valueAddedTaxIncluded: false,
        },
        description: "À partir de 790 € HT la demi-journée ; le tarif dépend du format, du volume et de l'ingénierie.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: questions.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.r },
    })),
  },
];

const h2 = "text-[clamp(2.2rem,5vw,4rem)] font-normal leading-[1.02] tracking-[-0.035em]";
/** Verbatims de participants à des sessions réelles (archive
    docs/verbatims-et-references.md) — les six, publiés ici depuis le 16/09/2026. */
const VERBATIMS = [
  [
    "Julien a parfaitement préparé son intervention, ce qui lui a permis d'adapter son accompagnement aux besoins spécifiques de chacun. Une grande aide pour notre équipe.",
    "Chrystelle T., directrice clientèle",
  ],
  [
    "La formation m'a permis de comprendre comment structurer mes prompts et affiner mes besoins grâce à une approche méthodique et pratique.",
    "Véronique T., directrice conseil",
  ],
  [
    "L'accompagnement était très concret et orienté vers des solutions pratiques. J'ai particulièrement apprécié la création d'assistants IA personnalisés avec ChatGPT.",
    "Séverine G., chargée de développement",
  ],
  [
    "Julien a su adapter le programme à notre métier tout en apportant des exemples concrets et des cas pratiques pertinents. Une approche dynamique et captivante.",
    "Daphné G., consultante",
  ],
  [
    "Julien est passionné et cela se ressent. Il a su répéter et reprendre chaque point de manière patiente et positive. Une formation enrichissante et pleine d'énergie.",
    "Elsa M., responsable administrative",
  ],
  [
    "Un accompagnement orienté sur les spécificités de nos métiers, parfaitement ajusté à nos besoins.",
    "Aurélie M., consultante",
  ],
];
---

<BaseLayout title={title} description={description} canonical={`${SITE.url}/formation-ia`} jsonLd={jsonLd}>
  <main class="bg-background text-foreground">
    {/* ---------------------------------------------------------------- 1 · Hero */}
    <header class="relative isolate overflow-hidden bg-foreground px-6 pb-20 pt-36 text-white md:px-12 md:pb-24 md:pt-44">
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background: radial-gradient(45% 60% at 80% 40%, rgba(108,76,241,0.28), transparent 70%), radial-gradient(40% 50% at 5% 0%, rgba(185,166,255,0.10), transparent 70%);"
      >
      </div>
      <Nav onDark />
      <div class="mx-auto max-w-7xl">
        <p class="mb-7 w-fit rounded-full border border-white/15 bg-white/[0.06] px-4 py-1.5 text-[12px] font-medium uppercase tracking-[0.18em] text-white md:text-[13px]">
          Formation IA générative<span class="hidden sm:inline">&nbsp;· Entreprises et organismes de formation</span>
        </p>
        <h1 class="text-[clamp(1.85rem,5.2vw,3.5rem)] font-normal leading-[1.04] tracking-[-0.03em]">
          Je forme à l'IA générative
          <br class="lg:hidden" />{" "}
          depuis trois ans.
          <br />
          <em class="text-violet-soft">
            Des comités de direction
            <br class="lg:hidden" />{" "}
            aux équipes de terrain.
          </em>
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-white/85 md:text-xl">
          Pour les entreprises qui forment leurs équipes, et les organismes qui cherchent un
          formateur. Plus de 300 dirigeants et cadres formés.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <CtaButton onDark>Réserver 20&nbsp;minutes</CtaButton>
          <a
            href="#deroule"
            class="inline-flex items-center rounded-full border border-white/25 px-6 py-3.5 text-[15px] font-medium leading-7 text-white/85 transition-colors hover:border-violet-soft hover:text-violet-soft"
          >
            Voir le dossier remis&nbsp;↓
          </a>
        </div>
        <p class="mt-6 text-sm text-white/70">
          Dès 790&nbsp;€&nbsp;HT la demi-journée&nbsp;· Financement OPCO possible&nbsp;· Dossier complet à chaque session
        </p>
      </div>
    </header>

    {/* ---------------------------------------------------- 2 · Deux façons d'arriver */}
    <section class="px-6 py-14 md:px-12 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div data-reveal>
          <Eyebrow>Deux façons d'arriver ici</Eyebrow>
          <h2 class={h2}>
            Vous formez vos équipes,
            <br />
            <em class="text-lime">ou vous cherchez qui les formera&nbsp;?</em>
          </h2>
        </div>

        <div class="mt-12 grid gap-4 md:grid-cols-2">
          <article data-reveal class="flex flex-col rounded-3xl bg-lime p-8 text-white shadow-[0_30px_70px_-30px_rgba(108,76,241,0.7)] md:p-10">
            <span class="text-[11px] uppercase tracking-[0.22em] text-white/75">Vous êtes une entreprise</span>
            <h3 class="mt-5 text-2xl font-medium leading-snug">Une formation intra, construite sur vos métiers.</h3>
            <p class="mt-3 flex-1 text-lg leading-relaxed text-white/85">
              La convention est portée par un organisme certifié Qualiopi&nbsp;: financement OPCO
              possible, et vous n'avez pas à le chercher.
            </p>
            <button
              type="button"
              data-open-contact
              class="group mt-8 inline-flex w-fit cursor-pointer items-center gap-3 rounded-full bg-white px-6 py-3.5 text-[15px] font-medium text-foreground transition-transform hover:-translate-y-0.5"
            >
              Décrire votre besoin
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </button>
          </article>

          <article data-reveal style="--reveal-delay: 100ms" class="flex flex-col rounded-3xl border border-line bg-card p-8 md:p-10">
            <span class="text-[11px] uppercase tracking-[0.22em] text-ink-3">Vous êtes un organisme de formation</span>
            <h3 class="mt-5 text-2xl font-medium leading-snug text-foreground">J'interviens sous votre certification.</h3>
            <p class="mt-3 flex-1 text-lg leading-relaxed text-ink-2">
              Vous portez la convention et la relation client. Je conçois, j'anime, et je vous rends
              le dossier complet. C'est déjà le cas avec trois organismes.
            </p>
            <a
              href="#cadre"
              class="group mt-8 inline-flex w-fit items-center gap-3 rounded-full border border-line px-6 py-3.5 text-[15px] font-medium text-foreground transition-colors hover:border-lime hover:text-lime"
            >
              Voir le cadre
              <span class="transition-transform group-hover:translate-y-0.5">↓</span>
            </a>
          </article>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------ 3 · Comment ça se passe
        À droite, le dossier se remplit pièce par pièce puis affiche « Dossier
        complet ». Décoratif : les pièces sont aussi listées en toutes lettres. */}
    <section id="deroule" class="scroll-mt-24 border-t border-line bg-card px-6 py-14 md:px-12 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-16">
        <div>
          <div data-reveal>
            <Eyebrow>Comment ça se passe</Eyebrow>
            <h2 class={`${h2} lg:text-[clamp(2.4rem,3.6vw,3.4rem)]`}>
              Un programme sous&nbsp;48&nbsp;heures.
              <br />
              <em class="text-lime">Un dossier complet après.</em>
            </h2>
          </div>
          <ol class="mt-10 space-y-4">
            {etapes.map((e, i) => (
              <li data-reveal style={`--reveal-delay: ${i * 90}ms`} class="rounded-3xl border border-line bg-background p-6 md:p-7">
                <div class="flex items-baseline gap-4">
                  <span class="font-serif text-3xl italic leading-none text-lime">{String(i + 1).padStart(2, "0")}</span>
                  <h3 class="text-xl font-medium text-foreground">{e.moment}</h3>
                </div>
                <p class="mt-3 text-base leading-relaxed text-ink-2">{e.texte}</p>
                <p class="mt-4 border-t border-line pt-3 text-[15px] leading-relaxed text-ink-2">
                  <span class="font-medium text-lime">Vous recevez&nbsp;:</span> {e.recu}
                </p>
              </li>
            ))}
          </ol>
        </div>

        <div data-reveal style="--reveal-delay: 150ms" class="relative min-w-0">
          <div
            class="pointer-events-none absolute -inset-10 -z-10 rounded-[3rem] opacity-70 blur-3xl"
            style="background: radial-gradient(60% 60% at 50% 40%, rgba(108,76,241,0.18), transparent 70%);"
          >
          </div>
          <div id="dossier" class="rounded-3xl border border-line bg-background p-6 shadow-[0_40px_90px_-45px_rgba(17,18,22,0.45)] md:p-8">
            <div class="flex items-center justify-between gap-4">
              <span class="text-[11px] uppercase tracking-[0.22em] text-ink-3">Le dossier de la session</span>
              <span id="dossier-compte" class="font-serif text-2xl italic leading-none text-lime">8&nbsp;/&nbsp;8</span>
            </div>
            <ul class="mt-6 space-y-2.5">
              {DOSSIER.map((d) => (
                <li class="dossier-piece flex items-center gap-3 rounded-xl border border-line px-4 py-2.5 text-[15px] text-foreground transition-colors duration-300">
                  <span class="dossier-coche grid h-5 w-5 shrink-0 place-items-center rounded-full bg-lime text-[11px] text-white transition-all duration-300">✓</span>
                  {d}
                </li>
              ))}
            </ul>
            <div id="dossier-statut" class="mt-6 flex items-center justify-between gap-4 border-t border-line pt-4">
              <span class="text-sm text-ink-3">Remis à chaque session</span>
              <span class="rounded-full bg-lime px-3 py-1 text-xs font-medium text-white">Dossier complet</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------- 4 · Qui j'ai formé */}
    <section class="border-t border-line px-6 py-14 md:px-12 md:py-20">
      <div class="mx-auto max-w-7xl">
        <div data-reveal>
          <Eyebrow>Qui j'ai formé</Eyebrow>
          <h2 class={h2}>
            Quel public voulez-vous
            <br />
            <em class="text-lime">me confier&nbsp;?</em>
          </h2>
        </div>

        <ul class="mt-12 grid gap-4 sm:grid-cols-3">
          {chiffres.map((c, i) => (
            <li
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
