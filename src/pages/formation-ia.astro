---
/**
 * Formation à l'IA générative — refonte de novembre 2026 (charte « planning »).
 *
 * Les textes restent dans src/contenu/formation-ia.json (modifiables dans /admin) ;
 * cette page n'en change que la mise en page. La liste détaillée du dossier de
 * session n'est plus affichée (choix de Julien, 09/11/2026) ; les champs
 * `deroule.dossier*` restent dans le fichier.
 *
 * Deux destinataires : l'entreprise qui forme ses équipes (financement OPCO via un
 * organisme partenaire) et l'organisme de formation qui cherche un intervenant.
 * Aucun organisme partenaire n'est nommé à côté d'un client : les contrats l'interdisent.
 *
 * PIÈCES DE RÉFÉRENCEMENT : l'attestation de RC professionnelle n'est PAS proposée
 * tant qu'aucun contrat n'est souscrit (constat du 09/11/2026). L'ajouter à
 * `PIECES_SUR_DEMANDE` une fois l'assurance en place.
 */
import VitrineLayout from "@/layouts/VitrineLayout.astro";
import { SITE } from "@/lib/site";
import formationJson from "@/contenu/formation-ia.json";
import { preparer, enLigne, brut } from "@/lib/texte";

const c = preparer(formationJson);
const { title, description } = formationJson.seo;

const PIECES_SUR_DEMANDE = ["forme juridique", "SIRET", "n° de déclaration d'activité", "délai d'accès"];

const accent = { fort: "v-fort", accent: "v-vert", lien: "v-fort" };

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${SITE.url}/formation-ia#service`,
    name: "Formation à l'IA générative",
    description: brut(c.hero.chapo),
    provider: { "@id": `${SITE.url}/#julien-tridat` },
    areaServed: "FR",
    url: `${SITE.url}/formation-ia`,
    offers: {
      "@type": "Offer",
      price: "790",
      priceCurrency: "EUR",
      description: "La demi-journée, à partir de 790 € HT.",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: formationJson.faq.questions.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: brut(item.r) },
    })),
  },
];
---

<VitrineLayout title={title} description={description} canonical={`${SITE.url}/formation-ia`} jsonLd={jsonLd} actif="formation" cta="echange">
  <section id="haut" class="v-section v-section--premiere">
    <div class="v-hero v-grille v-grille--large">
      <div class="v-pile">
        <p class="v-label">{c.hero.surtitre} · {c.hero.surtitreSuite}</p>
        <h1 class="v-h1">
          {c.hero.titre1} {c.hero.titre2}
          <span class="v-vert">{c.hero.titreAccent1} {c.hero.titreAccent2}</span>
        </h1>
        <p class="v-chapo" set:html={enLigne(c.hero.chapo, accent)} />
        <div class="v-pile v-pile--serree" style="align-items: flex-start; gap: 8px;">
          <button type="button" class="v-bouton" data-open-booking="echange">
            Réserver →<span class="v-surligne">20&nbsp;min</span>
          </button>
          <p class="v-petit">Dès 790&nbsp;€ HT la demi-journée · financement OPCO possible</p>
        </div>
      </div>
      <div class="v-carte" style="align-self: start;">
        <div class="v-bandeau"><span>{c.public.surtitre}</span></div>
        {c.public.chiffres.map((ch) => (
          <div class="v-ligne" style="display: flex; align-items: baseline; gap: 16px;">
            <span class="v-prix" style="min-width: 110px;">{ch.signe}</span>
            <span>{ch.titre}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="entrees" class="v-section">
    <p class="v-label">{c.aiguillage.surtitre}</p>
    <h2 class="v-h2">{c.aiguillage.titre} <span class="v-vert">{c.aiguillage.titreAccent}</span></h2>
    <div class="v-grille">
      <article class="v-carte v-carte--pad">
        <p class="v-label">{c.aiguillage.entreprise.etiquette}</p>
        <h3 class="v-h3">{c.aiguillage.entreprise.titre}</h3>
        <p set:html={enLigne(c.aiguillage.entreprise.texte, accent)} />
        <button type="button" class="v-lien-action" style="align-self: flex-start;" data-open-contact>{c.aiguillage.entreprise.bouton} →</button>
      </article>
      <article class="v-carte v-carte--pad">
        <p class="v-label">{c.aiguillage.organisme.etiquette}</p>
        <h3 class="v-h3">{c.aiguillage.organisme.titre}</h3>
        <p set:html={enLigne(c.aiguillage.organisme.texte, accent)} />
        <a href="#cadre" class="v-lien-action" style="align-self: flex-start;">{c.aiguillage.organisme.lien} →</a>
      </article>
    </div>
  </section>

  <section id="deroule" class="v-section">
    <p class="v-label">{c.deroule.surtitre}</p>
    <h2 class="v-h2">{c.deroule.titre} <span class="v-vert">{c.deroule.titreAccent}</span></h2>
    <div class="v-carte v-cols">
      {c.deroule.etapes.map((e) => (
        <div class="v-carte--pad">
          <span class="v-label">{e.moment}</span>
          <p set:html={enLigne(e.texte, accent)} />
          <p class="v-petit"><span class="v-statut">✓ Vous recevez</span> {e.recu}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="public" class="v-section">
    <p class="v-label">{c.public.surtitre}</p>
    <h2 class="v-h2">{c.public.titre} <span class="v-vert">{c.public.titreAccent}</span></h2>
    <p class="v-texte" set:html={enLigne(c.public.intro, accent)} />
    <div class="v-carte">
      {c.public.axes.map((axe, i) => (
        <details class="v-ligne" open={i === 0}>
          <summary class="v-h3" style="cursor: pointer; padding: 6px 0; font-size: 24px;"><span>{axe.question}</span></summary>
          <ul class="v-liste" style="margin-top: 8px;">
            {axe.items.map((it) => (
              <li>
                <span class="v-fort">{it.titre}</span>
                {it.texte && <span> — {it.texte}</span>}
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </section>

  <section id="supports" class="v-section">
    <p class="v-label">{c.supports.surtitre}</p>
    <h2 class="v-h2">{c.supports.titre} <span class="v-vert">{c.supports.titreAccent}</span></h2>
    <div class="v-grille">
      {c.supports.artefacts.map((a) => (
        <article class="v-carte v-carte--pad">
          <h3 class="v-h3">{a.titre}</h3>
          <p set:html={enLigne(a.texte, accent)} />
          <a href={a.lien} class="v-lien-action" style="align-self: flex-start;">{a.lienTexte} →</a>
        </article>
      ))}
    </div>
    <div class="v-grille">
      {c.supports.verbatims.map((v) => (
        <figure class="v-carte v-carte--pad" style="margin: 0;">
          <blockquote style="margin: 0;"><p>«&nbsp;{v.citation}&nbsp;»</p></blockquote>
          <figcaption class="v-petit">{v.auteur}</figcaption>
        </figure>
      ))}
    </div>
    <div class="v-carte">
      <div class="v-bandeau"><span>{c.supports.referencesTitre}</span></div>
      <ul style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
        {c.supports.references.map((r) => (
          <li class="v-ligne v-fort" style="border-bottom: 1px solid var(--v-grille);">{r}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="cadre" class="v-section">
    <p class="v-label">{c.cadre.surtitre}</p>
    <h2 class="v-h2">{c.cadre.titre} <span class="v-vert">{c.cadre.titreAccent}</span></h2>
    <div class="v-grille" style="align-items: start;">
      <div class="v-carte">
        <ul>
          {c.cadre.pastilles.map((p) => <li class="v-ligne">{p}</li>)}
          <li class="v-ligne"><span class="v-fort">{c.cadre.pieces}</span> ({PIECES_SUR_DEMANDE.join(", ")}) {c.cadre.piecesSuite}</li>
        </ul>
      </div>
      <div class="v-carte v-carte--pad">
        <p class="v-label">{c.cadre.prixEtiquette}</p>
        <p class="v-prix">{c.cadre.montant} {c.cadre.montantDetail}</p>
        <p set:html={enLigne(c.cadre.prixTexte, accent)} />
      </div>
    </div>
  </section>

  <section id="questions" class="v-section">
    <p class="v-label">{c.faq.surtitre}</p>
    <h2 class="v-h2">{c.faq.titre} <span class="v-vert">{c.faq.titreAccent}</span></h2>
    <div class="v-carte">
      {c.faq.questions.map((item) => (
        <details class="v-ligne">
          <summary class="v-h3" style="cursor: pointer; padding: 6px 0; font-size: 24px;"><span>{item.q}</span></summary>
          <p class="v-texte" style="padding-top: 8px;" set:html={enLigne(item.r, accent)} />
        </details>
      ))}
    </div>
  </section>

  <section id="contact" class="v-section v-section--fin">
    <div class="v-sombre v-grille v-grille--large" style="align-items: end;">
      <div class="v-pile">
        <p class="v-label" style="color: var(--v-encre-sur-sombre);">{c.cloture.surtitre}</p>
        <h2 class="v-h1">{c.cloture.titre} <span class="v-vert">{c.cloture.titreAccent}</span></h2>
        <p class="v-chapo" set:html={enLigne(c.cloture.texte, accent)} />
      </div>
      <div class="v-pile v-pile--serree" style="align-items: flex-start;">
        <button type="button" class="v-bouton v-bouton--inverse" data-open-booking="echange">
          Réserver →<span class="v-surligne">20&nbsp;min</span>
        </button>
        <button type="button" class="v-lien-action" data-open-contact>{c.cloture.boutonMessage} →</button>
      </div>
    </div>
  </section>
</VitrineLayout>
