        </h2>

        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {MODES.map((m, i) => (
            <article
              class={`flex flex-col rounded-2xl border p-7 ${i === 0 ? "border-lime bg-lime/[0.04]" : "border-white/15"}`}
            >
