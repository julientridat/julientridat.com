              <h3 class="mt-3 text-xl font-medium">{m.titre}</h3>
              <p class="mt-5 text-[15px] leading-relaxed text-white/70">{m.texte}</p>
              <ul class="mt-6 flex-1 space-y-3 border-t border-white/10 pt-6 text-[14px] text-white/80">
                {m.points.map((p) => (
