---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/lib/site";

const title = "L'expérience — votre agence, cartographiée par l'IA | Julien Tridat";
const description =
  "Un outil pour les agences de com, marketing digital et retail : cartographiez votre pipeline (RDV → brief → reco → prod → veille), voyez les agents que Julien installerait, et testez-en un sur un de vos vrais clients — en direct.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "L'expérience — Julien Tridat",
    description,
    url: `${SITE.url}/experience`,
    author: { "@id": `${SITE.url}/#julien-tridat` },
  },
];

// Questions de profilage — courtes, tappables. Alimentent la personnalisation IA.
const PROFIL = [
  {
    q: "Votre agence, c'est plutôt…",
    cle: "Type d'agence",
    options: ["Créa / branding", "Marketing digital / acquisition", "Retail / shopper", "Généraliste"],
  },
  {
    q: "Votre taille :",
    cle: "Taille",
    options: ["Solo / freelance", "2 à 10", "11 à 30", "Plus de 30"],
  },
  {
    q: "Vous pilotez vos projets sur…",
    cle: "Gestion de projet",
    options: ["Notion", "Monday", "Trello / ClickUp", "Mails & tableurs"],
  },
  {
    q: "Le temps part surtout dans…",
    cle: "Où part le temps",
    options: ["Prépa des RDV", "Brief créa", "Reco / deck", "Production", "Veille & suivi"],
  },
];

// Pipeline d'une agence + agent installé sur chaque étape.
const PIPELINE = [
  { k: "RDV", label: "Rendez-vous", agent: "Prépa RDV" },
  { k: "Brief", label: "Brief créa", agent: "Brief Créa" },
  { k: "Reco", label: "Reco / deck", agent: "Reco Créa" },
  { k: "Prod", label: "Production", agent: "Passation & retours" },
  { k: "Veille", label: "Veille", agent: "Veille client" },
];

// Agents testables en direct sur l'URL d'un vrai client.
const AGENTS = [
  {
    cle: "prepa_rdv",
    nom: "Prépa RDV",
    tagline: "Arrivez préparé à chaque rendez-vous",
    desc: "Collez l'URL d'un client ou prospect — il sort une fiche de préparation prête : marché, angles, questions de qualif.",
  },
  {
    cle: "reco_crea",
    nom: "Reco Créa",
    tagline: "Une première trame de reco en minutes",
    desc: "L'URL d'un client → l'insight, l'idée directrice et les volets d'une reco à challenger.",
  },
  {
    cle: "veille",
    nom: "Veille client",
    tagline: "La veille marché, client par client",
    desc: "L'URL d'un client → les mouvements de son marché et ses concurrents à surveiller.",
  },
];
---

<BaseLayout title={title} description={description} canonical={`${SITE.url}/experience`} jsonLd={jsonLd}>
  <main id="xp" class="flex h-[100svh] flex-col overflow-hidden bg-foreground text-white">
    <!-- ═════════ EN-TÊTE DU PARCOURS ═════════ -->
    <nav class="z-20 flex shrink-0 items-center justify-between gap-3 border-b border-white/8 px-5 py-4 md:px-10">
      <div class="flex items-center gap-3">
        <button type="button" id="xp-retour" class="hidden h-9 w-9 shrink-0 cursor-pointer rounded-full border border-white/15 text-white/60 transition-colors hover:border-lime hover:text-lime" aria-label="Étape précédente">←</button>
        <a href="/" class="flex items-center gap-3 text-[15px] font-medium tracking-tight">
          <span class="grid grid-cols-3 gap-[2px]" style="width:18px;height:18px" aria-hidden="true">
            {Array.from({ length: 9 }).map(() => <span class="block rounded-[2px] bg-lime" style="width:5px;height:5px" />)}
          </span>
          <span class="hidden sm:inline">Julien Tridat</span>
        </a>
      </div>
      <ol id="xp-progression" class="flex items-center gap-2 text-[10px] uppercase tracking-[0.18em] text-white/35 sm:gap-3 sm:text-[11px]" aria-label="Progression du parcours">
        {["votre agence", "cartographie", "vos agents"].map((etape, i) => (
          <li class="flex items-center gap-2" data-pas={i}>
            <span class="xp-pas-point inline-block h-1.5 w-1.5 rounded-full bg-white/25 transition-colors"></span>
            <span class="xp-pas-label hidden md:inline">{etape}</span>
          </li>
        ))}
      </ol>
      <div class="flex items-center gap-2">
        <button type="button" id="xp-capot-open" class="cursor-pointer rounded-full border border-white/20 px-3 py-2 text-[11px] text-white/60 transition-colors hover:border-lime hover:text-lime sm:px-4">
          Coulisses
        </button>
        <button type="button" data-open-contact class="cursor-pointer rounded-full bg-white px-4 py-2 text-[14px] font-medium text-black transition-colors hover:bg-white/90">
          Contact
        </button>
      </div>
    </nav>

    <!-- ═════════ SCÈNE : UNE VUE À LA FOIS ═════════ -->
    <div id="xp-scene" class="relative min-h-0 flex-1">

      <!-- ——— VUE ACCUEIL ——— -->
      <section data-vue="accueil" class="xp-vue" aria-label="Étape 1 : votre agence">
        <div id="xp-hero" class="relative isolate flex min-h-full flex-col justify-center overflow-hidden px-6 py-10 md:px-12">
          <div class="pointer-events-none absolute inset-0 -z-30" style="background: radial-gradient(820px 520px at 22% 12%, rgba(108, 76, 241, 0.08), transparent 68%);" aria-hidden="true"></div>
          <div class="xp-depth pointer-events-none absolute -left-44 top-1/4 -z-20 h-[520px] w-[520px] rounded-full bg-lime/12 blur-3xl" data-depth="0.35" aria-hidden="true"></div>
          <div class="xp-depth pointer-events-none absolute -right-36 bottom-8 -z-20 h-[420px] w-[420px] rounded-full bg-lime/[0.07] blur-3xl" data-depth="0.55" aria-hidden="true"></div>

          <div class="relative mx-auto w-full max-w-5xl">
            <div class="mb-8 inline-flex w-fit items-center gap-3 rounded-full border border-lime/30 bg-black/40 px-4 py-2 text-[12px] text-lime/90 backdrop-blur-sm">
              <span class="relative flex h-2 w-2">
                <span id="xp-led-ping" class="absolute inline-flex h-full w-full animate-ping rounded-full bg-lime opacity-60"></span>
                <span id="xp-led" class="relative inline-flex h-2 w-2 rounded-full bg-lime"></span>
              </span>
              <span id="xp-console" aria-live="polite">pour les agences de com, marketing & retail</span>
            </div>

            <h1 class="max-w-[960px] text-[clamp(2.3rem,6.5vw,5.2rem)] font-light leading-[0.98] tracking-[-0.04em]">
              <span class="xp-line block overflow-hidden"><span class="xp-word">Votre agence,</span></span>
              <span class="xp-line block overflow-hidden"><span class="xp-word"><em class="font-normal text-lime">augmentée</em> — vue</span></span>
              <span class="xp-line block overflow-hidden"><span class="xp-word">par l'IA, en direct.</span></span>
            </h1>

            <p class="xp-fade mt-7 max-w-xl text-lg leading-relaxed text-white/70">
              Donnez l'adresse de votre site : je lis vos pages clés, je cherche votre marché,
              et je vous montre <strong class="font-medium text-white">pourquoi chaque agent du pack compte chez vous</strong>.
              Puis testez-en un sur un de vos vrais clients.
            </p>

            <form id="xp-url-form" class="xp-fade mt-9 flex w-full max-w-xl flex-col gap-2 sm:flex-row">
              <input
                id="xp-url-input"
                type="text"
                maxlength="300"
                inputmode="url"
                placeholder="votre-agence.fr"
                class="w-full rounded-full border border-lime/40 bg-black/40 px-5 py-3.5 text-[15px] text-white placeholder:text-white/35 outline-none backdrop-blur-sm transition-colors focus:border-lime"
                autocomplete="url"
                autocapitalize="off"
                spellcheck="false"
              />
              <button type="submit" id="xp-url-go" class="shrink-0 cursor-pointer rounded-full bg-lime px-6 py-3.5 text-[15px] font-medium text-white transition-colors hover:bg-lime/90 disabled:cursor-wait disabled:opacity-50">
                Cartographier mon agence
              </button>
            </form>
            <div class="xp-fade mt-3 text-xs text-white/55">
              Lecture publique de votre site, rien n'est stocké. Sans site ?
              <button type="button" id="xp-vers-profil-direct" class="cursor-pointer text-white/65 underline underline-offset-4 hover:text-lime">Répondez à 4 questions.</button>
            </div>
          </div>
        </div>
      </section>

      <!-- ——— VUE PROFIL (4 questions) ——— -->
      <section data-vue="profil" class="xp-vue" hidden aria-label="Étape 1 bis : votre profil d'agence">
        <div class="mx-auto max-w-3xl px-6 py-10 md:px-12">
          <div class="mb-5 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-lime">
            <span class="h-px w-6 bg-lime"></span> Votre agence en 4 réponses
          </div>
          <div class="relative min-h-[280px] rounded-2xl border border-white/12 bg-white/[0.02] p-7 md:p-9">
            <div class="mb-6 flex items-center justify-between">
              <div class="text-[12px] text-white/55"><span id="xp-profil-num">01</span> / 0{PROFIL.length}</div>
              <div class="h-1 w-40 overflow-hidden rounded-full bg-white/10">
                <div id="xp-profil-bar" class="h-full w-0 bg-lime transition-all duration-500"></div>
              </div>
            </div>
            <div id="xp-profil-slide">
              <h2 id="xp-profil-q" class="text-2xl font-medium leading-snug md:text-3xl">{PROFIL[0].q}</h2>
              <div id="xp-profil-opts" class="mt-6 flex flex-wrap gap-3"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ——— VUE CARTOGRAPHIE ——— -->
      <section data-vue="carto" class="xp-vue" hidden aria-label="Étape 2 : cartographie de votre agence">
        <div class="mx-auto max-w-6xl px-6 py-10 md:px-12">
          <div class="mb-5 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-lime">
            <span class="h-px w-6 bg-lime"></span> Cartographie — votre pipeline, augmenté
          </div>
          <h2 class="max-w-3xl text-[clamp(1.8rem,4vw,3rem)] font-light leading-[1.05] tracking-[-0.03em]">
            Là où un agent <em class="text-lime">travaille pour vous.</em>
          </h2>
          <p id="xp-carto-contexte" class="mt-3 max-w-2xl text-sm text-white/55"></p>

          <!-- Le pipeline agence : 5 étapes, un agent sur chacune -->
          <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
            {PIPELINE.map((s, i) => (
              <div class="xp-etape rounded-2xl border border-white/12 bg-white/[0.02] p-4" data-etape={i} style={`transition-delay:${i * 90}ms`}>
                <div class="flex items-center gap-2">
                  <span class="grid h-6 w-6 place-items-center rounded-full border border-lime/40 text-[11px] text-lime">{i + 1}</span>
                  <span class="text-[11px] uppercase tracking-[0.16em] text-white/55">{s.label}</span>
                </div>
                <div class="mt-3 text-[15px] font-medium text-white">{s.agent}</div>
                <div class="mt-1 h-1 w-8 rounded-full bg-lime/60"></div>
              </div>
            ))}
          </div>

          <!-- La lecture personnalisée, rédigée en direct -->
          <div id="xp-carto-box" class="mt-6 rounded-2xl border border-lime/25 bg-lime/[0.04] p-6 md:p-8" aria-live="polite">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <div class="text-[11px] uppercase tracking-[0.22em] text-lime">Le pack agence — et pourquoi chez vous</div>
              <span id="xp-carto-statut" class="text-[11px] text-white/50">analyse en cours…</span>
            </div>
            <div id="xp-carto-texte" class="mt-5 min-h-[120px] space-y-3"></div>
            <div id="xp-carto-rebonds" class="mt-5 hidden flex-wrap gap-2 border-t border-white/10 pt-4"></div>
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <button type="button" id="xp-vers-projet" class="group inline-flex cursor-pointer items-center gap-3 rounded-full bg-lime px-6 py-3.5 text-[15px] font-medium text-white transition-all hover:bg-lime/90">
              Mener un projet de A à Z
              <span class="grid h-7 w-7 place-items-center rounded-full bg-black/25 transition-transform group-hover:translate-x-0.5">→</span>
            </button>
            <button type="button" id="xp-vers-agents" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/20 px-6 py-3.5 text-sm text-white/80 transition-colors hover:border-lime hover:text-lime">
              Ou tester un agent sur un client
            </button>
            <button type="button" data-open-booking class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/20 px-6 py-3.5 text-sm text-white/80 transition-colors hover:border-lime hover:text-lime">
              Audit 30 min
            </button>
          </div>
        </div>
      </section>

      <!-- ——— VUE AGENTS (catalogue testable) ——— -->
      <section data-vue="agents" class="xp-vue" hidden aria-label="Étape 3 : testez un agent sur un client">
        <div class="mx-auto flex min-h-full max-w-6xl flex-col px-6 py-10 md:px-12">
          <div class="mb-5 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-lime">
            <span class="h-px w-6 bg-lime"></span> Vos agents — à l'essai sur un vrai client
          </div>
          <h2 class="max-w-3xl text-[clamp(1.8rem,4vw,3rem)] font-light leading-[1.05] tracking-[-0.03em]">
            Choisissez un agent. <em class="text-lime">Donnez l'URL d'un client.</em>
          </h2>
          <p class="mt-3 max-w-2xl text-sm text-white/55">Il produit un livrable réel sur votre client — la démo est votre premier livrable.</p>

          <div class="mt-8 grid gap-4 md:grid-cols-3" role="list">
            {AGENTS.map((a) => (
              <button type="button" class="xp-carte-agent group cursor-pointer rounded-2xl border border-white/15 bg-white/[0.02] p-6 text-left transition-all hover:border-lime/60" data-agent={a.cle} role="listitem">
                <div class="text-[11px] uppercase tracking-[0.18em] text-lime">{a.nom}</div>
                <div class="mt-3 text-lg font-medium leading-snug text-white">{a.tagline}</div>
                <p class="mt-2 text-sm leading-relaxed text-white/60">{a.desc}</p>
                <div class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-lime transition-transform group-hover:translate-x-0.5">Tester cet agent →</div>
              </button>
            ))}
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <button type="button" data-open-booking class="group inline-flex cursor-pointer items-center gap-3 rounded-full bg-lime px-6 py-3 text-[15px] font-medium text-white transition-all hover:bg-lime/90">
              <span class="grid h-7 w-7 place-items-center rounded-full bg-black/25 transition-transform group-hover:translate-x-0.5">→</span>
              Installer ces agents chez vous — audit 30 min
            </button>
          </div>
        </div>
      </section>

      <!-- ——— VUE ESSAI (agent sur un client) ——— -->
      <section data-vue="essai" class="xp-vue" hidden aria-label="Un agent à l'essai sur votre client">
        <div class="mx-auto max-w-6xl px-6 py-10 md:px-12">
          <div class="mb-5 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-lime">
            <span class="h-px w-6 bg-lime"></span> <span id="xp-essai-nom">Agent</span>
          </div>
          <h2 id="xp-essai-titre" class="max-w-3xl text-[clamp(1.8rem,4vw,3rem)] font-light leading-[1.05] tracking-[-0.03em]"></h2>

          <form id="xp-essai-form" class="mt-7 flex w-full max-w-xl flex-col gap-2 sm:flex-row">
            <input
              id="xp-essai-url"
              type="text"
              maxlength="300"
              inputmode="url"
              placeholder="site-de-votre-client.fr"
              class="w-full rounded-full border border-lime/40 bg-black/40 px-5 py-3.5 text-[15px] text-white placeholder:text-white/35 outline-none transition-colors focus:border-lime"
              autocomplete="url" autocapitalize="off" spellcheck="false"
            />
            <button type="submit" id="xp-essai-go" class="shrink-0 cursor-pointer rounded-full bg-lime px-6 py-3.5 text-[15px] font-medium text-white transition-colors hover:bg-lime/90 disabled:cursor-wait disabled:opacity-50">
              Lancer l'agent
            </button>
          </form>

          <div class="mt-7 grid gap-5 lg:grid-cols-[1fr_1.35fr] lg:items-start">
            <div class="rounded-2xl border border-white/12 bg-black/40 p-6 backdrop-blur-sm">
              <div class="flex items-baseline justify-between gap-3">
                <div class="text-[12px] text-lime">l'agent au travail</div>
                <span id="xp-essai-statut" class="text-[11px] text-white/50">en attente d'une URL</span>
              </div>
              <div id="xp-essai-console" class="mt-4 space-y-2 text-[13px] leading-relaxed text-white/55">
                <p class="text-white/35">Donnez l'URL d'un client, l'agent lit son site et produit.</p>
              </div>
            </div>

            <div class="rounded-2xl border border-lime/25 bg-lime/[0.04] p-6 md:p-8" aria-live="polite">
              <div class="text-[11px] uppercase tracking-[0.22em] text-lime">Le livrable, rédigé en direct</div>
              <div id="xp-essai-texte" class="mt-5 min-h-[140px] space-y-3">
                <p class="text-[15px] leading-relaxed text-white/55">Lancez l'agent : le livrable se construit ici, bloc par bloc.</p>
              </div>
              <div id="xp-essai-rebonds" class="mt-5 hidden flex-wrap gap-2 border-t border-white/10 pt-4"></div>
              <div id="xp-essai-suite" class="mt-6 hidden flex-wrap gap-3">
                <button type="button" data-open-booking class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-lime px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-lime/90">
                  Installer cet agent chez vous — audit 30 min →
                </button>
                <button type="button" id="xp-essai-retour" class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-white/20 px-5 py-2.5 text-sm text-white/80 transition-colors hover:border-lime hover:text-lime">
                  ← Autres agents
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ——— VUE PROJET DE A À Z ——— -->
      <section data-vue="projet" class="xp-vue" hidden aria-label="Mener un projet de A à Z">
        <div class="mx-auto max-w-4xl px-6 py-10 md:px-12">
          <div class="mb-5 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-lime">
            <span class="h-px w-6 bg-lime"></span> Projet de A à Z — orchestré par l'IA
          </div>
          <h2 class="max-w-3xl text-[clamp(1.8rem,4vw,3rem)] font-light leading-[1.05] tracking-[-0.03em]">
            De la demande client <em class="text-lime">à la reco stratégique.</em>
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-white/60">
            Collez le brief et les objectifs de votre client. Les agents s'enchaînent —
            étude de marché, cible, problématiques (matrice ICP × IBM), axes de campagne —
            et <strong class="text-white/85">vous validez à chaque étape.</strong>
          </p>

          <!-- Le stepper : 4 étapes -->
          <ol id="xp-stepper" class="mt-8 flex flex-wrap gap-2 text-[11px]">
            {["Étude de marché", "Cible — ICP", "Problématiques (IBM)", "Axes & ton"].map((s, i) => (
              <li class="xp-step flex items-center gap-2 rounded-full border border-white/12 px-3 py-1.5 text-white/45" data-step={i}>
                <span class="xp-step-num grid h-5 w-5 place-items-center rounded-full border border-white/20 text-[10px]">{i + 1}</span>
                <span>{s}</span>
              </li>
            ))}
          </ol>

          <!-- Composition du brief : tout se clique, rien à rédiger -->
          <form id="xp-projet-form" class="mt-7 space-y-5">
            <div>
              <div class="text-[11px] uppercase tracking-[0.18em] text-white/50">Le secteur de votre client</div>
              <div id="xp-choix-secteur" class="mt-2.5 flex flex-wrap gap-2" role="radiogroup" aria-label="Secteur du client">
                {["Mode & lifestyle", "Alimentaire & boissons", "Tech & services en ligne", "Retail & enseignes", "Santé & bien-être", "Industrie & BTP", "Tourisme & culture", "Services B2B"].map((s) => (
                  <button type="button" class="xp-opt" data-choix="secteur" data-valeur={s} role="radio" aria-checked="false">{s}</button>
                ))}
              </div>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-[0.18em] text-white/50">Son objectif n°1</div>
              <div id="xp-choix-objectif" class="mt-2.5 flex flex-wrap gap-2" role="radiogroup" aria-label="Objectif de la campagne">
                {["Notoriété", "Lancement de produit", "Acquisition de clients", "Fidélisation", "Repositionnement"].map((s) => (
                  <button type="button" class="xp-opt" data-choix="objectif" data-valeur={s} role="radio" aria-checked="false">{s}</button>
                ))}
              </div>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-[0.18em] text-white/50">Ses contraintes <span class="normal-case tracking-normal text-white/35">(2 max, optionnel)</span></div>
              <div id="xp-choix-contrainte" class="mt-2.5 flex flex-wrap gap-2" aria-label="Contraintes">
                {["Budget serré", "Délai court", "Marque premium", "Cible jeune", "Marché B2B", "Forte concurrence"].map((s) => (
                  <button type="button" class="xp-opt" data-choix="contrainte" data-valeur={s} aria-pressed="false">{s}</button>
                ))}
              </div>
            </div>
            <div class="flex flex-col gap-2 sm:flex-row">
              <input
                id="xp-projet-url"
                type="text" maxlength="300" inputmode="url"
                placeholder="site du client (optionnel) — pour nourrir l'étude"
                class="w-full rounded-full border border-white/15 bg-black/30 px-5 py-3 text-[15px] text-white placeholder:text-white/35 outline-none transition-colors focus:border-lime/60"
                autocomplete="url" autocapitalize="off" spellcheck="false"
              />
              <button type="submit" id="xp-projet-go" class="shrink-0 cursor-pointer rounded-full bg-lime px-6 py-3 text-[15px] font-medium text-white transition-colors hover:bg-lime/90 disabled:cursor-not-allowed disabled:opacity-40" disabled>
                Lancer le projet
              </button>
            </div>
            <details class="group">
              <summary class="cursor-pointer list-none text-[13px] text-white/45 underline-offset-4 hover:text-lime hover:underline">J'ai déjà un brief écrit — le coller</summary>
              <textarea
                id="xp-projet-brief"
                rows="5"
                maxlength="6000"
                placeholder="Collez ici le brief de votre client : activité, demande, objectifs, contraintes, budget…"
                class="mt-3 w-full resize-y rounded-2xl border border-white/15 bg-black/30 px-5 py-4 text-[15px] leading-relaxed text-white placeholder:text-white/35 outline-none transition-colors focus:border-lime/60"
              ></textarea>
            </details>
          </form>

          <!-- Les livrables s'empilent ici -->
          <div id="xp-projet-sorties" class="mt-8 space-y-5"></div>
        </div>
      </section>
    </div>

    <!-- ═════════ PANNEAU « COULISSES » ═════════ -->
    <aside
      id="xp-capot"
      class="fixed inset-x-3 bottom-3 z-50 hidden max-h-[55vh] flex-col overflow-hidden rounded-2xl border border-lime/30 bg-black/90 shadow-2xl shadow-black/60 backdrop-blur-md md:inset-x-auto md:right-6 md:bottom-6 md:w-[420px]"
      aria-label="Les coulisses : ce que l'IA vient de faire"
    >
      <div class="flex items-center justify-between border-b border-white/10 px-5 py-3">
        <span class="text-[12px] text-lime">les coulisses</span>
        <button type="button" id="xp-capot-close" class="cursor-pointer text-[12px] text-white/50 hover:text-white" aria-label="Fermer">Fermer</button>
      </div>
      <div class="grid grid-cols-3 gap-px border-b border-white/10 bg-white/10 text-[11px]">
        <div class="bg-black/90 px-4 py-3"><div class="text-white/50">IA</div><div id="xp-capot-moteur" class="mt-1 truncate text-lime">—</div></div>
        <div class="bg-black/90 px-4 py-3"><div class="text-white/50">temps de réponse</div><div id="xp-capot-latence" class="mt-1 text-lime">—</div></div>
        <div class="bg-black/90 px-4 py-3"><div class="text-white/50">morceaux reçus</div><div id="xp-capot-frags" class="mt-1 text-lime">—</div></div>
      </div>
      <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 py-4 text-[11px] leading-relaxed">
        <div>
          <div class="text-white/50">ce que l'IA a lu / produit</div>
          <div id="xp-capot-modele" class="mt-1 break-all text-white/75">rien pour l'instant — lancez une cartographie ou un agent.</div>
        </div>
        <div>
          <div class="text-white/50">la consigne donnée à l'IA</div>
          <pre id="xp-capot-system" class="mt-1 whitespace-pre-wrap break-words text-white/60">—</pre>
        </div>
        <div>
          <div class="text-white/50">le texte, reçu en direct</div>
          <div id="xp-capot-flux" class="mt-1 break-words text-white/60">—</div>
        </div>
      </div>
    </aside>
  </main>

  <style is:global>
    html, body { height: 100%; overflow: hidden; }

    .xp-vue { position: absolute; inset: 0; overflow-y: auto; overscroll-behavior: contain; }
    .xp-vue[hidden] { display: none; }
    .xp-vue-sortie { opacity: 0; transform: translateY(-16px); transition: opacity .26s ease, transform .26s ease; }
    .xp-vue-entree { animation: xp-vue-in .4s cubic-bezier(.2,.7,.2,1); }
    @keyframes xp-vue-in { from { opacity: 0; transform: translateY(20px); } }

    .xp-pas-actif .xp-pas-point { background: rgb(108, 76, 241); box-shadow: 0 0 8px rgba(108, 76, 241, .7); }
    .xp-pas-actif .xp-pas-label { color: rgb(108, 76, 241); }
    .xp-pas-fait .xp-pas-point { background: rgba(108, 76, 241, .5); }

    .xp-word { display: inline-block; transform: translateY(110%); animation: xp-rise .9s cubic-bezier(.2,.7,.2,1) forwards; }
    .xp-line:nth-child(2) .xp-word { animation-delay: .18s; }
    .xp-line:nth-child(3) .xp-word { animation-delay: .36s; }
    .xp-fade { opacity: 0; animation: xp-in .8s ease .7s forwards; }
    @keyframes xp-rise { to { transform: translateY(0); } }
    @keyframes xp-in { to { opacity: 1; } }

    /* Étapes du pipeline : révélées une à une */
    .xp-etape { opacity: 0; transform: translateY(10px); transition: opacity .5s ease, transform .5s ease, border-color .3s ease; }
    .xp-etape-on { opacity: 1; transform: none; }
    .xp-etape-actif { border-color: rgba(108, 76, 241, .55); box-shadow: 0 0 0 1px rgba(108, 76, 241, .25); }

    /* Stepper du projet A→Z */
    .xp-step-actif { border-color: rgba(108, 76, 241, .55); color: oklch(0.985 0 0); }
    .xp-step-actif .xp-step-num { border-color: rgb(108, 76, 241); background: rgb(108, 76, 241); color: #FBFBFC; }
    .xp-step-fait { color: oklch(0.8 0 0); }
    .xp-step-fait .xp-step-num { border-color: rgba(108, 76, 241, .5); color: rgb(108, 76, 241); }

    .xp-opt { cursor: pointer; border: 1px solid oklch(1 0 0 / 15%); border-radius: 999px; padding: .55rem 1.1rem; font-size: 14px; color: oklch(1 0 0 / 80%); transition: border-color .2s, color .2s, background .2s, transform .2s; }
    .xp-opt:hover { border-color: rgba(108, 76, 241, .6); color: rgb(108, 76, 241); transform: translateY(-1px); }
    .xp-opt-actif { border-color: rgb(108, 76, 241); background: rgba(108, 76, 241, .12); color: rgb(108, 76, 241); }

    /* ——— Primitives BLOCS : les sorties IA se rendent en blocs, pas en prose ——— */
    .xp-bloc { opacity: 0; transform: translateY(8px); transition: opacity .45s ease, transform .45s ease; }
    .xp-bloc-on { opacity: 1; transform: none; }
    .xp-b-titre { font-size: 11px; text-transform: uppercase; letter-spacing: .2em; color: rgb(108, 76, 241); padding-top: .35rem; }
    .xp-b-p { font-size: 15px; line-height: 1.65; color: oklch(1 0 0 / .85); }
    .xp-b-carte { display: flex; gap: .8rem; align-items: flex-start; border: 1px solid oklch(1 0 0 / 12%); border-radius: 1rem; background: oklch(1 0 0 / .02); padding: .85rem 1rem; }
    .xp-b-carte svg { flex: none; width: 20px; height: 20px; color: rgb(108, 76, 241); margin-top: .1rem; }
    .xp-b-puce { display: flex; gap: .6rem; align-items: baseline; font-size: 14px; line-height: 1.55; color: oklch(1 0 0 / .75); }
    .xp-b-puce::before { content: ""; flex: none; width: 5px; height: 5px; border-radius: 999px; background: rgb(108, 76, 241); transform: translateY(-2px); }
    .xp-b-niveau { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: .25rem .8rem; align-items: center; border: 1px solid oklch(1 0 0 / 12%); border-radius: 1rem; padding: .7rem 1rem; background: oklch(1 0 0 / .02); }
    .xp-b-jauge { display: inline-flex; gap: 3px; }
    .xp-b-jauge i { width: 14px; height: 5px; border-radius: 3px; background: oklch(1 0 0 / .14); }
    .xp-b-jauge i.on { background: rgb(108, 76, 241); }
    .xp-b-flux { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; font-size: 13px; }
    .xp-b-flux span { border: 1px solid oklch(1 0 0 / 15%); border-radius: 999px; padding: .3rem .8rem; color: oklch(1 0 0 / .8); }
    .xp-b-flux i { color: rgb(108, 76, 241); font-style: normal; }
    .xp-b-quads { display: grid; grid-template-columns: 1fr; gap: .6rem; }
    @media (min-width: 640px) { .xp-b-quads { grid-template-columns: 1fr 1fr; } }
    .xp-b-quad { border: 1px solid oklch(1 0 0 / 12%); border-radius: 1rem; padding: .8rem 1rem; background: oklch(1 0 0 / .02); }
    .xp-b-quad .q-nom { font-size: 10px; text-transform: uppercase; letter-spacing: .18em; color: rgb(108, 76, 241); }
    .xp-b-quad .q-constat { margin-top: .35rem; font-size: 13.5px; line-height: 1.5; color: oklch(1 0 0 / .82); }
    .xp-b-quad .q-verbatim { margin-top: .45rem; font-family: "Instrument Serif", Georgia, serif; font-style: italic; font-size: 15px; color: rgba(108, 76, 241, .9); }
    .xp-rebond { cursor: pointer; display: inline-flex; align-items: center; gap: .45rem; border: 1px solid rgba(108, 76, 241, .4); border-radius: 999px; padding: .5rem 1rem; font-size: 13.5px; color: rgb(108, 76, 241); background: transparent; transition: background .2s, transform .2s; }
    .xp-rebond:hover { background: rgba(108, 76, 241, .1); transform: translateY(-1px); }
    .xp-slide-out { animation: xp-out .28s ease forwards; }
    .xp-slide-in { animation: xp-enter .34s cubic-bezier(.2,.7,.2,1); }
    @keyframes xp-out { to { opacity: 0; transform: translateX(-16px); } }
    @keyframes xp-enter { from { opacity: 0; transform: translateX(20px); } }

    .xp-encours::after { content: "▋"; color: rgb(108, 76, 241); animation: xp-clignote 1s steps(2) infinite; margin-left: 1px; }
    @keyframes xp-clignote { 50% { opacity: 0; } }

    @media (prefers-reduced-motion: reduce) {
      .xp-word { transform: none; animation: none; }
      .xp-fade { opacity: 1; animation: none; }
      .xp-slide-in, .xp-slide-out, .xp-vue-entree { animation: none; }
      .xp-vue-sortie { transition: none; }
      .xp-depth { transform: none !important; }
      .xp-etape { opacity: 1; transform: none; }
    }
  </style>

  <script>
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const $ = (id: string) => document.getElementById(id)!;

    /* ————— Navigation du parcours ————— */
    const vues = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>("[data-vue]").forEach((v) => vues.set(v.dataset.vue!, v));
    let vueActive = "accueil";
    const PAS: Record<string, number> = { accueil: 0, profil: 0, carto: 1, agents: 2, essai: 2, projet: 2 };
    const PRECEDENT: Record<string, string> = { profil: "accueil", carto: "accueil", agents: "carto", essai: "agents", projet: "carto" };

    function majProgression() {
      const pas = PAS[vueActive] ?? 0;
      document.querySelectorAll<HTMLElement>("#xp-progression [data-pas]").forEach((li) => {
        const i = parseInt(li.dataset.pas!, 10);
        li.classList.toggle("xp-pas-actif", i === pas);
        li.classList.toggle("xp-pas-fait", i < pas);
      });
      $("xp-retour").classList.toggle("hidden", vueActive === "accueil");
    }

    function allerA(nom: string) {
      if (nom === vueActive || !vues.has(nom)) return;
      const courante = vues.get(vueActive)!;
      const suivante = vues.get(nom)!;
      const basculer = () => {
        courante.hidden = true;
        courante.classList.remove("xp-vue-sortie");
        suivante.hidden = false;
        suivante.scrollTop = 0;
        suivante.classList.add("xp-vue-entree");
        setTimeout(() => suivante.classList.remove("xp-vue-entree"), 450);
        vueActive = nom;
        majProgression();
      };
      if (reduced) basculer();
      else {
        courante.classList.add("xp-vue-sortie");
        setTimeout(basculer, 240);
      }
    }
    $("xp-retour").addEventListener("click", () => allerA(PRECEDENT[vueActive] ?? "accueil"));
    majProgression();

    /* ————— Parallaxe douce des halos ————— */
    const layers = [...document.querySelectorAll<HTMLElement>(".xp-depth")];
    if (!reduced && layers.length && window.matchMedia("(pointer: fine)").matches) {
      window.addEventListener("pointermove", (e) => {
        const px = (e.clientX / window.innerWidth) * 2 - 1;
        const py = (e.clientY / window.innerHeight) * 2 - 1;
        for (const el of layers) {
          const depth = parseFloat(el.dataset.depth || "0.3");
          el.style.transform = `translate3d(${px * 30 * depth}px, ${py * 20 * depth}px, 0)`;
        }
      }, { passive: true });
    }

    /* ————— Contexte partagé ————— */
    let siteAgence: string | null = null;   // URL de l'agence (si donnée)
    let profil: string | null = null;       // réponses au profilage, en une ligne

    /* ————— Client SSE + panneau « coulisses » ————— */
    const capot = {
      panel: $("xp-capot"),
      open() { this.panel.classList.remove("hidden"); this.panel.classList.add("flex"); },
      close() { this.panel.classList.add("hidden"); this.panel.classList.remove("flex"); },
      reset(mode: string) {
        $("xp-capot-moteur").textContent = "…";
        $("xp-capot-latence").textContent = "…";
        $("xp-capot-frags").textContent = "0";
        $("xp-capot-modele").textContent = `requête « ${mode} » en cours…`;
        $("xp-capot-system").textContent = "—";
        $("xp-capot-flux").textContent = "";
      },
    };
    $("xp-capot-open").addEventListener("click", () => capot.open());
    $("xp-capot-close").addEventListener("click", () => capot.close());

    type Handlers = { meta?: (d: any) => void; delta?: (d: any) => void; done?: (d: any) => void; error?: (d: any) => void; etape?: (d: any) => void };

    async function streamIA(mode: string, message: string, h: Handlers, extra: Record<string, unknown> = {}) {
      capot.reset(mode);
      let frags = 0;
      const flux = $("xp-capot-flux");
      const res = await fetch("/api/experience", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ mode, messages: [{ role: "user", content: message }], profil: profil ?? undefined, ...extra }),
      });
      if (!res.ok || !res.body) throw new Error(`API ${res.status}`);
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const blocs = buffer.split("\n\n");
        buffer = blocs.pop() ?? "";
        for (const bloc of blocs) {
          let event = "message", data = "";
          for (const line of bloc.split("\n")) {
            if (line.startsWith("event: ")) event = line.slice(7);
            else if (line.startsWith("data: ")) data += line.slice(6);
          }
          if (!data) continue;
          const parsed = JSON.parse(data);
          if (event === "meta") {
            $("xp-capot-moteur").textContent = parsed.engine;
            $("xp-capot-modele").textContent = parsed.model + (parsed.source ? ` · site lu : ${new URL(parsed.source.url).hostname}` : "");
            $("xp-capot-system").textContent = parsed.system + "…";
          } else if (event === "etape") {
            $("xp-capot-modele").textContent = parsed.label;
          } else if (event === "delta") {
            frags += 1;
            $("xp-capot-frags").textContent = String(frags);
            flux.append(parsed.text);
            flux.scrollTop = flux.scrollHeight;
          } else if (event === "done") {
            $("xp-capot-latence").textContent = `${parsed.ms} ms`;
          }
          (h as any)[event]?.(parsed);
        }
      }
    }

    /* ————— Protocole BLOCS : parseur ligne-à-ligne + rendu en primitives visuelles ————— */

    // Table fermée : la clé vient du modèle, on ne regarde JAMAIS la chaîne de prototypes.
    const PICTOS = new Map<string, string>([
      ["cible", '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/>'],
      ["oeil", '<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="2.5"/>'],
      ["alerte", '<path d="M12 4 2.5 20h19L12 4z"/><path d="M12 10v4.5"/><path d="M12 17.5v.01"/>'],
      ["eclair", '<path d="M13 3 5 13.5h5L10.5 21 19 10.5h-5L13 3z"/>'],
      ["boussole", '<circle cx="12" cy="12" r="9"/><path d="m15 9-2 5-4 1 2-5 4-1z"/>'],
      ["carte", '<path d="M9 4 3 6.5v13L9 17l6 2.5 6-2.5v-13L15 6.5 9 4z"/><path d="M9 4v13"/><path d="M15 6.5v13"/>'],
      ["personne", '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c1.2-3.5 3.8-5.5 7-5.5s5.8 2 7 5.5"/>'],
      ["dialogue", '<path d="M4 5h16v11H9l-5 4V5z"/>'],
      ["tendance", '<path d="M3 17 9.5 10.5l4 4L21 7"/><path d="M15.5 7H21v5.5"/>'],
      ["verrou", '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>'],
      ["horloge", '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.5l3.5 2"/>'],
      ["balance", '<path d="M12 4v16"/><path d="M5 7h14"/><path d="M5 7 3 13a3.2 3.2 0 0 0 6.4 0L7 7"/><path d="M19 7l-2 6a3.2 3.2 0 0 0 6.4 0L21 7"/>'],
    ]);
    function svgPicto(nom: string): SVGElement {
      const trace = PICTOS.get(String(nom).trim()) ?? PICTOS.get("boussole")!;
      const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      svg.setAttribute("viewBox", "0 0 24 24");
      svg.setAttribute("fill", "none");
      svg.setAttribute("stroke", "currentColor");
      svg.setAttribute("stroke-width", "1.5");
      svg.setAttribute("stroke-linecap", "round");
      svg.setAttribute("stroke-linejoin", "round");
      svg.setAttribute("aria-hidden", "true");
      svg.innerHTML = trace; // tracés statiques de la table fermée uniquement
      return svg;
    }

    const ECHELONS: Record<string, number> = { faible: 1, ["modéré"]: 2, ["élevé"]: 3, ["décisif"]: 4 };
    type Rebond = { type: string; libelle: string; consigne: string };

    /** Un parseur par appel : accumule les deltas, rend chaque LIGNE COMPLÈTE en bloc. */
    function creerParseurBlocs(conteneur: HTMLElement) {
      let buffer = "";
      let quads: HTMLElement | null = null; // grille QUAD courante (une par axe/section)
      const rebonds: Rebond[] = [];

      const poser = (el: HTMLElement, dans: HTMLElement = conteneur) => {
        el.classList.add("xp-bloc");
        dans.append(el);
        if (reduced) el.classList.add("xp-bloc-on");
        else requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add("xp-bloc-on")));
      };
      const texteEl = (tag: string, classe: string, contenu: string) => {
        const el = document.createElement(tag);
        el.className = classe;
        el.textContent = contenu;
        return el;
      };

      function rendreLigne(brute: string) {
        const ligne = brute.trim();
        if (!ligne || ligne === "FIN") return;
        const champs = ligne.split("|").map((c) => c.trim());
        const token = champs[0];
        if (token !== "QUAD") quads = null; // une série QUAD s'interrompt dès qu'autre chose arrive

        if (token === "T" && champs[1]) {
          poser(texteEl("div", "xp-b-titre", champs[1]));
        } else if (token === "P" && champs[1]) {
          poser(texteEl("p", "xp-b-p", champs.slice(1).join(" ")));
        } else if (token === "PUCE" && champs[1]) {
          poser(texteEl("div", "xp-b-puce", champs.slice(1).join(" ")));
        } else if (token === "CARTE" && champs[1]) {
          const carte = document.createElement("div");
          carte.className = "xp-b-carte";
          carte.append(svgPicto(champs[3] ?? "boussole"));
          const corps = document.createElement("div");
          corps.append(texteEl("div", "text-[15px] font-medium text-white leading-snug", champs[1]));
          if (champs[2]) corps.append(texteEl("div", "mt-0.5 text-[13.5px] leading-relaxed text-white/65", champs[2]));
          carte.append(corps);
          poser(carte);
        } else if (token === "NIVEAU" && champs[1]) {
          const n = document.createElement("div");
          n.className = "xp-b-niveau";
          n.append(texteEl("div", "text-[14px] font-medium text-white leading-snug", champs[1]));
          const droite = document.createElement("div");
          droite.className = "flex items-center gap-2";
          const jauge = document.createElement("span");
          jauge.className = "xp-b-jauge";
          const cran = ECHELONS[(champs[2] ?? "").toLowerCase()] ?? 2;
          for (let k = 1; k <= 4; k++) jauge.append(Object.assign(document.createElement("i"), { className: k <= cran ? "on" : "" }));
          droite.append(jauge, texteEl("span", "text-[11px] uppercase tracking-wider text-lime", champs[2] ?? ""));
          n.append(droite);
          if (champs[3]) n.append(texteEl("div", "col-span-2 text-[13px] leading-relaxed text-white/60", champs[3]));
          poser(n);
        } else if (token === "FLUX" && champs[1]) {
          const flux = document.createElement("div");
          flux.className = "xp-b-flux";
          champs[1].split(">").map((e) => e.trim()).filter(Boolean).forEach((etape, k, arr) => {
            flux.append(texteEl("span", "", etape));
            if (k < arr.length - 1) flux.append(Object.assign(document.createElement("i"), { textContent: "→" }));
          });
          poser(flux);
        } else if (token === "QUAD" && champs[2]) {
          if (!quads) { quads = document.createElement("div"); quads.className = "xp-b-quads"; conteneur.append(quads); }
          const q = document.createElement("div");
          q.className = "xp-b-quad";
          q.append(texteEl("div", "q-nom", champs[2]));
          if (champs[3]) q.append(texteEl("div", "q-constat", champs[3]));
          if (champs[4]) q.append(texteEl("div", "q-verbatim", "« " + champs[4] + " »"));
          poser(q, quads);
        } else if (token === "REBOND" && champs[2]) {
          rebonds.push({ type: champs[1] ?? "creuser", libelle: champs[2], consigne: champs[3] ?? champs[2] });
        } else {
          // Ligne inconnue (repli Llama, prose résiduelle) : jamais jetée.
          poser(texteEl("p", "xp-b-p", ligne.replace(/^→\s*/, "")));
        }
      }

      return {
        delta(txt: string) {
          buffer += txt;
          let i: number;
          while ((i = buffer.indexOf("\n")) >= 0) {
            const ligne = buffer.slice(0, i);
            buffer = buffer.slice(i + 1);
            rendreLigne(ligne);
          }
        },
        fin() { const reste = buffer; buffer = ""; if (reste.trim()) rendreLigne(reste); },
        erreur(message: string) { poser(texteEl("p", "xp-b-p text-white/70", message)); },
        rebonds,
      };
    }

    /** Barre de rebonds cliquables sous un livrable. `fixes` s'ajoute en fin (ex. Continuer). */
    function poserRebonds(
      zone: HTMLElement,
      rebonds: Rebond[],
      secours: Rebond[],
      onRebond: (r: Rebond) => void,
      fixes: { libelle: string; classe: string; action: () => void }[] = [],
    ) {
      zone.innerHTML = "";
      const liste = rebonds.length >= 2 ? rebonds.slice(0, 3) : secours;
      for (const r of liste) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "xp-rebond";
        b.textContent = r.libelle;
        b.addEventListener("click", () => onRebond(r));
        zone.append(b);
      }
      for (const f of fixes) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = f.classe;
        b.textContent = f.libelle;
        b.addEventListener("click", f.action);
        zone.append(b);
      }
      zone.classList.remove("hidden");
      zone.classList.add("flex");
    }

    /* ————— Sonde moteur (état du hero) ————— */
    (async () => {
      try {
        const res = await fetch("/api/experience");
        const info = await res.json();
        if (!info.ok) {
          $("xp-console").textContent = "démonstration hors ligne — la page reste visitable.";
          $("xp-led").classList.replace("bg-lime", "bg-white/40");
          $("xp-led-ping").classList.add("hidden");
        }
      } catch { /* on garde le libellé par défaut */ }
    })();

    /* ————— Étape 1 : URL de l'agence → profil ————— */
    $("xp-url-form").addEventListener("submit", (e) => {
      e.preventDefault();
      const brut = ($("xp-url-input") as HTMLInputElement).value.trim();
      siteAgence = brut || null;
      demarrerProfil();
      allerA("profil");
    });
    $("xp-vers-profil-direct").addEventListener("click", () => { siteAgence = null; demarrerProfil(); allerA("profil"); });

    /* ————— Profilage (4 questions) ————— */
    const PROFIL: { q: string; cle: string; options: string[] }[] = JSON.parse($("xp-profil-data").textContent!);
    let pIndex = 0;
    const pRep: { cle: string; valeur: string }[] = [];

    function demarrerProfil() {
      pIndex = 0; pRep.length = 0;
      renderProfil();
    }
    function renderProfil() {
      const item = PROFIL[pIndex];
      $("xp-profil-num").textContent = String(pIndex + 1).padStart(2, "0");
      ($("xp-profil-bar") as HTMLElement).style.width = `${(pIndex / PROFIL.length) * 100}%`;
      $("xp-profil-q").textContent = item.q;
      const opts = $("xp-profil-opts");
      opts.innerHTML = "";
      for (const option of item.options) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "xp-opt";
        btn.textContent = option;
        btn.addEventListener("click", () => choisirProfil(option));
        opts.append(btn);
      }
      $("xp-profil-slide").classList.add("xp-slide-in");
      setTimeout(() => $("xp-profil-slide").classList.remove("xp-slide-in"), 400);
    }
    function choisirProfil(valeur: string) {
      pRep.push({ cle: PROFIL[pIndex].cle, valeur });
      pIndex += 1;
      if (pIndex < PROFIL.length) {
        const slide = $("xp-profil-slide");
        slide.classList.add("xp-slide-out");
        setTimeout(() => { slide.classList.remove("xp-slide-out"); renderProfil(); }, reduced ? 0 : 260);
      } else {
        ($("xp-profil-bar") as HTMLElement).style.width = "100%";
        profil = pRep.map((r) => `${r.cle} : ${r.valeur}`).join(". ") + ".";
        lancerCarto();
        allerA("carto");
      }
    }

    /* ————— Cartographie ————— */
    let cartoEnCours = false;
    function revelerPipeline() {
      const etapes = [...document.querySelectorAll<HTMLElement>(".xp-etape")];
      etapes.forEach((el, i) => {
        setTimeout(() => {
          el.classList.add("xp-etape-on");
          el.classList.add("xp-etape-actif");
          setTimeout(() => el.classList.remove("xp-etape-actif"), 650);
        }, reduced ? 0 : i * 130);
      });
    }
    const REBONDS_SECOURS_CARTO: Rebond[] = [
      { type: "creuser", libelle: "Voir un agent en vrai", consigne: "" },
      { type: "cadrer", libelle: "Priorité au commercial", consigne: "Recentre la sélection d'agents sur le pôle commercial." },
      { type: "contre", libelle: "D'autres agents", consigne: "Propose trois autres agents du catalogue, différents des précédents." },
    ];
    async function lancerCarto(consigne = "") {
      if (cartoEnCours) return;
      cartoEnCours = true;
      revelerPipeline();
      $("xp-carto-contexte").textContent = siteAgence
        ? `D'après ${(() => { try { return new URL(/^https?:/.test(siteAgence!) ? siteAgence! : "https://" + siteAgence).hostname; } catch { return "votre site"; } })()} et votre profil.`
        : "D'après votre profil déclaré.";
      const texte = $("xp-carto-texte");
      const statut = $("xp-carto-statut");
      const zoneRebonds = $("xp-carto-rebonds");
      texte.innerHTML = "";
      zoneRebonds.classList.add("hidden");
      zoneRebonds.classList.remove("flex");
      const parseur = creerParseurBlocs(texte);
      let ok = false;
      try {
        await streamIA(
          "cartographie",
          "Cartographie mon agence et propose les agents à installer." + (consigne ? `\nAjustement demandé : ${consigne}` : ""),
          {
            etape: (d) => { statut.textContent = d.label; },
            meta: (d) => { statut.textContent = `${d.engine} · en direct`; },
            delta: (d) => { parseur.delta(d.text); ok = true; },
            error: (d) => { parseur.erreur(d.message); statut.textContent = "indisponible"; },
            done: (d) => { parseur.fin(); if (ok) statut.textContent = `cartographié en ${(d.ms / 1000).toFixed(1)} s`; },
          },
          siteAgence ? { siteUrl: siteAgence } : {},
        );
      } catch {
        parseur.erreur("La démonstration IA est momentanément indisponible — réessayez dans un instant.");
        statut.textContent = "hors ligne";
      }
      cartoEnCours = false;
      if (ok) {
        poserRebonds(zoneRebonds, parseur.rebonds, REBONDS_SECOURS_CARTO, (r) => {
          if (!r.consigne) { allerA("agents"); return; }
          lancerCarto(r.consigne);
        });
      }
    }
    $("xp-vers-agents").addEventListener("click", () => allerA("agents"));

    /* ————— Agents à l'essai sur un client ————— */
    const AGENTS: Record<string, { nom: string; titre: string; demande: string }> = {
      prepa_rdv: { nom: "Prépa RDV", titre: "Préparez votre prochain rendez-vous client.", demande: "Prépare mon rendez-vous avec ce client à partir de son site." },
      reco_crea: { nom: "Reco Créa", titre: "Une première trame de reco pour votre client.", demande: "Pose la première trame de recommandation pour ce client." },
      veille: { nom: "Veille client", titre: "La veille marché de votre client.", demande: "Fais la veille marché et concurrents de ce client." },
    };
    let agentActif = "prepa_rdv";
    let essaiEnCours = false;

    document.querySelectorAll<HTMLElement>(".xp-carte-agent").forEach((carte) => {
      carte.addEventListener("click", () => {
        agentActif = carte.dataset.agent!;
        const cfg = AGENTS[agentActif];
        $("xp-essai-nom").textContent = cfg.nom;
        $("xp-essai-titre").textContent = cfg.titre;
        ($("xp-essai-url") as HTMLInputElement).value = "";
        $("xp-essai-texte").innerHTML = `<p class="text-[15px] leading-relaxed text-white/55">Lancez l'agent : le livrable se construit ici, bloc par bloc.</p>`;
        $("xp-essai-console").innerHTML = `<p class="text-white/35">Donnez l'URL d'un client, l'agent lit son site et produit.</p>`;
        $("xp-essai-statut").textContent = "en attente d'une URL";
        $("xp-essai-suite").classList.add("hidden");
        $("xp-essai-rebonds").classList.add("hidden");
        $("xp-essai-rebonds").classList.remove("flex");
        allerA("essai");
        setTimeout(() => ($("xp-essai-url") as HTMLInputElement).focus(), 300);
      });
    });
    $("xp-essai-retour").addEventListener("click", () => allerA("agents"));

    function ligneEssai(texte: string) {
      const c = $("xp-essai-console");
      if (c.firstElementChild?.classList.contains("text-white/35")) c.innerHTML = "";
      const p = document.createElement("p");
      p.className = "xp-slide-in";
      p.innerHTML = `<span class="text-lime">•</span> ${texte}`;
      c.append(p);
      c.scrollTop = c.scrollHeight;
    }

    const REBONDS_SECOURS_ESSAI: Rebond[] = [
      { type: "creuser", libelle: "Creuser ce livrable", consigne: "Approfondis le point le plus décisif du livrable précédent." },
      { type: "ton", libelle: "Version plus premium", consigne: "Rejoue le livrable avec un positionnement plus haut de gamme." },
      { type: "contre", libelle: "Un autre angle", consigne: "Rejoue le livrable sous un angle nettement différent." },
    ];
    async function lancerEssai(consigne = "") {
      const url = ($("xp-essai-url") as HTMLInputElement).value.trim();
      if (!url || essaiEnCours) return;
      essaiEnCours = true;
      const go = $("xp-essai-go") as HTMLButtonElement;
      go.disabled = true;
      const cfg = AGENTS[agentActif];
      const texte = $("xp-essai-texte");
      const statut = $("xp-essai-statut");
      const zoneRebonds = $("xp-essai-rebonds");
      texte.innerHTML = "";
      $("xp-essai-console").innerHTML = "";
      $("xp-essai-suite").classList.add("hidden");
      zoneRebonds.classList.add("hidden");
      zoneRebonds.classList.remove("flex");
      ligneEssai("démarrage…");
      const parseur = creerParseurBlocs(texte);
      let ok = false;
      try {
        await streamIA(agentActif, cfg.demande + (consigne ? `\nAjustement demandé : ${consigne}` : ""), {
          etape: (d) => { ligneEssai(d.label); statut.textContent = d.label; },
          meta: (d) => { ligneEssai(`${d.engine} — production`); statut.textContent = `${d.engine} · en direct`; },
          delta: (d) => { parseur.delta(d.text); ok = true; },
          error: (d) => { parseur.erreur(d.message); statut.textContent = "indisponible"; },
          done: (d) => { parseur.fin(); if (ok) { statut.textContent = `produit en ${(d.ms / 1000).toFixed(1)} s`; ligneEssai(`terminé en ${(d.ms / 1000).toFixed(1)} s`); } },
        }, { siteUrl: url });
      } catch {
        parseur.erreur("La démonstration IA est momentanément indisponible — réessayez dans un instant.");
        statut.textContent = "hors ligne";
      }
      if (ok) {
        poserRebonds(zoneRebonds, parseur.rebonds, REBONDS_SECOURS_ESSAI, (r) => lancerEssai(r.consigne));
        $("xp-essai-suite").classList.remove("hidden");
        $("xp-essai-suite").classList.add("flex");
      }
      go.disabled = false;
      essaiEnCours = false;
    }
    $("xp-essai-form").addEventListener("submit", (e) => { e.preventDefault(); lancerEssai(); });

    /* ————— Projet de A à Z : chaîne d'agents avec validation entre chaque ————— */
    $("xp-vers-projet").addEventListener("click", () => allerA("projet"));

    const ETAPES_PROJET = [
      { mode: "etude_marche", nom: "Étude de marché", demande: "Produis l'étude de marché à partir du dossier ci-dessus." },
      { mode: "icp", nom: "Cible — ICP", demande: "Définis la cible idéale (ICP) à partir du dossier ci-dessus." },
      { mode: "problematiques", nom: "Problématiques — matrice ICP × IBM", demande: "Applique la matrice ICP × IBM à partir du dossier ci-dessus." },
      { mode: "axes", nom: "Axes & ton de campagne", demande: "Propose 3 axes de campagne et le ton à partir du dossier ci-dessus." },
    ];
    let projBrief = "";
    let projUrl: string | null = null;
    let projIndex = 0;
    let projEnCours = false;
    const projSorties: { nom: string; texte: string; note: string }[] = [];
    let projAxes: string[] = [];

    function majStepper(tousFaits = false) {
      document.querySelectorAll<HTMLElement>("#xp-stepper .xp-step").forEach((li) => {
        const i = parseInt(li.dataset.step!, 10);
        li.classList.toggle("xp-step-actif", !tousFaits && i === projIndex);
        li.classList.toggle("xp-step-fait", tousFaits || i < projIndex);
      });
    }

    function dossierProjet(instruction: string, extra = ""): string {
      let d = "BRIEF & OBJECTIFS DU CLIENT :\n" + projBrief + "\n";
      for (const s of projSorties) {
        d += `\n--- ${s.nom} (validé${s.note ? " ; ajustement demandé : " + s.note : ""}) ---\n${s.texte}\n`;
      }
      if (extra) d += "\n" + extra + "\n";
      return d + "\n" + instruction;
    }

    /* — Composition du brief par pastilles : tout se clique — */
    const choix: { secteur: string | null; objectif: string | null; contraintes: string[] } = { secteur: null, objectif: null, contraintes: [] };
    function majGoProjet() {
      const briefColle = ($("xp-projet-brief") as HTMLTextAreaElement).value.trim();
      ($("xp-projet-go") as HTMLButtonElement).disabled = projEnCours || !(briefColle.length >= 20 || (choix.secteur && choix.objectif));
    }
    document.querySelectorAll<HTMLElement>("[data-choix]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const groupe = btn.dataset.choix!;
        const valeur = btn.dataset.valeur!;
        if (groupe === "contrainte") {
          const i = choix.contraintes.indexOf(valeur);
          if (i >= 0) choix.contraintes.splice(i, 1);
          else if (choix.contraintes.length < 2) choix.contraintes.push(valeur);
          btn.classList.toggle("xp-opt-actif", choix.contraintes.includes(valeur));
          btn.setAttribute("aria-pressed", String(choix.contraintes.includes(valeur)));
        } else {
          (choix as any)[groupe] = valeur;
          btn.parentElement!.querySelectorAll<HTMLElement>("[data-choix]").forEach((b) => {
            const actif = b === btn;
            b.classList.toggle("xp-opt-actif", actif);
            b.setAttribute("aria-checked", String(actif));
          });
        }
        majGoProjet();
      });
    });
    $("xp-projet-brief").addEventListener("input", majGoProjet);

    function composerBrief(): string {
      const colle = ($("xp-projet-brief") as HTMLTextAreaElement).value.trim();
      const parts: string[] = [];
      if (choix.secteur) parts.push(`Client du secteur : ${choix.secteur}.`);
      if (choix.objectif) parts.push(`Objectif n°1 de la campagne : ${choix.objectif}.`);
      if (choix.contraintes.length) parts.push(`Contraintes : ${choix.contraintes.join(", ")}.`);
      if (colle) parts.push(`Brief remis par le client :\n${colle}`);
      return parts.join("\n");
    }

    $("xp-projet-form").addEventListener("submit", (e) => {
      e.preventDefault();
      if (projEnCours) return;
      const brief = composerBrief();
      if (!brief) { majGoProjet(); return; }
      projBrief = brief;
      projUrl = ($("xp-projet-url") as HTMLInputElement).value.trim() || null;
      projIndex = 0;
      projSorties.length = 0;
      projAxes = [];
      $("xp-projet-sorties").innerHTML = "";
      ($("xp-projet-go") as HTMLButtonElement).disabled = true;
      lancerEtapeProjet();
    });

    async function lancerEtapeProjet(relance = false, consigneRelance = "") {
      if (projEnCours) return;
      projEnCours = true;
      majStepper();
      const etape = ETAPES_PROJET[projIndex];
      const estAxes = projIndex === ETAPES_PROJET.length - 1;
      const titre = relance ? `${etape.nom} — autres pistes` : `${projIndex + 1}. ${etape.nom}`;

      const carte = document.createElement("div");
      carte.className = "xp-slide-in rounded-2xl border border-lime/25 bg-lime/[0.04] p-6 md:p-7";
      carte.innerHTML =
        `<div class="flex flex-wrap items-baseline justify-between gap-3">
           <div class="text-[11px] uppercase tracking-[0.22em] text-lime">${titre}</div>
           <span class="text-[11px] text-white/50" data-statut>analyse en cours…</span>
         </div>
         <div class="mt-4 min-h-[80px] space-y-3" data-texte></div>
         <div class="mt-5 hidden" data-porte></div>`;
      $("xp-projet-sorties").append(carte);
      carte.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "start" });
      const texte = carte.querySelector("[data-texte]") as HTMLElement;
      const statut = carte.querySelector("[data-statut]") as HTMLElement;
      const porte = carte.querySelector("[data-porte]") as HTMLElement;
      const parseur = creerParseurBlocs(texte);
      let brut = ""; // sortie brute accumulée : c'est elle qui nourrit le dossier des étapes suivantes

      let relanceExtra = (relance && projAxes.length)
        ? "Axes DÉJÀ proposés (ne les répète pas — propose-en 3 autres, différents) :\n" + projAxes.join("\n---\n")
        : "";
      if (relance && consigneRelance) relanceExtra += "\nDirection demandée pour cette relance : " + consigneRelance;
      let ok = false;
      try {
        await streamIA(etape.mode, dossierProjet(etape.demande, relanceExtra), {
          etape: (d) => { statut.textContent = d.label; },
          meta: (d) => { statut.textContent = `${d.engine} · en direct`; },
          delta: (d) => { parseur.delta(d.text); brut += d.text; ok = true; },
          error: (d) => { parseur.erreur(d.message); statut.textContent = "indisponible"; },
          done: (d) => { parseur.fin(); if (ok) statut.textContent = `produit en ${(d.ms / 1000).toFixed(1)} s`; },
        }, (projIndex === 0 && projUrl) ? { siteUrl: projUrl } : {});
      } catch {
        parseur.erreur("La démonstration IA est momentanément indisponible — réessayez dans un instant.");
        statut.textContent = "hors ligne";
      }
      projEnCours = false;
      if (ok) porteProjet(etape, brut, porte, estAxes, parseur.rebonds);
      else ($("xp-projet-go") as HTMLButtonElement).disabled = false;
    }

    /** Porte de validation : plus de champ vide — les rebonds de l'IA + « Continuer ». */
    function porteProjet(etape: { nom: string }, produit: string, porte: HTMLElement, estAxes: boolean, rebonds: Rebond[]) {
      porte.classList.remove("hidden");
      const avancer = (note: string) => {
        projSorties.push({ nom: etape.nom, texte: produit, note });
        porte.remove();
        projIndex += 1;
        lancerEtapeProjet();
      };
      if (!estAxes) {
        const secours: Rebond[] = [
          { type: "cadrer", libelle: "Recentrer sur le B2B", consigne: "Recentre la suite sur une cible professionnelle." },
          { type: "ton", libelle: "Plus premium", consigne: "Oriente la suite vers un positionnement plus haut de gamme." },
          { type: "creuser", libelle: "Creuser ce point", consigne: "Approfondis le point le plus décisif de l'étape précédente." },
        ];
        const intro = document.createElement("div");
        intro.className = "border-t border-white/10 pt-4";
        intro.innerHTML = `<div class="text-[11px] uppercase tracking-[0.18em] text-white/50">Ajuster le cap, ou continuer ?</div><div class="mt-2.5 flex flex-wrap gap-2" data-boutons></div>`;
        porte.append(intro);
        poserRebonds(
          intro.querySelector("[data-boutons]") as HTMLElement,
          rebonds, secours,
          (r) => avancer(r.consigne),
          [{ libelle: "Continuer tel quel →", classe: "cursor-pointer rounded-full bg-lime px-5 py-2.5 text-sm font-medium text-white hover:bg-lime/90", action: () => avancer("") }],
        );
      } else {
        projAxes.push(produit);
        majStepper(true);
        const fin = document.createElement("div");
        fin.className = "border-t border-white/10 pt-4";
        fin.innerHTML = `<div class="text-[11px] uppercase tracking-[0.18em] text-white/50">Explorer d'autres directions, ou passer à l'action ?</div><div class="mt-2.5 flex flex-wrap items-center gap-2" data-boutons></div>`;
        porte.append(fin);
        const zone = fin.querySelector("[data-boutons]") as HTMLElement;
        const secours: Rebond[] = [
          { type: "contre", libelle: "3 axes plus audacieux", consigne: "Propose trois directions plus risquées et plus clivantes." },
          { type: "contre", libelle: "Version notoriété", consigne: "Propose des axes taillés pour la mémorisation de masse." },
          { type: "contre", libelle: "Version conversion", consigne: "Propose des axes taillés pour la vente directe." },
        ];
        poserRebonds(zone, rebonds, secours, (r) => {
          porte.remove();
          lancerEtapeProjet(true, r.consigne);
        }, [
          { libelle: "Installer cette chaîne chez vous — audit 30 min →", classe: "cursor-pointer rounded-full bg-lime px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-lime/90", action: () => (document.querySelector("[data-open-booking]") as HTMLElement)?.click() },
          { libelle: "Nouveau projet", classe: "cursor-pointer rounded-full border border-white/20 px-5 py-2.5 text-sm text-white/80 transition-colors hover:border-lime hover:text-lime", action: () => {
            projIndex = 0; projSorties.length = 0; projAxes = [];
            $("xp-projet-sorties").innerHTML = "";
            majGoProjet();
            majStepper();
            vues.get("projet")!.scrollTop = 0;
          } },
        ]);
      }
    }
  </script>

  <script type="application/json" id="xp-profil-data" set:html={JSON.stringify(PROFIL)} />
</BaseLayout>
