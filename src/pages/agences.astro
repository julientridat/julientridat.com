---
/**
 * Agences — verticale de l'offre d'intégration IA.
 *
 * ELLE GARDE SA FEUILLE DE STYLE, et c'est volontaire : ses tokens sont DÉJÀ
 * ceux du design system (--paper #F1F2F4, --ink #111216, --violet #6C4CF1,
 * rayon 22 px, Geist + Instrument Serif). La réécrire en Tailwind ne changerait
 * pas un pixel et ferait perdre le scrubber J1→J60, qui est le pattern
 * signature de la page.
 *
 * CE QUI CHANGE ICI, c'est la coquille. La page vivait hors du site : son
 * propre <head>, sa propre nav, son propre pied, son propre favicon, et aucune
 * modale. Elle entre dans BaseLayout et récupère la nav, le pied, les modales
 * partagées, le balisage et l'icône du site.
 *
 * Un docblock précédent interdisait BaseLayout — « son global.css casse cette
 * DA ». C'était vrai en juillet, quand le site était en charte noire/lime et
 * cette page en papier/violet. Les deux chartes sont désormais la même, et le
 * seul CSS non calqué de global.css est un bloc :root dont les variables
 * portent d'AUTRES noms. Tout le reste, preflight Tailwind compris, est dans
 * @layer base — que du CSS non calqué bat quel que soit l'ordre. styles.css
 * est de surcroît chargée par le slot "head", donc après.
 *
 * DEUX DÉFAUTS DE CONVERSION réparés au passage :
 *   • le CTA final était un mailto: — le prospect tombait dans son client mail
 *     au lieu de l'agenda. Il ouvre désormais la modale de réservation.
 *   • la page promettait « trente minutes » là où tout le site en promet vingt.
 *
 * TEXTES : depuis le 05/10/2026, ils se modifient dans /admin
 * (src/contenu/agences.json). La mise en page et le scrubber restent ici.
 *
 * Le fond du hero est un blanc pur assumé, et non le papier du site : les
 * frames du scrubber sont détourées sur blanc, la fusion doit être totale.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/lib/site";
import agencesJson from "@/contenu/agences.json";
import { preparer, enLigne } from "@/lib/texte";

// Textes modifiables dans /admin (src/contenu/agences.json).
const c = preparer(agencesJson);
const { title, description } = agencesJson.seo;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${SITE.url}/agences#service`,
    name: "Intégration de l'IA en agence",
    description:
      "Trois chantiers pour une agence de communication, marketing, brand content ou media : outils connectés sans ressaisie, process refondus de la prise de brief à la livraison, et trois à dix agents IA sur mesure déployés sur les fonctions productives. Cinq fonctions couvertes : veille et analyse, stratégie et recommandation, production de contenu, capitalisation du savoir, créativité assistée.",
    provider: { "@id": `${SITE.url}/#julien-tridat` },
    areaServed: "FR",
    audience: {
      "@type": "BusinessAudience",
      name: "Agences de communication, marketing, brand content et media (5 à 150 personnes)",
    },
    url: `${SITE.url}/agences`,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${SITE.url}/agences`}
  jsonLd={jsonLd}
>
  <link slot="head" rel="stylesheet" href="/agences/styles.css" />

  <Nav />

  <main id="top">
    {/* ============================================================ HERO
        Le scrubber J1 → J60 est le pattern signature : la même agence,
        parcourue au survol. Piloté par /agences/main.js. */}
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-text">
          <p class="eyebrow reveal">
            <span class="dot"></span>
            <span class="eyebrow-text">{c.hero.surtitre}</span>
          </p>
          <h1 class="reveal">
            {c.hero.titreLigne1}<br class="br-desktop" />
            {c.hero.titreLigne2}<br />{c.hero.titreAvantAccent} <em class="serif">{c.hero.titreAccent}</em>{c.hero.titreApresAccent}
          </h1>
          <p class="hero-sub reveal" set:html={enLigne(c.hero.chapo, { accent: "serif" })} />
          <div class="hero-cta reveal">
            <button type="button" data-open-booking class="btn">{c.bouton}</button>
            <span class="cta-hint">{c.hero.mention}</span>
          </div>
        </div>

        <div
          class="hero-stage reveal"
          id="stage"
          role="img"
          aria-label="La même agence, du jour 1 au jour 60 : le bâtiment classique se transforme en agence augmentée par l'IA. Déplacez la souris pour parcourir la transformation."
        >
          <div class="stage-tilt" id="stageTilt">
            <canvas id="morphCanvas"></canvas>
            <noscript>
              <img
                src="/agences/hero-poster.jpg"
                alt="Agence créative"
                style="width:100%;border-radius:22px"
              />
            </noscript>
            <span class="day-counter serif" id="dayLabel" aria-hidden="true">J1</span>
          </div>
          <div class="scrub" aria-hidden="true">
            <span class="scrub-end">J1</span>
            <div class="scrub-track"><div class="scrub-fill" id="scrubFill"></div></div>
            <span class="scrub-end">J60</span>
          </div>
          <p class="stage-hint" id="stageHint">Survolez — la même agence, de J1 à J60.</p>
        </div>
      </div>
    </section>

    {/* ==================================================== 01 LE CONSTAT */}
    <section class="section" id="constat">
      <div class="container narrow">
        <p class="kicker reveal">{c.constat.surtitre}</p>
        <h2 class="reveal">{c.constat.titre}</h2>
        <p class="lead reveal" set:html={enLigne(c.constat.intro, { accent: "serif" })} />

        <ul class="pain-list">
          {c.constat.symptomes.map((p) => <li class="reveal">{p}</li>)}
        </ul>

        <p class="closer reveal">
          {c.constat.chute} <em class="serif">{c.constat.chuteAccent}</em>
        </p>
      </div>
    </section>

    {/* =================================================== 02 CAS PROUVÉS */}
    <section class="section section-alt" id="cas">
      <div class="container">
        <p class="kicker reveal">{c.cas.surtitre}</p>
        <h2 class="reveal">
          {c.cas.titre} <em class="serif">{c.cas.titreAccent}</em>
        </h2>
        <p class="lead reveal" set:html={enLigne(c.cas.intro, { accent: "serif" })} />

        <div class="cards">
          {c.cas.cartes.map((k) => (
            <article class="card cas-card reveal">
              <p class="cas-tag">{k.etiquette}</p>
              <p class="cas-pitch" set:html={enLigne(k.texte, { accent: "serif" })} />
              <dl class="cas-stats">
                {k.chiffres.map((x) => <div><dt>{x.chiffre}</dt><dd>{x.label}</dd></div>)}
              </dl>
              <a class="cas-link" href={k.lien}>{c.cas.lienCarte}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* =============================================== 03 CE QU'ON INSTALLE */}
    <section class="section" id="installation">
      <div class="container">
        <p class="kicker reveal">{c.installation.surtitre}</p>
        <h2 class="reveal">{c.installation.titre}</h2>

        <div class="cards">
          {c.installation.chantiers.map((k, i) => (
            <article class="card reveal">
              <span class="card-num serif">{i + 1}</span>
              <h3>{k.titre}</h3>
              <p set:html={enLigne(k.texte, { accent: "serif" })} />
            </article>
          ))}
        </div>

        <div class="functions reveal">
          <p class="functions-label">{c.installation.fonctionsTitre}</p>
          <ul>
            {c.installation.fonctions.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {/* ======================================================= CTA FINAL */}
    <section class="section section-cta" id="contact">
      <div class="container narrow center">
        <h2 class="reveal">{c.cloture.titre} <em class="serif">{c.cloture.titreAccent}</em></h2>
        <p class="lead reveal" set:html={enLigne(c.cloture.texte, { accent: "serif" })} />
        <div class="hero-cta reveal">
          <button type="button" data-open-booking class="btn btn-lg">{c.bouton}</button>
          <span class="cta-hint">{c.cloture.mention}</span>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script src="/agences/main.js" is:inline></script>
</BaseLayout>
