  .tf-part i:nth-child(3n) {
    background: oklch(0.72 0.22 300);
    box-shadow: 0 0 10px 2px oklch(0.72 0.22 300 / 0.6);
  }
  @keyframes tf-monte {
    0% { transform: translateY(0) scale(0.6); opacity: 0; }
    12% { opacity: 1; }
    80% { opacity: 0.7; }
    100% { transform: translateY(-330px) scale(1.15); opacity: 0; }
  }

  /* repères */
  .tf-reperes { position: absolute; inset: 0; pointer-events: none; }
  .tf-repere {
    position: absolute;
    left: var(--rx);
    top: var(--ry);
    display: flex;
