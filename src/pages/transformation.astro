  .tf-assist { border-top: 1px solid var(--line); padding-top: 1rem; }

  /* ════════ ÉTAGES ════════ */
  .tf-etage {
    display: flex;
    flex-direction: column;
    border-radius: 1rem;
    border: 1px solid var(--line);
    background: var(--card);
