    transition: border-color 0.25s ease, transform 0.25s ease, background-color 0.25s ease;
  }
  .tf-etage:hover {
    border-color: rgba(108, 76, 241, 0.5);
    transform: translateY(-3px);
    background: var(--secondary);
  }
  .tf-etage-num {
    font-family: var(--font-serif);
    font-style: italic;
