  }
  .tf-scene[data-reperes="on"] .tf-repere { opacity: 1; transform: translateY(0); }
  .tf-point {
    position: relative;
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 50%;
    background: var(--violet-soft);
    box-shadow: 0 0 0 4px rgba(185, 166, 255, 0.16);
  }
  .tf-point::after {
    content: "";
    position: absolute;
    inset: -5px;
