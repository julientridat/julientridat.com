  .tf-preuve:hover { border-color: rgba(108, 76, 241, 0.45); transform: translateY(-3px); }
  .tf-preuve-tag {
    display: inline-block;
    border-radius: 999px;
    border: 1px solid rgba(108, 76, 241, 0.3);
    padding: 3px 11px;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lime);
  }
</style>

<script>
  /* ════════ MÉTAMORPHOSE — pilotée à la souris ════════
     p = 0 → agence classique ; p = 1 → agence augmentée.
     Trois phases enchaînées : éveil (vibration) → morphose → ignition. */

  const scene = document.getElementById("tf-scene") as HTMLElement | null;
  const decor = document.getElementById("tf-decor") as HTMLElement | null;
  if (scene && decor) {
    const pct = document.getElementById("tf-pct");
    const etat = document.getElementById("tf-etat");
    const reduit = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const souris = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    let p = 0;
    let cible = 0;
    let auto = true; // la démo se joue d'abord toute seule
    let t0 = 0;
    let mx = 0.68;
    let my = 0.5;
    let near = 0;

    const clamp = (v: number, a = 0, b = 1) => (v < a ? a : v > b ? b : v);
    const lisse = (a: number, b: number, v: number) => {
      const t = clamp((v - a) / (b - a));
      return t * t * (3 - 2 * t);
    };

    /* Séquence automatique : on laisse voir l'agence telle quelle, puis ça se met
       à vibrer, puis la forme bascule, puis les lumières prennent. */
    const SEQ: [number, number][] = [
      [0, 0],
      [1700, 0], // l'agence, normale
      [3100, 0.24], // quelque chose commence
      [4900, 0.72], // la forme bascule
      [6100, 1], // les lumières s'allument
      [8600, 1], // on contemple
      [10200, 0], // retour au calme, la main passe au visiteur
    ];
    const jouerAuto = (t: number) => {
      if (t >= SEQ[SEQ.length - 1][0]) return null;
      for (let i = 0; i < SEQ.length - 1; i++) {
        const [ta, va] = SEQ[i];
        const [tb, vb] = SEQ[i + 1];
        if (t >= ta && t < tb) {
          const k = (t - ta) / (tb - ta);
          return va + (vb - va) * (k * k * (3 - 2 * k));
        }
      }
      return null;
    };

    /* Proximité du curseur → énergie. Le bâtiment est centré à ~68 % de la largeur. */
    let bouges = 0;
    const onMove = (e: PointerEvent) => {
      const r = decor.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width;
      const y = (e.clientY - r.top) / r.height;
      mx = x;
      my = y;
      scene.style.setProperty("--mx", `${x * 100}%`);
      scene.style.setProperty("--my", `${y * 100}%`);
      const dx = (x - 0.68) * (r.width / r.height);
      const dy = y - 0.52;
      const d = Math.sqrt(dx * dx + dy * dy);
      near = clamp(1 - (d - 0.12) / 0.55);
      /* Le visiteur bouge vraiment la souris : il reprend la main sur la démo. */
      if (auto && ++bouges > 3) auto = false;
      cible = near;
    };

    const onLeave = () => {
      near = 0;
      if (!auto) cible = 0;
    };

    /* Mouvement réduit : on affiche l'état transformé, point. Aucun écouteur n'est
       posé — sinon le curseur ou le défilement relanceraient toute la métamorphose. */
    if (reduit) {
      auto = false;
      p = 1;
      cible = 1;
    } else if (souris) {
      scene.addEventListener("pointermove", onMove, { passive: true });
      scene.addEventListener("pointerleave", onLeave, { passive: true });
    } else {
      /* Sans souris : le défilement pilote la métamorphose. */
      const onScroll = () => {
        if (auto) return;
        const r = decor.getBoundingClientRect();
        const k = clamp((window.innerHeight * 0.85 - r.top) / (r.height * 0.75));
        cible = k;
      };
      window.addEventListener("scroll", onScroll, { passive: true });
    }

    /* Boucle : une seule écriture de styles par image. */
    let raf = 0;
    const boucle = (t: number) => {
      if (!t0) t0 = t;
      if (auto) {
        const v = jouerAuto(t - t0);
        if (v === null) {
          /* La démo boucle tant que le visiteur n'a pas vraiment pris la main
             (voir bouges>3 dans onMove) — sinon un visiteur qui ne touche pas
             sa souris voit la scène se figer à 0 % en permanence. */
          t0 = t;
          p = 0;
        } else {
          p = v;
        }
      }
      if (!auto) p += (cible - p) * 0.085;

      const rev = lisse(0.24, 0.74, p);
      const lum = lisse(0.62, 1, p);
      /* la vibration culmine au moment du basculement puis retombe */
      const vib = reduit ? 0 : lisse(0.03, 0.3, p) * (1 - lisse(0.55, 0.92, p));

      let sx = 0;
      let sy = 0;
      let rot = 0;
      if (vib > 0.001) {
        const a = vib * 5.5;
        sx = (Math.sin(t * 0.081) + Math.sin(t * 0.213)) * a * 0.5;
        sy = (Math.sin(t * 0.114) + Math.sin(t * 0.271)) * a * 0.32;
        rot = Math.sin(t * 0.063) * vib * 0.32;
      }

      const s = scene.style;
      s.setProperty("--p", p.toFixed(4));
      s.setProperty("--rev", rev.toFixed(4));
      s.setProperty("--lum", lum.toFixed(4));
      s.setProperty("--vib", vib.toFixed(4));
      s.setProperty("--sx", `${sx.toFixed(2)}px`);
      s.setProperty("--sy", `${sy.toFixed(2)}px`);
      s.setProperty("--rot", `${rot.toFixed(3)}deg`);
      s.setProperty("--near", near.toFixed(3));
      if (souris && !reduit) {
        s.setProperty("--ty", `${((mx - 0.5) * 6).toFixed(2)}deg`);
        s.setProperty("--tx", `${((0.5 - my) * 3.4).toFixed(2)}deg`);
      }

      const n = Math.round(p * 100);
      if (pct && pct.textContent !== `${n} %`) pct.textContent = `${n} %`;
      if (etat) {
        const txt = p < 0.22 ? "agence classique" : p < 0.72 ? "métamorphose en cours" : "agence augmentée";
        if (etat.textContent !== txt) etat.textContent = txt;
      }
      const rep = p > 0.88 ? "on" : "off";
      if (scene.dataset.reperes !== rep) scene.dataset.reperes = rep;
      /* L'invitation ne s'affiche que quand il ne se passe rien. */
      const ind = !auto && souris && p < 0.1 ? "on" : "off";
      if (scene.dataset.indice !== ind) scene.dataset.indice = ind;

      raf = requestAnimationFrame(boucle);
    };

    /* On ne démarre qu'une fois la scène visible (et on met en pause hors écran). */
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting && !raf) {
            t0 = 0;
            raf = requestAnimationFrame(boucle);
          } else if (!en.isIntersecting && raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        }
      },
      { threshold: 0.15 },
    );
    if (reduit) {
      /* État final posé une fois pour toutes : aucune boucle d'animation ne démarre. */
      const s = scene.style;
      s.setProperty("--p", "1");
      s.setProperty("--rev", "1");
      s.setProperty("--lum", "1");
      scene.dataset.reperes = "on";
      if (pct) pct.textContent = "100 %";
      if (etat) etat.textContent = "agence augmentée";
    } else {
      io.observe(scene);
    }
  }

  /* ════════ L'ESSAI — on lit le site de l'agence, on rend le portrait ════════
     Le worker renvoie des lignes TOKEN|champ|champ (une par bloc visuel) en flux ;
     on les rend au fil de l'eau. Le contenu du site du visiteur est traité côté
     serveur comme une donnée, jamais comme une consigne. */

  const form = document.getElementById("ag-form") as HTMLFormElement | null;
  if (form) {
    const $ = (id: string) => document.getElementById(id)!;
    const champ = $("ag-url") as HTMLInputElement;
    const go = $("ag-go") as HTMLButtonElement;
    const etapes = $("ag-etapes");
    const res = $("ag-res");
    const err = $("ag-err");
    const offres = $("ag-offres");
    const chaine = $("ag-chaine");

    let enCours = false;

    const etape = (txt: string) => {
      etapes.querySelectorAll(".ag-etape").forEach((e) => ((e as HTMLElement).dataset.fini = "1"));
      const d = document.createElement("div");
      d.className = "ag-etape";
      d.textContent = txt;
      etapes.append(d);
    };

    const raz = () => {
      etapes.replaceChildren();
      offres.replaceChildren();
      chaine.replaceChildren();
      err.hidden = true;
      res.hidden = true;
      (document.getElementById("ag-repli") as HTMLFormElement).hidden = true;
      for (const id of ["ag-offres-bloc", "ag-chaine-bloc", "ag-garde", "ag-suite", "ag-tension-bloc"])
        $(id).hidden = true;
      for (const id of [
        "ag-actuel", "ag-preuve", "ag-devenir", "ag-devenir-txt", "ag-signature",
        "ag-tension", "ag-terrain", "ag-garde",
      ]) $(id).textContent = "";
    };

    /* Le modèle écrit parfois en style télégraphique : on rétablit la majuscule
       initiale et on retire la préposition qui doublerait l'étiquette « Se vend à ». */
    const majuscule = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
    const sansPreposition = (s: string) => s.replace(/^(aux|au|à la|à l'|à|pour les|pour)\s+/i, "");

    /* Une ligne du protocole = un bloc visuel. Toute ligne non conforme est ignorée. */
    const rendre = (ligne: string) => {
      const [token, ...champs] = ligne.split("|").map((s) => s.trim());
      if (!token) return;
      switch (token) {
        case "MARQUE":
        case "ACTUEL":
          res.hidden = false;
          $("ag-actuel").textContent = majuscule(champs[0] ?? "");
          break;
        case "PREUVE":
        case "LEVIER":
          $("ag-preuve").textContent = majuscule(champs[0] ?? "");
          break;
        case "TENSION":
          if (!champs[0]) return;
          $("ag-tension-bloc").hidden = false;
          $("ag-tension").textContent = majuscule(champs[0]);
          break;
        case "TERRAIN":
          if (!champs[0]) return;
          $("ag-tension-bloc").hidden = false;
          $("ag-terrain").textContent = majuscule(champs[0]);
          break;
        case "SIGNATURE": {
          const sig = champs[0] ?? "";
          if (sig) $("ag-signature").textContent = `« ${majuscule(sig).replace(/[.\s]+$/, "")} »`;
          break;
        }
        case "DEVENIR":
          res.hidden = false;
          $("ag-devenir").textContent = majuscule(champs[0] ?? "");
          $("ag-devenir-txt").textContent = majuscule(champs[1] ?? "");
          break;
        case "OFFRE": {
          if (!champs[0] || offres.children.length >= 4) return;
          $("ag-offres-bloc").hidden = false;
          const n = offres.children.length + 1;
          const art = document.createElement("article");
          art.className = "ag-offre";
          art.style.animationDelay = `${(n - 1) * 0.09}s`;
          const num = document.createElement("span");
          num.className = "ag-offre-n";
          num.textContent = `0${n}`;
          const nom = document.createElement("h4");
          nom.className = "ag-offre-nom";
          nom.textContent = majuscule(champs[0]);
          const quoi = document.createElement("p");
          quoi.className = "ag-offre-quoi";
          quoi.textContent = majuscule(champs[1] ?? "");
          art.append(num, nom, quoi);
          if (champs[2]) {
            const qui = document.createElement("p");
            qui.className = "ag-offre-qui";
            const lab = document.createElement("b");
            lab.textContent = "Se vend à";
            qui.append(lab, document.createTextNode(majuscule(sansPreposition(champs[2]))));
            art.append(qui);
          }
          if (champs[3]) {
            const lib = document.createElement("p");
            lib.className = "ag-offre-libere";
            const lab2 = document.createElement("b");
            lab2.textContent = "Ce que ça change";
            lib.append(lab2, document.createTextNode(majuscule(champs[3])));
            art.append(lib);
          }
          offres.append(art);
          break;
        }
        case "CHAINE": {
          const pas = (champs[0] ?? "").split(">").map((s) => s.trim()).filter(Boolean).slice(0, 5);
          if (!pas.length) return;
          $("ag-chaine-bloc").hidden = false;
          chaine.replaceChildren();
          pas.forEach((p, i) => {
            const li = document.createElement("li");
            li.style.animationDelay = `${i * 0.08}s`;
            const s = document.createElement("span");
            s.textContent = `Étape ${i + 1}`;
            li.append(s, document.createTextNode(majuscule(p)));
            chaine.append(li);
          });
          break;
        }
        case "GARDE": {
          const g = $("ag-garde");
          g.hidden = false;
          g.textContent = majuscule(champs[0] ?? "");
          break;
        }
      }
    };

    const analyser = async (siteUrl: string | null, description = "") => {
      enCours = true;
      const bouton = (siteUrl ? go : (document.querySelector(".ag-go-repli") as HTMLButtonElement)) ?? go;
      bouton.disabled = true;
      bouton.dataset.charge = "1";
      raz();
      etape(siteUrl ? "connexion…" : "lecture de votre description…");

      try {
        const rep = await fetch("/api/experience", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            mode: "agence",
            ...(siteUrl ? { siteUrl } : {}),
            ...(description ? { profil: `Description de son agence par le visiteur : ${description}` } : {}),
            messages: [
              {
                role: "user",
                content:
                  "Montre-moi l'agence que je pourrais devenir en exploitant pleinement l'IA générative, et ce que je pourrais vendre en plus.",
              },
            ],
          }),
        });

        if (rep.status === 429) throw new Error("Beaucoup de monde teste en ce moment. Réessayez dans quelques minutes.");
        if (rep.status === 400) throw new Error("Cette adresse ne semble pas valide. Vérifiez, puis réessayez.");
        if (!rep.ok || !rep.body) throw new Error("L'analyse n'a pas pu démarrer. Réessayez dans un instant.");

        const lecteur = rep.body.getReader();
        const dec = new TextDecoder();
        let tampon = "";
        let texte = "";
        let renduJusqua = 0;
        let fini = false;

        while (!fini) {
          const { done, value } = await lecteur.read();
          if (done) break;
          tampon += dec.decode(value, { stream: true });
          const blocs = tampon.split("\n\n");
          tampon = blocs.pop() ?? "";

          for (const bloc of blocs) {
            let evt = "message";
            let data = "";
            for (const l of bloc.split("\n")) {
              if (l.startsWith("event: ")) evt = l.slice(7);
              else if (l.startsWith("data: ")) data += l.slice(6);
            }
            if (!data) continue;
            let p: any;
            try {
              p = JSON.parse(data);
            } catch {
              continue;
            }

            if (evt === "etape") etape(p.label);
            else if (evt === "error") throw new Error(p.message || "Analyse impossible.");
            else if (evt === "delta") {
              texte += p.text ?? "";
              /* on ne rend que les lignes complètes */
              const lignes = texte.split("\n");
              for (let i = renduJusqua; i < lignes.length - 1; i++) {
                const l = lignes[i].trim();
                if (l === "FIN") { fini = true; break; }
                if (l) rendre(l);
              }
              renduJusqua = Math.max(renduJusqua, lignes.length - 1);
            } else if (evt === "done") {
              const reste = texte.split("\n").slice(renduJusqua).map((s) => s.trim());
              for (const l of reste) {
                if (l === "FIN" || !l) continue;
                rendre(l);
              }
              fini = true;
            }
          }
        }

        if (!$("ag-actuel").textContent && !$("ag-devenir").textContent && !offres.children.length) {
          throw new Error(
            "Je n'ai pas réussi à lire assez de contenu sur ce site — il est peut-être entièrement construit en JavaScript, ou protégé. Écrivez-moi, on le fera à la main.",
          );
        }
        etape("portrait terminé.");
        $("ag-suite").hidden = false;
      } catch (e) {
        etapes.replaceChildren();
        err.hidden = false;
        err.textContent = e instanceof Error ? e.message : "Une erreur est survenue.";
        /* Lecture impossible : on propose de décrire l'agence plutôt que d'en rester là. */
        if (siteUrl) {
          const repli = document.getElementById("ag-repli") as HTMLFormElement;
          repli.hidden = false;
          (document.getElementById("ag-desc") as HTMLTextAreaElement)?.focus();
        }
      } finally {
        enCours = false;
        bouton.disabled = false;
        delete bouton.dataset.charge;
      }
    };

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (enCours) return;
      const v = champ.value.trim().replace(/^https?:\/\//i, "").replace(/\/+$/, "");
      if (!v || !v.includes(".")) {
        err.hidden = false;
        err.textContent = "Indiquez l'adresse de votre site, par exemple votre-agence.fr";
        return;
      }
      analyser(v);
      document.getElementById("ag-etapes")?.scrollIntoView({ block: "center", behavior: "smooth" });
    });

    document.getElementById("ag-repli")?.addEventListener("submit", (e) => {
      e.preventDefault();
      if (enCours) return;
      const d = (document.getElementById("ag-desc") as HTMLTextAreaElement).value.trim();
      if (d.length < 15) {
        err.hidden = false;
        err.textContent = "Donnez-moi un peu plus de matière : votre métier, votre taille, vos clients.";
        return;
      }
      analyser(null, d.slice(0, 400));
    });

    document.getElementById("ag-refaire")?.addEventListener("click", () => {
      raz();
      champ.value = "";
      champ.focus();
      form.scrollIntoView({ block: "center", behavior: "smooth" });
    });
  }
</script>
