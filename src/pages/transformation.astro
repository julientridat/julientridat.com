<style is:global>
  /* ════════ LA SCÈNE ════════ */
  .tf-scene {
    position: relative;
    /* Le visuel est en 16:9 ; c'est la largeur qui cède, jamais le ratio.
       Le texte est superposé dans la même cellule de grille : s'il lui faut plus
       de hauteur que le 16:9 n'en offre, c'est la scène qui grandit. */
    /* Le plancher de 1080px évite d'étrangler la colonne de texte sur les
       fenêtres basses (où brider par la hauteur rétrécirait aussi la largeur). */
    width: min(100%, max(1080px, calc((100vh - 5rem) * 16 / 9)));
    margin-inline: auto;
    display: grid;
    grid-template-areas: "scene";
    isolation: isolate;
    --p: 0;      /* progression globale 0→1 */
    --vib: 0;    /* amplitude de vibration */
    --rev: 0;    /* front de métamorphose */
    --lum: 0;    /* intensité des lumières */
    --sx: 0px;
    --sy: 0px;
    --rot: 0deg;
    --tx: 0deg;
    --ty: 0deg;
    --mx: 50%;
    --my: 50%;
    --near: 0;   /* proximité du curseur */
    /* Le hero garde un fond volontairement sombre (registre photo/vidéo du site) :
       littéral, indépendant de --background qui porte désormais le papier clair. */
    background:
      radial-gradient(120% 90% at 68% 42%, oklch(0.28 0.06 300 / calc(0.42 * var(--lum))), transparent 62%),
      radial-gradient(90% 70% at 30% 10%, rgba(185, 166, 255, 0.05), transparent 70%),
      #111216;
  }

  /* le cadre du visuel : 16:9, centré, seul à rogner ce qui déborde */
  .tf-decor {
    grid-area: scene;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    align-self: center;
    overflow: hidden;
    perspective: 1400px;
  }

  /* sol en perspective */
  .tf-sol {
    position: absolute;
    inset: auto 0 0 0;
    height: 34%;
    background:
      linear-gradient(to top, rgba(185, 166, 255, calc(0.1 * var(--lum))), transparent 60%),
      repeating-linear-gradient(90deg, oklch(1 0 0 / 0.05) 0 1px, transparent 1px 74px),
      repeating-linear-gradient(0deg, oklch(1 0 0 / 0.05) 0 1px, transparent 1px 46px);
    transform: perspective(320px) rotateX(58deg);
    transform-origin: bottom center;
    opacity: calc(0.22 + 0.5 * var(--lum));
    mask-image: linear-gradient(to top, #000 8%, transparent 88%);
    -webkit-mask-image: linear-gradient(to top, #000 8%, transparent 88%);
  }

  /* halo au sol sous le bâtiment */
  .tf-halo-sol {
    position: absolute;
    left: 68%;
    bottom: 6%;
    width: 46%;
    height: 13%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      oklch(0.65 0.22 300 / calc(0.16 + 0.55 * var(--lum))),
      transparent 78%
    );
    filter: blur(18px);
  }

  /* halo qui suit le curseur */
  .tf-halo-curseur {
    position: absolute;
    left: var(--mx);
    top: var(--my);
    width: 460px;
    height: 460px;
    margin: -230px 0 0 -230px;
    border-radius: 50%;
    pointer-events: none;
    opacity: calc(0.1 + 0.55 * var(--near));
    background: radial-gradient(
      closest-side,
      rgba(185, 166, 255, 0.16),
      rgba(185, 166, 255, 0.05) 45%,
      transparent 72%
    );
    transition: opacity 0.35s ease;
  }

  /* volume */
  .tf-stage {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(var(--tx)) rotateY(var(--ty));
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tf-shake {
    position: absolute;
    inset: 0;
    transform: translate3d(var(--sx), var(--sy), 0) rotate(var(--rot));
  }
  .tf-vol {
    position: absolute;
    left: 68%;
    bottom: 4%;
    width: min(46%, 620px);
    aspect-ratio: 800 / 820;
    transform: translateX(-50%) scale(calc(1 + 0.035 * var(--p)));
    transform-origin: bottom center;
  }
  .tf-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom center;
  }
  .tf-av {
    opacity: calc(1 - var(--rev));
    filter: saturate(calc(1 - 0.35 * var(--p))) brightness(calc(1 - 0.12 * var(--p)));
  }
  /* la métamorphose monte du sol vers le toit */
  .tf-ap {
    opacity: 1;
    mask-image: linear-gradient(
      to top,
      #000 calc(var(--rev) * 132% - 16%),
      transparent calc(var(--rev) * 132% + 6%)
    );
    -webkit-mask-image: linear-gradient(
      to top,
      #000 calc(var(--rev) * 132% - 16%),
      transparent calc(var(--rev) * 132% + 6%)
    );
  }
  .tf-lum {
    mix-blend-mode: screen;
    opacity: var(--lum);
    filter: saturate(1.25);
  }
  /* front lumineux de la transformation */
  .tf-front {
    position: absolute;
    left: -6%;
    right: -6%;
    bottom: calc(var(--rev) * 100%);
    height: 3px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--violet-soft), oklch(0.7 0.24 300), transparent);
    box-shadow: 0 0 34px 8px rgba(185, 166, 255, 0.42);
    opacity: calc(4 * var(--rev) * (1 - var(--rev)));
  }

  /* particules */
  .tf-part {
    position: absolute;
    left: 68%;
    bottom: 4%;
    width: min(46%, 620px);
    height: 74%;
    transform: translateX(-50%);
    pointer-events: none;
    opacity: var(--lum);
  }
  .tf-part i {
    position: absolute;
    left: var(--lx);
    bottom: 0;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--violet-soft);
