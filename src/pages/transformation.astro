  .ag-repli textarea::placeholder { color: oklch(1 0 0 / 0.28); }
  .ag-repli textarea:focus { border-color: var(--violet-soft); box-shadow: 0 0 0 4px rgba(185, 166, 255, 0.12); }
  .ag-go-repli { align-self: flex-start; }

  .ag-err {
    margin: 2rem auto 0; max-width: 40rem;
