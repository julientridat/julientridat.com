---
/**
 * Mise en pause — non indexée (pas de `canonical`), non liée (retirée du
 * Footer), absente de sitemap.xml et llms.txt.
 *
 * Coexiste avec la LP "/agences" (one-page prix fermes, scrubber J1→J60) sur
 * le même positionnement agences. Julien compare les deux en privé avant de
 * choisir laquelle garder — voir échange du 2026-07-31.
 *
 * Pour la republier : remettre `canonical={`${SITE.url}/transformation`}`
 * ci-dessous, remettre le lien dans Footer.astro, et les entrées dans
 * sitemap.xml.ts / llms.txt.ts.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Nav from "@/components/Nav.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import CtaButton from "@/components/CtaButton.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/lib/site";

/* Faits tirés de missions réelles en agence — voir les fiches liées. Rien d'inventé. */
const faits = [
  {
    chiffre: "1 h 30",
    unite: "par jour et par personne",
    detail: "récupérées dans une agence de communication santé de 16 personnes, sur la production de contenus sourcés",
    href: "/realisations/formation-ia-agence-sante",
  },
  {
    chiffre: "4",
    unite: "assistants métier",
    detail: "livrés à une agence créative de 40 talents, prêts à produire dès le lendemain, pôle commercial et pôle création",
    href: "/realisations/agents-agence-creative",
  },
  {
    chiffre: "14",
    unite: "personnes autonomes",
    detail: "l'équipe texte entière montée en autonomie, avec 3 assistants qui tournent toujours après mon départ",
    href: "/realisations/formation-ia-agence-sante",
  },
];

/* Assistants réellement installés en agence (cas agents-agence-creative et
   formation-ia-agence-sante). Ce sont des livrables, pas des promesses. */
const assistants = [
  { nom: "Préparation de rendez-vous", quoi: "La fiche du prospect, ses angles et ses points d'attention, prêtes avant le rendez-vous." },
  { nom: "Compte rendu & brief créa", quoi: "La réunion client devient un brief créatif exploitable, au format de l'agence." },
  { nom: "Veille client", quoi: "Les mouvements du marché de l'annonceur, résumés pour nourrir la recommandation." },
  { nom: "Retours & passation", quoi: "Les retours client consolidés et transmis sans perte entre les pôles." },
];

const etages = [
  {
    num: "01",
    titre: "Savoir où l'IA a sa place",
    texte:
      "Cartographier les tâches réelles de vos pôles, chiffrer les priorités, distinguer ce qui s'automatise de ce qui se juge. Avant d'acheter la moindre licence.",
    lien: "/realisations#cadrer",
  },
  {
    num: "02",
    titre: "Outiller les pôles, pas l'agence en général",
    texte:
      "Le commercial et la création n'ont pas les mêmes gestes. Chaque pôle repart avec ses assistants, calibrés sur le style de la maison.",
    lien: "/realisations#former",
  },
  {
    num: "03",
    titre: "Encoder ce qui vous distingue",
    texte:
      "Votre charte, vos formats, vos autorités de référence, votre ton. C'est ce qui rend la production assistée conforme — et défendable devant l'annonceur.",
    lien: "/realisations#produire",
  },
  {
    num: "04",
    titre: "Vendre ce que vous ne pouviez pas vendre",
    texte:
      "Une fois la chaîne en place, des offres deviennent rentables qui ne l'étaient pas : abonnements de contenus, chartes exécutables, ateliers de mise en main.",
    lien: "/realisations",
  },
];

const temps = [
  { t: "Cadrage", d: "Vos vraies journées, pôle par pôle. Ce qui coûte du temps, en heures — pas en promesses." },
  { t: "Construction", d: "Les assistants sont bâtis sur vos dossiers, vos formats, votre charte." },
  { t: "Déploiement", d: "Installés dans l'agence, essayés sur de vrais projets, corrigés." },
  { t: "Transmission", d: "Les pôles pilotent seuls. Les assistants tournent après mon départ." },
];

const preuves = [
  {
    href: "/realisations/agents-agence-creative",
    tag: "Agence créative · 40 talents",
    titre: "Deux ans de formations, et toujours rien qui tournait au quotidien",
    ligne: "Quatre assistants métier livrés, prêts à produire dès le lendemain — et une règle de confidentialité défendable face aux annonceurs.",
  },
  {
    href: "/realisations/formation-ia-agence-sante",
    tag: "Agence santé · 16 personnes",
    titre: "Chaque contenu médical sourcé à la main, tout à renuméroter au moindre changement",
    ligne: "Premier jet déjà sourcé sur leurs propres autorités de référence. Une heure trente récupérée par jour et par personne.",
  },
  {
    href: "/realisations/cartographie-ia-agence",
    tag: "Agence de communication",
    titre: "L'envie de passer à l'IA, mais aucune boussole pour investir",
    ligne: "Ce qui s'automatise, ce qui se juge, et dans quel ordre. Une base de décision que l'agence tient elle-même.",
  },
];

/* Points chauds posés sur le volume (coordonnées en % du cadre de la scène).
   Tous ouvrent vers la droite : la moitié gauche appartient au texte. */
const reperes = [
  { x: 73, y: 30, label: "L'étage", detail: "Là où se décide la stratégie" },
  { x: 57, y: 47, label: "L'enseigne", detail: "Ce que vous montrez au marché" },
  { x: 68, y: 71, label: "L'atelier", detail: "Là où le travail sort" },
  { x: 62, y: 91, label: "Les fondations", detail: "La méthode qui reste" },
];

const title = "Quelle agence pourriez-vous devenir avec l'IA générative ? | Julien Tridat";
const description =
  "Donnez l'adresse de votre agence : l'analyse lit votre site et vous montre le type d'agence que vous pourriez devenir, et les offres que vous pourriez vendre en exploitant l'IA générative. Cas d'agences documentés.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "Quelle agence pourriez-vous devenir avec l'IA générative ?",
    description,
    url: `${SITE.url}/transformation`,
    author: { "@id": `${SITE.url}/#julien-tridat` },
    primaryImageOfPage: `${SITE.url}/scene/agence-apres.webp`,
    audience: {
      "@type": "Audience",
      audienceType: "Agences de communication, de publicité, de design, studios créatifs",
    },
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/scene/agence-avant.webp" />
    <link rel="preload" as="image" href="/scene/agence-apres.webp" />
  </Fragment>

  <main class="bg-background text-foreground">
    <!-- ══════════ HERO — LA MÉTAMORPHOSE ══════════ -->
    <header class="relative overflow-hidden">
      <Nav onDark />

      <div class="tf-scene" id="tf-scene" data-state="repos">
        <!-- Le cadre 16:9 du visuel. Séparé du texte : si le texte a besoin de plus de
             hauteur (fenêtre basse, texte agrandi), il pousse la scène au lieu d'être rogné. -->
        <div class="tf-decor" id="tf-decor" aria-hidden="true">
        <div class="tf-sol"></div>
        <div class="tf-halo-sol"></div>
        <div class="tf-halo-curseur"></div>

        <!-- le volume -->
        <div class="tf-stage" aria-hidden="true">
          <div class="tf-shake">
            <div class="tf-vol">
              <img class="tf-img tf-av" src="/scene/agence-avant.webp" alt="" width="800" height="820" fetchpriority="high" />
              <img class="tf-img tf-ap" src="/scene/agence-apres.webp" alt="" width="800" height="820" fetchpriority="high" />
              <img class="tf-img tf-lum" src="/scene/agence-lumieres.webp" alt="" width="800" height="820" loading="lazy" />
              <div class="tf-front"></div>
            </div>
          </div>
        </div>

        <!-- particules d'énergie -->
        <div class="tf-part" aria-hidden="true">
          {Array.from({ length: 14 }).map((_, i) => (
            <i style={`--i:${i}; --lx:${8 + ((i * 37) % 84)}%; --ld:${(i % 7) * 0.42}s; --lt:${3.4 + (i % 5) * 0.7}s`}></i>
          ))}
        </div>

        <!-- repères qui s'allument en fin de métamorphose -->
        <div class="tf-reperes">
          {reperes.map((r, i) => (
            <div class="tf-repere" style={`--rx:${r.x}%; --ry:${r.y}%; --ri:${i}`}>
              <span class="tf-point"></span>
              <span class="tf-trait"></span>
              <span class="tf-etiq">
                <b>{r.label}</b>
                {r.detail}
              </span>
            </div>
          ))}
        </div>
        </div><!-- /tf-decor -->

        <!-- texte en surimpression -->
        <div class="tf-texte">
          <p class="mb-6 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-violet-soft">
            <span class="h-px w-6 bg-violet-soft"></span>
            Pour les agences
          </p>
          <h1 class="tf-h1">
            Votre agence ne change pas d'outils.<br />
            <em class="text-violet-soft">Elle change de forme.</em>
          </h1>
          <p class="tf-sub">
            L'IA générative ne remplace pas vos créatifs : elle industrialise ce qui les épuise et
            ouvre des offres que vous ne pouvez pas vendre aujourd'hui, faute de temps.
          </p>
          <div class="tf-cta">
            <a
              href="#tester"
              class="group inline-flex cursor-pointer items-center gap-3 rounded-full bg-lime px-6 py-3.5 text-[15px] font-medium text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-lime/90"
            >
              <span class="grid h-7 w-7 place-items-center rounded-full bg-black/25 text-base transition-transform group-hover:translate-y-0.5">
                ↓
              </span>
              <span>Tester mon agence</span>
            </a>
            <a
              href="#preuves"
              class="inline-flex items-center gap-2 rounded-full border border-white/20 px-6 py-3.5 text-[15px] text-white/85 transition-colors hover:border-violet-soft hover:text-violet-soft"
            >
              Voir des agences transformées
            </a>
          </div>
        </div>

        <!-- pilotage + indice -->
        <div class="tf-jauge" aria-hidden="true">
          <div class="tf-jauge-piste"><span></span></div>
          <div class="tf-jauge-txt"><b id="tf-pct">0 %</b> <span id="tf-etat">agence classique</span></div>
        </div>
        <p class="tf-indice" id="tf-indice" aria-hidden="true">
          <span class="tf-indice-pt"></span> Approchez le curseur du bâtiment
        </p>
      </div>

      <!-- équivalent textuel de la scène, pour lecteurs d'écran et robots -->
      <p class="sr-only">
        Animation : une agence classique se transforme sous vos yeux en agence augmentée par
        l'IA — la façade se réorganise, les postes de travail s'éclairent, quatre repères
        apparaissent : l'enseigne, l'étage de décision, l'atelier de production et les
        fondations méthodologiques.
      </p>
    </header>

    <!-- ══════════ L'ESSAI : TESTEZ VOTRE AGENCE ══════════ -->
    <!-- Registre volontairement sombre : démo IA en direct, continuité visuelle avec le hero. -->
    <section id="tester" class="relative scroll-mt-6 overflow-hidden border-t border-white/10 bg-foreground px-6 py-20 text-white md:px-12 md:py-28">
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background: radial-gradient(900px 500px at 50% 0%, rgba(185,166,255,0.07), transparent 68%);"
      >
      </div>

      <div class="mx-auto max-w-4xl text-center">
        <p class="mb-6 inline-flex items-center justify-center gap-2 text-[11px] uppercase tracking-[0.22em] text-violet-soft">
          <span class="h-px w-6 bg-violet-soft"></span>
          L'essai — moins d'une minute
        </p>
        <h2 class="mx-auto max-w-3xl text-[clamp(2rem,4.4vw,3.4rem)] font-light leading-[1.06] tracking-[-0.03em]">
          Quelle agence pourriez-vous <em class="text-violet-soft">devenir ?</em>
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-[16px] leading-relaxed text-white/65">
          Donnez l'adresse de votre site. Je lis vos pages — vos métiers, vos clients, votre ton —
          et je vous montre le type d'agence que vous pourriez devenir, avec les offres que vous
          pourriez vendre en exploitant vraiment l'IA générative.
        </p>

        <form class="ag-form" id="ag-form" novalidate>
          <div class="ag-champ">
            <span class="ag-prefixe" aria-hidden="true">https://</span>
            <input
              type="text"
              id="ag-url"
              name="url"
              inputmode="url"
              autocomplete="url"
              spellcheck="false"
              placeholder="votre-agence.fr"
              aria-label="Adresse du site de votre agence"
              required
            />
          </div>
          <button type="submit" id="ag-go" class="ag-go">
            <span class="ag-go-txt">Analyser mon agence</span>
            <span class="ag-go-spin" aria-hidden="true"></span>
          </button>
        </form>
        <p class="ag-note" id="ag-note">
          Lecture publique de votre site, comme le ferait un moteur de recherche. Rien n'est
          enregistré, aucune adresse email demandée.
        </p>
      </div>

      <!-- déroulé de l'analyse -->
      <div class="ag-etapes" id="ag-etapes" aria-live="polite"></div>

      <!-- résultat -->
      <div class="ag-res" id="ag-res" hidden>
        <div class="ag-bascule">
          <article class="ag-volet ag-volet-av">
            <span class="ag-volet-tag">Votre marque aujourd'hui</span>
            <p class="ag-actuel" id="ag-actuel"></p>
            <p class="ag-preuve" id="ag-preuve"></p>
          </article>

          <div class="ag-fleche" aria-hidden="true">
            <span></span><em>devient</em><span></span>
          </div>

          <article class="ag-volet ag-volet-ap">
            <span class="ag-volet-tag">L'agence que vous pourriez devenir</span>
            <h3 class="ag-devenir" id="ag-devenir"></h3>
            <p class="ag-devenir-txt" id="ag-devenir-txt"></p>
            <p class="ag-signature" id="ag-signature"></p>
          </article>
        </div>

        <div class="ag-tension-bloc" id="ag-tension-bloc" hidden>
          <div class="ag-tension">
            <span class="ag-mini-tag">Ce qui coince aujourd'hui</span>
            <p id="ag-tension"></p>
          </div>
          <div class="ag-terrain">
            <span class="ag-mini-tag">Le terrain que vous occupez alors</span>
            <p id="ag-terrain"></p>
          </div>
        </div>

        <div class="ag-offres-bloc" id="ag-offres-bloc" hidden>
          <h3 class="ag-sous-titre">Ce que vous pourriez vendre <span>en plus</span></h3>
          <div class="ag-offres" id="ag-offres"></div>
        </div>

        <div class="ag-chaine-bloc" id="ag-chaine-bloc" hidden>
          <h3 class="ag-sous-titre">Votre nouvelle chaîne de production</h3>
          <ol class="ag-chaine" id="ag-chaine"></ol>
        </div>

        <p class="ag-garde" id="ag-garde" hidden></p>

        <div class="ag-suite" id="ag-suite" hidden>
          <p>
            Ce portrait est une hypothèse produite à partir de votre site public — pas un audit.
            La version sérieuse dure trente minutes et se fait avec vous.
          </p>
          <div class="ag-suite-cta">
            <CtaButton onDark>En parler trente minutes</CtaButton>
            <button type="button" class="ag-refaire" id="ag-refaire">Tester une autre agence</button>
          </div>
        </div>
      </div>

      <p class="ag-err" id="ag-err" hidden></p>

      <!-- repli : certains sites d'agence sont illisibles (tout en JavaScript, ou protégés).
           Plutôt que de laisser le visiteur dans le mur, on lui propose de décrire son agence. -->
      <form class="ag-repli" id="ag-repli" hidden>
        <label for="ag-desc">Décrivez votre agence en une phrase, je pars de là.</label>
        <textarea
          id="ag-desc"
          rows="2"
          maxlength="400"
          placeholder="Ex. : agence de communication de 12 personnes à Bordeaux, identité de marque et campagnes pour des PME industrielles."
        ></textarea>
        <button type="submit" class="ag-go ag-go-repli">
          <span class="ag-go-txt">Faire le portrait quand même</span>
          <span class="ag-go-spin" aria-hidden="true"></span>
        </button>
      </form>
    </section>

    <!-- ══════════ CE QUE ÇA DONNE DANS UNE AGENCE ══════════ -->
    <section class="border-t border-line px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-7xl">
        <Eyebrow>Ce que ça donne dans une agence</Eyebrow>
        <h2 class="max-w-3xl text-[clamp(2rem,4.2vw,3.2rem)] font-light leading-[1.06] tracking-[-0.03em]">
          Les murs ne bougent pas. <em class="text-lime">La production, si.</em>
        </h2>
        <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-ink-2">
          Trois faits tirés de missions réelles en agence. Chacun renvoie à sa fiche — clients
          anonymisés, rien d'inventé.
        </p>

        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {faits.map((f) => (
            <a href={f.href} class="tf-fait group">
              <span class="tf-fait-chiffre">{f.chiffre}</span>
              <span class="tf-fait-unite">{f.unite}</span>
              <p class="tf-fait-detail">{f.detail}</p>
              <span class="tf-etage-lien">La fiche <span class="tf-fleche">→</span></span>
            </a>
          ))}
        </div>

        <div class="mt-14 border-t border-line pt-12">
          <h3 class="text-[15px] font-medium uppercase tracking-[0.14em] text-ink-3">
            Les assistants qu'on installe dans une agence
          </h3>
          <div class="mt-7 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
            {assistants.map((a) => (
              <div class="tf-assist">
                <h4 class="text-[15px] font-medium text-foreground">{a.nom}</h4>
                <p class="mt-2 text-[14px] leading-relaxed text-ink-2">{a.quoi}</p>
              </div>
            ))}
          </div>
          <p class="mt-7 text-[13px] leading-relaxed text-ink-3">
            Ceux-là ont été livrés à une agence créative de quarante talents. Les vôtres seront
            différents — ils dépendent de vos pôles et de vos dossiers.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════ LES 4 NIVEAUX ══════════ -->
    <section class="border-t border-line px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-7xl">
        <Eyebrow>Ce qu'on installe, niveau par niveau</Eyebrow>
        <h2 class="max-w-3xl text-[clamp(2rem,4.2vw,3.2rem)] font-light leading-[1.06] tracking-[-0.03em]">
          Une transformation se construit <em class="text-lime">par étages.</em>
        </h2>
        <p class="mt-6 max-w-2xl text-[15px] leading-relaxed text-ink-2">
          On ne pose pas les machines avant d'avoir vérifié les fondations. Chaque niveau
          s'appuie sur le précédent — et chacun a ses cas documentés.
        </p>

        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {etages.map((e) => (
            <a href={e.lien} class="tf-etage group">
              <span class="tf-etage-num">{e.num}</span>
              <h3 class="mt-5 text-[17px] font-medium leading-snug text-foreground">{e.titre}</h3>
              <p class="mt-3 text-[14px] leading-relaxed text-ink-2">{e.texte}</p>
              <span class="tf-etage-lien">Les cas <span class="tf-fleche">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ MÉTHODE ══════════ -->
    <section class="border-t border-line px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] lg:gap-20">
          <div>
            <Eyebrow>La méthode</Eyebrow>
            <h2 class="text-[clamp(2rem,4.2vw,3.2rem)] font-light leading-[1.06] tracking-[-0.03em]">
              Quatre temps, <em class="text-lime">toujours les mêmes.</em>
            </h2>
            <p class="mt-6 max-w-md text-[15px] leading-relaxed text-ink-2">
              La séquence ne change pas d'une mission à l'autre. Ce qui change, c'est ce qu'on
              trouve au cadrage — et donc ce qu'on construit ensuite.
            </p>
          </div>
          <ol class="tf-temps">
            {temps.map((t, i) => (
              <li>
                <span class="tf-temps-n">{i + 1}</span>
                <div>
                  <h3 class="text-[16px] font-medium text-foreground">{t.t}</h3>
                  <p class="mt-1.5 text-[14px] leading-relaxed text-ink-2">{t.d}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ══════════ PREUVES ══════════ -->
    <section id="preuves" class="scroll-mt-6 border-t border-line px-6 py-20 md:px-12 md:py-28">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div>
            <Eyebrow>Des agences déjà transformées</Eyebrow>
            <h2 class="max-w-2xl text-[clamp(2rem,4.2vw,3.2rem)] font-light leading-[1.06] tracking-[-0.03em]">
              Ce n'est pas une promesse. <em class="text-lime">C'est un registre.</em>
            </h2>
          </div>
          <a href="/realisations" class="text-[15px] text-lime hover:underline">Tous les cas →</a>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {preuves.map((p) => (
            <a href={p.href} class="tf-preuve group">
              <span class="tf-preuve-tag">{p.tag}</span>
              <h3 class="mt-4 text-[17px] font-medium leading-snug text-foreground group-hover:text-lime">
                {p.titre}
              </h3>
              <p class="mt-3 text-[14px] leading-relaxed text-ink-2">{p.ligne}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════ CTA ══════════ -->
    <section class="relative overflow-hidden border-t border-line px-6 py-24 md:px-12 md:py-32">
      <div
        class="pointer-events-none absolute inset-0 -z-10"
        style="background: radial-gradient(760px 420px at 70% 100%, rgba(108,76,241,0.10), transparent 70%);"
      >
      </div>
      <div class="mx-auto max-w-3xl text-center">
