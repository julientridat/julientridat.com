    font-size: 13px;
    color: var(--ink-3);
    transition: color 0.2s ease;
  }
  .tf-etage:hover .tf-etage-lien { color: var(--lime); }
  .tf-fleche { display: inline-block; transition: transform 0.2s ease; }
  .tf-etage:hover .tf-fleche { transform: translateX(3px); }

