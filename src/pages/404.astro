---
import VitrineLayout from "@/layouts/VitrineLayout.astro";
---

<VitrineLayout title="Page introuvable | Julien Tridat" description="La page que vous cherchez n'existe pas ou a été déplacée.">
  <section class="v-section v-section--premiere v-section--fin">
    <div class="v-hero v-pile">
      <p class="v-label">Erreur 404</p>
      <h1 class="v-h1">Page introuvable. <span class="v-vert">L'accueil, lui, est là.</span></h1>
      <p class="v-chapo">La page que vous cherchez n'existe pas ou a été déplacée.</p>
      <a href="/" class="v-bouton" style="align-self: flex-start;">Retour à l'accueil →</a>
    </div>
  </section>
</VitrineLayout>
