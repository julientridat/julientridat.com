---
/**
 * Mise en page du site vitrine (charte « planning », refonte de novembre 2026).
 * Reprend le socle SEO de BaseLayout (canonical, Open Graph, vérification Google,
 * JSON-LD Person) ; BaseLayout reste en place pour les pages applicatives
 * (enquêtes). Le tableau client a sa propre page, hors de ces deux mises en page.
 */
import "@/styles/global.css";
import "@/styles/vitrine.css";
import { SITE, PERSON_JSONLD } from "@/lib/site";
import BookingDialog from "@/components/react/BookingDialog";
import ContactDialog from "@/components/react/ContactDialog";
import Coupures from "@/components/Coupures.astro";
import Entete from "@/components/vitrine/Entete.astro";
import PiedDePage from "@/components/vitrine/PiedDePage.astro";

interface Props {
  title: string;
  description: string;
  /** Absent = page non indexable (404…) : pas de canonical, meta robots noindex. */
  canonical?: string;
  jsonLd?: Record<string, unknown>[];
  actif?: "accueil" | "formation";
  cta?: "diagnostic" | "echange";
}

const { title, description, canonical, jsonLd = [], actif, cta } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Julien Tridat" />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;800&family=Public+Sans:wght@400;600;700&family=Geist:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={`${SITE.url}/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE.url}/og.jpg`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />

    <script type="application/ld+json" set:html={JSON.stringify(PERSON_JSONLD)} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body class="vitrine">
    <Entete actif={actif} cta={cta} />
    <main>
      <slot />
    </main>
    <PiedDePage />
    <BookingDialog client:load />
    <ContactDialog client:load />
    <Coupures />
  </body>
</html>
