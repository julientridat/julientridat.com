{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "julientridat",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Les pages passent par le Worker avant d'être servies, pour qu'il puisse
    // renvoyer http:// et www. vers l'adresse unique (worker/canonique.ts).
    // Les dossiers d'images en sont exclus : Google ne les indexe pas comme
    // pages, et chaque passage par le Worker compte dans le quota de requêtes.
    "run_worker_first": ["/*", "!/_astro/*", "!/agences/*", "!/artefacts/*", "!/scene/*"]
  },
  "ai": {
    "binding": "AI"
  },
  // Le tableau client (/tableau) : un Durable Object à stockage SQLite — inclus
  // dans le plan gratuit de Workers. Toutes les places vivent dans un seul objet,
  // les navigateurs s'y connectent en WebSocket (worker/tableau.ts).
  "durable_objects": {
    "bindings": [{ "name": "TABLEAU", "class_name": "Tableau" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tableau"] }],
  // Le connecteur Claude du tableau (/mcp) : les autorisations OAuth accordées par
  // Julien et les jetons (chiffrés) vivent dans cet espace KV — inclus dans le plan gratuit.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "25b2cb5fa7684566932f6c51df2161f8" }]
}
